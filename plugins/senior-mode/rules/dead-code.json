{
  "rules": [
    {
      "id": "dead-code",
      "tier": 2,
      "kind": "tool",
      "presets": ["node"],
      "run": "knip --reporter json --include files,exports,types",
      "format": "knip",
      "needs": "knip",
      "install": "npm install -g knip",
      "fix": "remove it, or use it in this pull request"
    },
    {
      "id": "unused-dependency",
      "tier": 2,
      "kind": "tool",
      "presets": ["node"],
      "reads": "manifest",
      "run": "knip --reporter json --include dependencies,devDependencies",
      "format": "knip-deps",
      "needs": "knip",
      "install": "npm install -g knip",
      "fix": "remove it from the manifest, or import it in this pull request"
    },
    {
      "id": "dead-code",
      "tier": 2,
      "kind": "tool",
      "presets": ["python"],
      "run": "vulture . --min-confidence 60",
      "format": "vulture",
      "needs": "vulture",
      "install": "pip install vulture",
      "fix": "remove it, or use it in this pull request"
    },
    {
      "id": "unused-dependency",
      "tier": 2,
      "kind": "tool",
      "presets": ["python"],
      "reads": "manifest",
      "run": "deptry . --json-output {out}/report.json >/dev/null",
      "format": "deptry",
      "needs": "deptry",
      "install": "pip install deptry",
      "fix": "remove it from the manifest, or import it in this pull request"
    },
    {
      "id": "dead-code",
      "tier": 2,
      "kind": "tool",
      "presets": ["go"],
      "run": "staticcheck -f json -checks U1000 ./...",
      "format": "staticcheck",
      "needs": "staticcheck",
      "install": "go install honnef.co/go/tools/cmd/staticcheck@latest",
      "fix": "remove it, or use it in this pull request"
    },
    {
      "id": "unused-dependency",
      "tier": 2,
      "kind": "tool",
      "presets": ["go"],
      "reads": "manifest",
      "run": "go mod tidy -diff",
      "format": "gotidy",
      "needs": "go",
      "install": "install Go 1.23 or later (go mod tidy -diff)",
      "fix": "run go mod tidy, or import it in this pull request"
    },
    {
      "id": "dead-code",
      "tier": 2,
      "kind": "tool",
      "presets": ["rust"],
      "run": "cargo check --message-format json",
      "format": "cargo-dead",
      "needs": "cargo",
      "install": "install Rust with rustup",
      "fix": "remove it, or use it in this pull request"
    },
    {
      "id": "unused-dependency",
      "tier": 2,
      "kind": "tool",
      "presets": ["rust"],
      "reads": "manifest",
      "run": "cargo +nightly udeps --output json",
      "format": "udeps",
      "needs": "cargo-udeps",
      "install": "cargo install cargo-udeps --locked (and a nightly toolchain)",
      "fix": "remove it from Cargo.toml, or use it in this pull request"
    }
  ]
}
