#!/usr/bin/env bash
# senior-mode: project config and GitHub helpers for the senior-mode plugin.
# The config is .claude/senior-mode.json at the repository root, written by /senior-mode:setup.
set -euo pipefail

DEFAULTS='{
  "language": "en",
  "ci": { "mode": "local" },
  "autonomy": { "maxTickets": 3, "parallel": 1, "maxConsecutiveFailures": 2, "autoMerge": true },
  "limits": { "prLines": 400 }
}'

die() {
  echo "senior-mode: $*" >&2
  exit 1
}

usage() {
  die "usage: senior-mode config get <key> | item set <issue> <field> <option> [<field> <option>]... | issue create --title <t> --body-file <f> --size <s> --priority <p> [--status <s>] [--milestone <m>] [--type <t>] [--blocked-by <n>]... [--parent <n>] | check | publish [commit] | release [--dry-run] | frame end | protected [--base <ref>] | context | setup github [--ci local|actions] | setup repo [--command <name>=<command>]..."
}

config_file() {
  local root file
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
  file="$root/.claude/senior-mode.json"
  [ -f "$file" ] || die "no .claude/senior-mode.json here; run /senior-mode:setup"
  jq empty "$file" 2>/dev/null || die "invalid .claude/senior-mode.json; run /senior-mode:setup to repair it"
  printf '%s\n' "$file"
}

# Prints a config value (strings raw, anything else as JSON), falling back to DEFAULTS.
config_get() {
  local key=$1 file path value
  file=$(config_file)
  path=$(jq -nc --arg k "$key" '$k | split(".")')
  value=$(jq -c --argjson d "$DEFAULTS" --argjson p "$path" '($d * .) | getpath($p)' "$file" 2>/dev/null) ||
    die "unknown config key: $key"
  [ "$value" != null ] || die "unknown config key: $key"
  jq -r 'if type == "string" then . else tojson end' <<<"$value"
}

# owner/name of the origin remote, from an https or ssh URL.
repo_slug() {
  local url
  url=$(git remote get-url origin 2>/dev/null) || die "no origin remote"
  url=${url%.git}
  printf '%s\n' "${url#*github.com[:/]}"
}

# Runs gh, retrying up to 3 times with a growing pause when GitHub fails transiently (#21);
# any other error fails at once. SENIOR_MODE_RETRY_DELAY scales the pause (seconds, default 1).
gh_retry() {
  local attempt err out
  err=$(mktemp)
  for attempt in 1 2 3 4; do
    if out=$(gh "$@" 2>"$err"); then
      rm -f "$err"
      [ -z "$out" ] || printf '%s\n' "$out"
      return 0
    fi
    grep -qiE 'unknown owner type|HTTP 5[0-9][0-9]|timeout|timed out|connection reset|unexpected EOF|secondary rate limit' "$err" &&
      [ "$attempt" -lt 4 ] || break
    sleep $((attempt * ${SENIOR_MODE_RETRY_DELAY:-1}))
  done
  cat "$err" >&2
  rm -f "$err"
  return 1
}

# Id of a board option cached in the config; dies naming the known fields or options.
option_id() {
  local file=$1 field=$2 option=$3 id
  jq -e --arg f "$field" '.project.fields[$f].id' "$file" >/dev/null ||
    die "unknown field $field (known: $(jq -r '.project.fields // {} | keys | join(", ")' "$file"))"
  id=$(jq -r --arg f "$field" --arg o "$option" '.project.fields[$f].options[$o] // empty' "$file")
  [ -n "$id" ] ||
    die "unknown option $option for $field (known: $(jq -r --arg f "$field" '.project.fields[$f].options | keys | join(", ")' "$file"))"
  printf '%s\n' "$id"
}

# Sets single-select fields of an issue's Project item (pairs of field and option), using the ids
# cached in the config. Every pair is checked before the item is touched.
item_set() {
  [ $# -ge 3 ] && [ $(($# % 2)) -eq 1 ] || usage
  local issue=$1 file project owner number item field option i
  local ids=()
  shift
  file=$(config_file)
  project=$(jq -r '.project.id // empty' "$file")
  owner=$(jq -r '.project.owner // empty' "$file")
  number=$(jq -r '.project.number // empty' "$file")
  [ -n "$project" ] && [ -n "$owner" ] && [ -n "$number" ] ||
    die "no Project in .claude/senior-mode.json; run /senior-mode:setup"
  for ((i = 1; i < $#; i += 2)); do
    field=${!i}
    option=$(option_id "$file" "$field" "${@:i+1:1}")
    ids+=("$(jq -r --arg f "$field" '.project.fields[$f].id' "$file")" "$option")
  done
  item=$(gh_retry project item-add "$number" --owner "$owner" \
    --url "https://github.com/$(repo_slug)/issues/$issue" --format json --jq .id)
  for ((i = 0; i < ${#ids[@]}; i += 2)); do
    gh_retry project item-edit --project-id "$project" --id "$item" \
      --field-id "${ids[i]}" --single-select-option-id "${ids[i + 1]}" >/dev/null
    echo "#$issue ${*:i+1:1} = ${*:i+2:1}"
  done
}

# Numbers of the issues linked to an issue through a REST list (blocked_by, sub_issues).
linked() {
  gh_retry api "repos/$1/issues/$2/$3" --paginate --jq '.[].number'
}

# Adds a link unless it exists. Not retried: a POST applied before a timeout would fail again.
link() {
  local slug=$1 issue=$2 path=$3 key=$4 other=$5 existing id
  existing=$(linked "$slug" "$issue" "$path")
  ! grep -qx "$other" <<<"$existing" || return 0
  id=$(gh_retry api "repos/$slug/issues/$other" --jq .id)
  gh api -X POST "repos/$slug/issues/$issue/$path" -F "$key=$id" >/dev/null
}

# Creates a ticket with its board fields, milestone, type label, blocked-by links and parent epic.
# An open issue with the same title is reused, so a run cut short can be repeated (spec 0001 §7):
# its fields, milestone, label and links converge to the arguments, its Status only with --status.
issue_create() {
  local title="" body="" size="" priority="" status="" milestone="" type="" parent=""
  local blockers=() edits=() file slug found number url b fields
  while [ $# -gt 0 ]; do
    case $1 in -h | --help)
      echo "usage: senior-mode issue create --title <t> --body-file <file|-> --size <S|M|L> --priority <option> [--status <option>] [--milestone <title>] [--type feature|bug|task|chore] [--blocked-by <n>]... [--parent <n>]"
      return 0 ;;
    esac
    [ $# -ge 2 ] || usage
    case $1 in
      --title) title=$2 ;;
      --body-file) body=$2 ;;
      --size) size=$2 ;;
      --priority) priority=$2 ;;
      --status) status=$2 ;;
      --milestone) milestone=$2 ;;
      --type) type=$2 ;;
      --blocked-by) blockers+=("$2") ;;
      --parent) parent=$2 ;;
      *) usage ;;
    esac
    shift 2
  done
  [ -n "$title" ] && [ -n "$size" ] && [ -n "$priority" ] ||
    die "issue create needs --title, --body-file, --size and --priority"
  [ "$body" = - ] || [ -f "$body" ] || die "no body file: $body"
  case $type in "" | feature | bug | task | chore) ;; *) die "unknown type $type (feature, bug, task, chore)" ;; esac
  # ${a[@]+...}: an empty array is unbound under set -u before bash 4.4.
  for b in ${blockers[@]+"${blockers[@]}"}; do
    [[ $b =~ ^[1-9][0-9]*$ ]] || die "not an issue number: $b"
  done
  [ -z "$parent" ] || [[ $parent =~ ^[1-9][0-9]*$ ]] || die "not an issue number: $parent"
  file=$(config_file)
  fields=(Priority "$priority" Size "$size")
  option_id "$file" Size "$size" >/dev/null
  option_id "$file" Priority "$priority" >/dev/null
  option_id "$file" Status "${status:-Backlog}" >/dev/null
  slug=$(repo_slug)

  # The number of an open issue with this title, then its type labels other than the asked one.
  found=$(gh_retry issue list --repo "$slug" --state open --limit 1000 --json number,title,labels |
    jq -r --arg t "$title" --arg k "type:$type" 'first(.[] | select(.title == $t)
      | [.number | tostring] + [.labels[]?.name | select(startswith("type:") and . != $k)]
      | join("\n")) // empty')
  number=$(head -1 <<<"$found")
  if [ -n "$number" ]; then
    echo "#$number $title (already open)"
    [ -z "$milestone" ] || edits+=(--milestone "$milestone")
    if [ -n "$type" ]; then
      edits+=(--add-label "type:$type")
      while IFS= read -r b; do
        [ -z "$b" ] || edits+=(--remove-label "$b")
      done <<<"$(tail -n +2 <<<"$found")"
    fi
    [ ${#edits[@]} -eq 0 ] || gh_retry issue edit "$number" --repo "$slug" "${edits[@]}" >/dev/null
  else
    url=$(gh issue create --repo "$slug" --title "$title" --body-file "$body" \
      ${milestone:+--milestone "$milestone"} ${type:+--label "type:$type"})
    number=${url##*/}
    echo "#$number $title (created)"
    status=${status:-Backlog}
  fi
  [ -z "$status" ] || fields=(Status "$status" "${fields[@]}")
  item_set "$number" "${fields[@]}"
  for b in ${blockers[@]+"${blockers[@]}"}; do
    link "$slug" "$number" dependencies/blocked_by issue_id "$b"
    echo "#$number blocked by #$b"
  done
  if [ -n "$parent" ]; then
    link "$slug" "$parent" sub_issues sub_issue_id "$number"
    echo "#$number under #$parent"
  fi
}

# Pinned so a release does not change with the CLI's latest version; it needs Node 22 or later.
RELEASE_PLEASE=17.11.2

# Runs release-please locally (ADR 0006): tags and publishes a merged release PR, then opens or
# updates the next one. The token goes through a private file, out of the process list.
release() {
  local dry="" root slug token step
  case ${1:-} in "") ;; --dry-run) dry=--dry-run ;; *) usage ;; esac
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
  [ -f "$root/release-please-config.json" ] ||
    die "no release-please-config.json; run senior-mode setup repo"
  slug=$(repo_slug)
  token=$(mktemp)
  # shellcheck disable=SC2064 # expand now: $token is local and gone when the trap runs
  trap "rm -f '$token'" EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  gh auth token >"$token" || die "gh is not logged in; run gh auth login"
  for step in github-release release-pr; do
    (cd "$root" && npx --yes "release-please@$RELEASE_PLEASE" "$step" \
      --token "$token" --repo-url "$slug" ${dry:+"$dry"}) || die "release-please $step failed"
  done
}

# Where the result of `check` is kept for a commit, until `publish` sends it (ADR 0006).
check_record() {
  printf '%s/%s\n' "$(git rev-parse --git-path senior-mode/checks)" "$1"
}

# Runs the configured checks from the repository root. On a clean tree, records the result for HEAD.
check() {
  local file root count i name cmd output passed=0 failed="" state description
  file=$(config_file)
  root=$(git rev-parse --show-toplevel)
  count=$(jq '.checks // [] | length' "$file")
  [ "$count" -gt 0 ] || die "no checks in .claude/senior-mode.json; run /senior-mode:setup"
  output=$(mktemp)
  for ((i = 0; i < count; i++)); do
    name=$(jq -r ".checks[$i].name" "$file")
    cmd=$(jq -r ".checks[$i].run" "$file")
    # Git exports GIT_DIR to hooks, absolute in a linked worktree: a check that runs git on a test
    # fixture would write into this repository.
    if (cd "$root" && for v in $(git rev-parse --local-env-vars); do unset "$v"; done && bash -c "$cmd") \
      >"$output" 2>&1; then
      passed=$((passed + 1))
      # A check with nothing to do says so on its first line; show why instead of a bare ok.
      if [[ $(head -n 1 "$output") == "skipped: "* ]]; then
        echo "skip  $name: $(head -n 1 "$output" | cut -c10-)"
      else
        echo "ok    $name"
      fi
    else
      failed="${failed:+$failed, }$name"
      echo "FAIL  $name"
      tail -n 20 "$output" | sed 's/^/      /'
    fi
  done
  rm -f "$output"
  if [ -z "$failed" ]; then
    state=success description="$passed/$count checks passed"
  else
    state=failure description="failed: $failed"
  fi
  description=${description:0:140}
  if [ -z "$(git status --porcelain)" ]; then
    mkdir -p "$(dirname "$(check_record x)")"
    printf '%s\n%s\n' "$state" "$description" >"$(check_record "$(git rev-parse HEAD)")"
  else
    echo "note: uncommitted changes, result not recorded for publishing"
  fi
  echo "$description"
  [ "$state" = success ]
}

# Publishes the recorded check result of a commit as the status senior-mode/ci.
publish() {
  local sha record state description
  sha=$(git rev-parse --verify "${1:-HEAD}^{commit}" 2>/dev/null) || die "unknown commit: ${1:-HEAD}"
  record=$(check_record "$sha")
  [ -f "$record" ] || die "no check result for ${sha:0:7}; run senior-mode check on a clean tree first"
  state=$(sed -n 1p "$record")
  description=$(sed -n 2p "$record")
  gh_retry api "repos/$(repo_slug)/statuses/$sha" -f state="$state" -f context=senior-mode/ci \
    -f description="$description" >/dev/null ||
    die "could not publish the status of ${sha:0:7}; push the commit first"
  echo "senior-mode/ci = $state on ${sha:0:7}: $description"
}

# Board fields and options (spec 0001 §11), in order. Aliases match options of GitHub's default
# Status field, so that values already set on items survive the repair.
BOARD='{
  "Status": [{"name": "Backlog", "color": "GRAY", "aliases": ["todo"]}, {"name": "Ready", "color": "BLUE"},
    {"name": "In progress", "color": "YELLOW"}, {"name": "In review", "color": "PURPLE"}, {"name": "Done", "color": "GREEN"}],
  "Priority": [{"name": "P0 now", "color": "RED"}, {"name": "P1 next", "color": "ORANGE"},
    {"name": "P2 later", "color": "YELLOW"}, {"name": "P3 someday", "color": "GRAY"}],
  "Size": [{"name": "S", "color": "GREEN"}, {"name": "M", "color": "YELLOW"}, {"name": "L", "color": "RED"}]
}'

# Options to give a field: the wanted ones, keeping the id, colour and description of an existing
# option with the same name (any case), else of an alias, then the field's other options unchanged.
# shellcheck disable=SC2016 # a jq program, not shell
MERGE_OPTIONS='.options as $cur
  | (reduce $want[] as $w ([];
      (map(.id)) as $taken
      | ([$cur[] | select((.id | IN($taken[]) | not) and (.name | ascii_downcase) == ($w.name | ascii_downcase))][0]
         // [$cur[] | select((.id | IN($taken[]) | not) and ((.name | ascii_downcase) | IN(($w.aliases // [])[])))][0]) as $m
      | . + [{name: $w.name, color: ($m.color // $w.color), description: ($m.description // "")}
             + (if $m then {id: $m.id} else {} end)])) as $ours
  | $ours + [$cur[] | select(.id | IN($ours[].id) | not) | {id, name, color, description}]'

# The rules senior-mode owns on the default branch (ADR 0006), as a ruleset of its own: it adds to
# whatever protection the repository has and never rewrites it. Admins may bypass, explicitly.
RULESET='{"name": "senior-mode", "target": "branch", "enforcement": "active",
  "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
  "bypass_actors": [{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}],
  "rules": [{"type": "deletion"}, {"type": "non_fast_forward"}, {"type": "required_linear_history"},
    {"type": "pull_request", "parameters": {"required_approving_review_count": 0, "dismiss_stale_reviews_on_push": false,
      "require_code_owner_review": false, "require_last_push_approval": false,
      "required_review_thread_resolution": false, "allowed_merge_methods": ["rebase"]}},
    {"type": "required_status_checks", "parameters": {"strict_required_status_checks_policy": true,
      "do_not_enforce_on_create": false,
      "required_status_checks": [{"context": "senior-mode/ci"}, {"context": "senior-mode/review"}]}}]}'

# Single-select fields of a Project, with their options.
board_fields() {
  jq -nc --arg id "$1" '{variables: {id: $id}, query: "query($id: ID!) { node(id: $id) { ... on ProjectV2 {
    fields(first: 50) { nodes { ... on ProjectV2SingleSelectField { id name options { id name color description } } } } } } }"}' |
    gh_retry api graphql --input - --jq '[.data.node.fields.nodes[] | select(.options)]'
}

# Finds the Project of the repository (cached number, else same title) or creates it; prints
# "<number> <id>". Called as `setup_project || die`, which turns off set -e here: every command
# checks its own status.
setup_project() {
  local file=$1 owner=$2 name=$3 slug=$4 number id err
  number=$(jq -r '.project.number // empty' "$file")
  if [ -n "$number" ]; then
    err=$(mktemp)
    if ! id=$(gh_retry project view "$number" --owner "$owner" --format json --jq .id 2>"$err"); then
      grep -q "Could not resolve to a ProjectV2" "$err" || die "cannot read Project #$number: $(cat "$err")"
      number=""
    fi
    rm -f "$err"
  fi
  if [ -z "$number" ]; then
    number=$(gh_retry project list --owner "$owner" --limit 100 --format json \
      --jq "[.projects[] | select(.title == \"$name\")][0].number // empty") || return 1
    if [ -z "$number" ]; then
      number=$(gh_retry project create --owner "$owner" --title "$name" --format json --jq .number) || return 1
      echo "Project #$number $name: created" >&2
    fi
    id=$(gh_retry project view "$number" --owner "$owner" --format json --jq .id) || return 1
  fi
  [ -n "$id" ] || return 1
  gh_retry project link "$number" --owner "$owner" --repo "$slug" >/dev/null || return 1
  echo "$number $id"
}

# Creates missing board fields with their colours, repairs the options of existing ones.
setup_fields() {
  local id=$1 fields field want current options
  fields=$(board_fields "$id")
  for field in Status Priority Size; do
    want=$(jq -c --arg f "$field" '.[$f]' <<<"$BOARD")
    current=$(jq -c --arg f "$field" '.[] | select(.name == $f)' <<<"$fields")
    if [ -z "$current" ]; then
      jq -nc --arg p "$id" --arg n "$field" --argjson w "$want" '{variables: {project: $p, name: $n,
        options: ($w | map({name, color, description: ""}))}, query: "mutation($project: ID!, $name: String!,
        $options: [ProjectV2SingleSelectFieldOptionInput!]!) { createProjectV2Field(input: {projectId: $project,
        dataType: SINGLE_SELECT, name: $name, singleSelectOptions: $options}) { clientMutationId } }"}' |
        gh_retry api graphql --input - >/dev/null
      echo "field $field: created"
      continue
    fi
    options=$(jq -c --argjson want "$want" "$MERGE_OPTIONS" <<<"$current")
    [ "$(jq -c 'map(.name)' <<<"$options")" != "$(jq -c '.options | map(.name)' <<<"$current")" ] || continue
    jq -nc --arg f "$(jq -r .id <<<"$current")" --argjson o "$options" '{variables: {field: $f, options: $o},
      query: "mutation($field: ID!, $options: [ProjectV2SingleSelectFieldOptionInput!]!) {
        updateProjectV2Field(input: {fieldId: $field, singleSelectOptions: $options}) { clientMutationId } }"}' |
      gh_retry api graphql --input - >/dev/null
    echo "field $field: options repaired, existing values kept"
  done
}

# Creates the senior-mode ruleset of the repository, or updates it.
setup_ruleset() {
  local id
  id=$(gh_retry api "repos/$1/rulesets" \
    --jq '[.[] | select(.name == "senior-mode" and .source_type == "Repository")][0].id // empty') || return 1
  if [ -n "$id" ]; then
    gh_retry api -X PUT "repos/$1/rulesets/$id" --input - <<<"$RULESET"
  else
    gh_retry api -X POST "repos/$1/rulesets" --input - <<<"$RULESET"
  fi
}

# The GitHub side of a project (spec 0001 §11, #11), idempotent: Project linked to the repository with
# Status, Priority and Size; labels; rebase-only merges; a ruleset requiring both statuses
# (ADR 0006); ids cached in the config.
# ci.mode local: the checks run before each push, so the repository's own workflows are disabled
# (files kept) and spend no Actions budget. GitHub's built-in ones (dynamic/: Dependabot, Pages)
# are left alone. ci.mode actions: our workflow is turned back on if an earlier local run disabled it.
setup_workflows() { # slug mode
  local list id wname path state disabled=""
  list=$(gh_retry workflow list --all --limit 1000 --repo "$1" --json id,name,path,state \
    --jq '.[] | select(.path | startswith(".github/workflows/")) | "\(.id)\t\(.path)\t\(.state)\t\(.name)"') ||
    die "cannot list the workflows of $1"
  while IFS=$'\t' read -r id path state wname; do
    [ -n "$id" ] || continue
    if [ "$2" = local ] && [ "$state" = active ]; then
      gh_retry workflow disable "$id" --repo "$1" >/dev/null || die "cannot disable workflow $wname"
      disabled+="${disabled:+, }$wname"
    elif [ "$2" = actions ] && [ "$path" = .github/workflows/senior-mode.yml ] && [ "$state" != active ]; then
      gh_retry workflow enable "$id" --repo "$1" >/dev/null || die "cannot enable workflow $wname"
      echo "workflows: $wname enabled again (ci.mode actions)"
    fi
  done <<<"$list"
  # Read only: the setting is the repository owner's call, and a token secret works around it.
  if [ "$2" = actions ] && [ "$(gh_retry api "repos/$1/actions/permissions/workflow" \
    --jq .can_approve_pull_request_reviews 2>/dev/null)" = false ] &&
    ! gh api "repos/$1/actions/secrets/RELEASE_PLEASE_TOKEN" >/dev/null 2>&1; then
    echo "releases: GitHub Actions may not open pull requests here, so the release job cannot open its PR; allow it in Settings > Actions > General, or store a token as the RELEASE_PLEASE_TOKEN secret"
  fi
  [ -z "$disabled" ] || echo "workflows: disabled $disabled (ci.mode local: checks run before each push; files kept; \`gh workflow enable <name>\` turns one back on, and senior-mode setup github --ci actions stops setup from disabling them again)"
}

setup_github() {
  local root file slug owner name owner_type project number id fields labels label color description err ci=""
  case "$*" in "") ;; "--ci local" | "--ci actions") ci=$2 ;; *) usage ;; esac
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
  file=$root/.claude/senior-mode.json
  mkdir -p "$root/.claude"
  [ -f "$file" ] || echo '{}' >"$file"
  jq empty "$file" 2>/dev/null || die "invalid .claude/senior-mode.json; fix or remove it, then run setup again"
  if [ -n "$ci" ]; then
    { jq --arg m "$ci" '.ci.mode = $m' "$file" >"$file.tmp" && mv "$file.tmp" "$file"; } ||
      die "could not write .claude/senior-mode.json"
  fi
  slug=$(repo_slug) owner=${slug%%/*} name=${slug#*/}
  owner_type=$(gh_retry api "repos/$slug" --jq .owner.type) || die "cannot read $slug on GitHub"

  project=$(setup_project "$file" "$owner" "$name" "$slug") || die "could not find or create the Project"
  read -r number id <<<"$project"
  setup_fields "$id"
  fields=$(board_fields "$id") || die "could not read the fields of Project #$number"
  jq --arg o "$owner" --argjson n "$number" --arg id "$id" --argjson f "$fields" \
    '.project = {owner: $o, number: $n, id: $id, fields: ($f | map(select(.name | IN("Status", "Priority", "Size"))
      | {key: .name, value: {id, options: (.options | map({key: .name, value: .id}) | from_entries)}}) | from_entries)}' \
    "$file" >"$file.tmp" || die "could not write .claude/senior-mode.json"
  mv "$file.tmp" "$file"
  echo "Project #$number $name: linked, fields Status, Priority, Size; ids cached in .claude/senior-mode.json"

  labels='needs-human|d93f0b|Waiting for a human decision or merge
needs-info|fbca04|Missing information before work can start
blocked|b60205|Blocked by something outside this ticket'
  [ "$owner_type" = Organization ] || labels+='
type:feature|a2eeef|New capability for users
type:bug|d73a4a|Something does not work as specified
type:task|c5def5|Work that is neither a feature nor a bug
type:chore|ededed|Maintenance with no user-visible change'
  while IFS='|' read -r label color description; do
    gh_retry label create "$label" --repo "$slug" --color "$color" --description "$description" --force >/dev/null
  done <<<"$labels"
  echo "labels: $(cut -d'|' -f1 <<<"$labels" | paste -sd' ' -)"

  gh_retry repo edit "$slug" --enable-rebase-merge --enable-merge-commit=false --enable-squash-merge=false \
    --delete-branch-on-merge >/dev/null
  echo "merges: rebase only, branches deleted after merge"

  setup_workflows "$slug" "$(jq -r '.ci.mode // "local"' "$file")"

  if err=$(setup_ruleset "$slug" 2>&1 >/dev/null); then
    echo "default branch: ruleset senior-mode, pull requests only, rebase, senior-mode/ci and senior-mode/review on an up-to-date branch, linear history; admins may bypass with gh pr merge --admin; other protection untouched"
  elif grep -q "Upgrade to GitHub Pro" <<<"$err"; then
    echo "default branch: rulesets are not available on this plan for a private repository; the git hooks and the guard hook still apply"
  else
    die "ruleset on the default branch: $err"
  fi
}

# Writes `jq <filter> <file>` back to the file only when the JSON changes, so a file without real
# change keeps its formatting. Extra arguments go to jq.
json_update() {
  local file=$1 filter=$2 new
  shift 2
  new=$(jq "$@" "$filter" "$file") || return 1
  [ "$(jq -S . <<<"$new")" = "$(jq -S . "$file")" ] && return 2
  printf '%s\n' "$new" >"$file"
}

# Copies a template where nothing exists yet; never replaces a file. Prints what it did.
place() { # template destination label
  if [ -e "$2" ]; then echo "$3: kept"; return; fi
  mkdir -p "$(dirname "$2")"
  cp "$1" "$2"
  echo "$3: created"
}

# Installs or refreshes the senior-mode git hooks; a hook of the project's own is kept.
setup_githooks() {
  local root=$1 tpl=$2 hook path
  for hook in commit-msg pre-push; do
    if [ -e "$root/.githooks/$hook" ] && ! grep -q '^# senior-mode:' "$root/.githooks/$hook"; then
      echo "git hook $hook: yours kept"
    elif ! cmp -s "$tpl/githooks/$hook" "$root/.githooks/$hook" || [ ! -x "$root/.githooks/$hook" ]; then
      mkdir -p "$root/.githooks"
      cp "$tpl/githooks/$hook" "$root/.githooks/$hook"
      chmod +x "$root/.githooks/$hook"
      echo "git hook $hook: installed"
    fi
  done
  path=$(git -C "$root" config core.hooksPath || true)
  if [ -z "$path" ]; then
    git -C "$root" config core.hooksPath .githooks
  elif [ "$path" != .githooks ]; then
    echo "git hooks: core.hooksPath is $path; call .githooks/commit-msg and .githooks/pre-push from there"
  fi
}

# Adds the Principles block to CLAUDE.md, or refreshes it; a missing CLAUDE.md starts from the
# skeleton that the setup skill fills from the code.
setup_claude_md() {
  local root=$1 tpl=$2 name=$3 claude=$1/CLAUDE.md block=$2/principles.md skeleton new lines
  if [ ! -e "$claude" ]; then
    skeleton=$(cat "$tpl/CLAUDE.md")
    # Split around the one placeholder: a pattern substitution would read & in the name (bash 5.2).
    { printf '%s\n\n' "${skeleton%%\{\{name\}\}*}$name${skeleton#*\{\{name\}\}}"; cat "$block"; } >"$claude"
    echo "CLAUDE.md: created from the skeleton; commands, code map and pitfalls to fill"
  elif ! grep -qE '^<!-- /?senior-mode:principles' "$claude"; then
    { echo; cat "$block"; } >>"$claude"
    echo "CLAUDE.md: Principles added, the rest kept"
  # One opening marker, then one closing marker, else awk refuses and the file is left alone.
  elif ! new=$(awk -v f="$block" '
      /^<!-- senior-mode:principles/ { if (seen++) bad = 1; while ((getline l < f) > 0) print l; close(f); skip = 1; next }
      /^<!-- \/senior-mode:principles -->/ { if (!skip) bad = 1; skip = 0; next }
      !skip { print } END { exit (bad || skip) }' "$claude"); then
    echo "CLAUDE.md: Principles markers broken, file left untouched; restore one opening and one closing marker"
  elif [ "$new" != "$(cat "$claude")" ]; then
    # Written in place, so a symlinked CLAUDE.md and its mode survive.
    printf '%s\n' "$new" >"$claude"
    echo "CLAUDE.md: Principles refreshed"
  fi
  lines=$(wc -l <"$claude")
  [ "$lines" -le 80 ] || echo "CLAUDE.md: $lines lines, over 80; trim it to what the code does not tell"
}

# Commands of a package.json project (spec 0001 §14, #13, #42): its scripts, run by the package
# manager of its lockfile; tsc --noEmit when a tsconfig has no typecheck script and typescript is a
# dependency (npx would otherwise fetch the unrelated "tsc" package), run without ever downloading;
# npm's placeholder test script is no test. Prints {commands, framework, typescript}.
# shellcheck disable=SC2016 # jq program, not shell
node_detect() {
  # exec runs an installed binary only: npx and bunx would download a missing one.
  local root=$1 pm=npm exec="npx --no --" tsconfig=false
  if [ -f "$root/pnpm-lock.yaml" ]; then pm=pnpm exec="pnpm exec"
  elif [ -f "$root/yarn.lock" ]; then pm=yarn exec=yarn
  elif [ -f "$root/bun.lock" ] || [ -f "$root/bun.lockb" ]; then pm=bun exec="bun run"
  fi
  [ ! -f "$root/tsconfig.json" ] || tsconfig=true
  jq -c --arg pm "$pm" --arg exec "$exec" --argjson tsconfig "$tsconfig" '(.scripts // {}) as $s
    | def run($n): if $s[$n] then "\($pm) run \($n)" else null end;
    ((.dependencies.typescript // .devDependencies.typescript) != null) as $ts
    | {commands: ({
        lint: run("lint"),
        typecheck: (run("typecheck") // run("type-check")
          // (if $tsconfig and $ts then "\($exec) tsc --noEmit" else null end)),
        test: (if ($s.test // "") | test("no test specified") then null else run("test") end),
        build: run("build"),
        e2e: (run("test:e2e") // run("e2e"))
      } | with_entries(select(.value != null))),
      framework: (if (.dependencies.next // .devDependencies.next) then "next" else null end),
      typescript: ($ts or $tsconfig)}' \
    "$root/package.json"
}

# The documents and checks of a project (spec 0001 §12, §14, #12), idempotent; whatever the project
# already has is extended, never replaced. The preset is the stored one (typescript, its former name,
# becomes node), else node when a package.json exists, else generic. `--command <name>=<command>`
# stores a command of the preset (lint, typecheck, test, build; e2e for node) and derives its check.
# shellcheck disable=SC2016 # jq programs, not shell
setup_repo() {
  local root file tpl pname="" preset lang name commands='{}' detected='{}' out ours
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
  file=$root/.claude/senior-mode.json
  tpl=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
  # A preset stored earlier wins over detection.
  [ ! -f "$file" ] || pname=$(jq -r '.preset // empty' "$file" 2>/dev/null) || true
  [ "$pname" != typescript ] || pname=node
  if [ -z "$pname" ]; then
    pname=generic
    [ ! -f "$root/package.json" ] || pname=node
  fi
  preset=$tpl/presets/$pname/preset.json
  [ -f "$preset" ] || die "unknown preset $pname in .claude/senior-mode.json"
  [ "$pname" != node ] || detected=$(node_detect "$root") ||
    die "could not read package.json"
  tpl=$tpl/templates
  while [ $# -gt 0 ]; do
    [ "$1" = --command ] && [[ ${2:-} == ?*=?* ]] || usage
    jq -e --arg k "${2%%=*}" '.commands | index($k)' "$preset" >/dev/null ||
      die "unknown command ${2%%=*}; expected one of $(jq -r '.commands | join(", ")' "$preset")"
    commands=$(jq -c --arg k "${2%%=*}" --arg v "${2#*=}" '.[$k] = $v' <<<"$commands")
    shift 2
  done
  mkdir -p "$root/.claude"
  [ -f "$file" ] || echo '{}' >"$file"
  jq empty "$file" 2>/dev/null || die "invalid .claude/senior-mode.json; fix or remove it, then run setup again"
  lang=$(jq -r '.language // "en"' "$file")
  [ -d "$tpl/$lang" ] || lang=en
  name=$(basename "$root")

  setup_githooks "$root" "$tpl"
  # The commit subjects check runs our commit-msg hook; a project's own hook may not understand it.
  ours=false
  ! grep -q '^# senior-mode:' "$root/.githooks/commit-msg" 2>/dev/null || ours=true
  out=0
  json_update "$file" '.preset = $pn | .commands = ($d.commands // {}) + (.commands // {}) + $c
    | if $d.framework then .framework = $d.framework else . end | .commands as $all
    | ($p[0].commands | map(select($all[.] != null) | {name: ., run: $all[.]})) as $derived
    | ($derived + (if $ours then $p[0].checks else [] end)) as $want
    | .checks = ((.checks // []) as $have
      | [$have[] | if $c[.name] then .run = $c[.name] else . end]
        + [$want[] | select(.name as $n | $have | any(.name == $n) | not)])
    | if has("protected") or ($p[0].protected | not) then . else .protected = $p[0].protected end' \
    --argjson c "$commands" --argjson ours "$ours" --slurpfile p "$preset" --arg pn "$pname" \
    --argjson d "$detected" || out=$?
  [ "$out" -ne 1 ] || die "could not write .claude/senior-mode.json"
  echo "preset: $pname$(jq -r --argjson d "$detected" '[if $d.typescript == true then "TypeScript"
    elif $d.typescript == false then "JavaScript" else empty end, .framework // empty]
    | select(length > 0) | " (\(join(", ")))"' "$file")"
  echo "checks: $(jq -r '[.checks[].name] | join(", ")' "$file")"
  [ "$pname" != node ] || jq -r --argjson d "$detected" '["lint", "typecheck", "test", "build"] - (.commands | keys)
    - (if $d.typescript then [] else ["typecheck"] end)
    | select(length > 0) | "missing: \(join(", ")) (no script; propose tools, never install without a yes)"' "$file"

  setup_claude_md "$root" "$tpl/$lang" "$name"
  if [ -n "$(find "$root" "$root/.github" "$root/docs" -maxdepth 1 -iname 'pull_request_template*' 2>/dev/null)" ]; then
    echo "pull request template: kept"
  else
    place "$tpl/$lang/pull_request_template.md" "$root/.github/pull_request_template.md" "pull request template"
  fi
  place "$tpl/$lang/ISSUE_TEMPLATE/feature.yml" "$root/.github/ISSUE_TEMPLATE/feature.yml" "issue form feature"
  place "$tpl/$lang/ISSUE_TEMPLATE/bug.yml" "$root/.github/ISSUE_TEMPLATE/bug.yml" "issue form bug"
  # Other workflows are left as they are; local mode disables them on GitHub (setup github).
  [ "$(jq -r '.ci.mode // "local"' "$file")" != actions ] ||
    place "$tpl/workflows/senior-mode.yml" "$root/.github/workflows/senior-mode.yml" "workflow senior-mode.yml"

  [ -f "$root/.claude/settings.json" ] || echo '{}' >"$root/.claude/settings.json"
  out=0
  json_update "$root/.claude/settings.json" 'def add($xs): reduce $xs[] as $x (. // []; if index([$x]) then . else . + [$x] end);
    .permissions.allow |= add($s[0].permissions.allow) | .permissions.deny |= add($s[0].permissions.deny)' \
    --slurpfile s "$tpl/settings.json" || out=$?
  [ "$out" -ne 1 ] || die "could not update .claude/settings.json"
  [ "$out" -ne 0 ] || echo "settings: senior-mode permissions added to .claude/settings.json"

  if [ ! -e "$root/release-please-config.json" ]; then
    # Without a previous release, release-please would start at 1.0.0: a new project starts at 0.1.0.
    # A package.json version counts as the last release, so the manifest holds it and the next
    # release bumps it (initial-version would publish it again).
    local last=0.0.0
    [ ! -f "$root/package.json" ] || last=$(jq -r '.version // "0.0.0"' "$root/package.json" 2>/dev/null) || last=0.0.0
    jq --arg n "$name" '.release | .packages["."] += {component: $n, "initial-version": "0.1.0"}' \
      "$preset" >"$root/release-please-config.json"
    if [ ! -e "$root/.release-please-manifest.json" ]; then
      jq -n --arg v "$last" '{".": $v}' >"$root/.release-please-manifest.json"
      if [ "$last" != 0.0.0 ] && [ -z "$(git -C "$root" tag --list)" ]; then
        echo "releases: first release follows $last (package.json)$([ "$last" != 1.0.0 ] ||
          echo '; to start at 0.1.0, set "." to "0.0.0" in .release-please-manifest.json')"
      fi
    fi
    echo "releases: release-please configured"
  fi
  echo "secrets: keep only dev-only secrets on a machine where agents run; the secrets guard stops honest mistakes, not a determined reader"
}

# What a session needs at start (SessionStart hook, spec 0001 §15): a short router and, on a ticket
# branch <type>/<issue>-<slug>, the ticket, its Status, its spec and acceptance criteria. Never fails.
context() {
  local root branch issue json spec status criteria
  cat <<'ROUTER'
senior-mode is active: framing, specs and ADRs, test-driven delivery, atomic Conventional Commits, GitHub Project board.
Commands are /senior-mode:<name>; "go" or "enchaîne" takes the next Ready ticket. Disciplines load by themselves; ask the scout agent for codebase facts.
ROUTER
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  if [ ! -f "$root/.claude/senior-mode.json" ]; then
    echo "This repository is not set up for senior-mode; /senior-mode:setup adopts it."
    return 0
  fi
  branch=$(git symbolic-ref --short -q HEAD) || return 0
  issue=$(sed -nE 's#^[a-z]+/([0-9]+)-.*#\1#p' <<<"$branch")
  [ -n "$issue" ] || return 0
  echo
  if ! json=$(gh issue view "$issue" --json number,title,state,body,projectItems 2>/dev/null); then
    echo "Current ticket: #$issue, branch $branch; details not loaded (GitHub unreachable)."
    return 0
  fi
  jq -r --arg b "$branch" '"Current ticket: #\(.number) \(.title) (\(.state | ascii_downcase), Status: \(.projectItems[0].status.name // "not on the board")), branch \($b)"' <<<"$json"
  spec=$(jq -r .body <<<"$json" | grep -oE 'docs/specs/[A-Za-z0-9._-]+\.md' | head -1) || true
  if [ -n "$spec" ]; then
    status=$(sed -nE 's/^status: *//p' "$root/$spec" 2>/dev/null | head -1) || true
    echo "Spec: $spec (${status:-file not found})"
  fi
  criteria=$(jq -r .body <<<"$json" | awk '/^## / { on = /Acceptance criteria/; next } on && /^- /' |
    head -6 | cut -c1-200)
  [ -z "$criteria" ] || printf 'Acceptance criteria:\n%s\n' "$criteria"
}

# The default branch to compare with: origin's HEAD, else the usual names, remote first.
default_branch() {
  local ref b
  if ref=$(git symbolic-ref --short -q refs/remotes/origin/HEAD); then
    printf '%s\n' "$ref"
    return 0
  fi
  for b in origin/main origin/master main master; do
    if git rev-parse -q --verify "$b^{commit}" >/dev/null; then
      printf '%s\n' "$b"
      return 0
    fi
  done
  return 1
}

# Files changed on this branch since it left the base (default: the default branch) that match a
# glob of `protected` in the config (spec 0001 §10). Prints them; exit 1 when there is none.
# A glob without a slash matches a name at any depth; with a slash it is anchored at the repository
# root: `*` stays in one path segment, `**/` spans any number of directories, `?` is one character.
# shellcheck disable=SC2016 # a jq program, not shell
protected() {
  local base="" file globs files matches
  while [ $# -gt 0 ]; do
    [ "$1" = --base ] && [ $# -ge 2 ] || usage
    base=$2
    shift 2
  done
  file=$(config_file)
  globs=$(jq -c '.protected // []' "$file")
  jq -e 'type == "array" and all(type == "string")' <<<"$globs" >/dev/null ||
    die "protected in .claude/senior-mode.json must be an array of globs"
  [ "$globs" != "[]" ] || return 1
  [ -n "$base" ] || base=$(default_branch) || die "no default branch found; pass --base <ref>"
  git rev-parse -q --verify "$base^{commit}" >/dev/null || die "unknown ref: $base"
  # --no-renames: a file moved out of a protected zone is listed under its old path too.
  files=$(git -c core.quotePath=false diff --name-only --no-renames "$base...HEAD") ||
    die "cannot compare with $base"
  matches=$(jq -Rrn --argjson g "$globs" '
    def re:
      (if startswith("/") then .[1:] elif contains("/") then . else "**/" + . end) as $g
      | "^" + ([$g | match("\\*\\*/|\\*\\*|\\*|\\?|[^*?]+"; "g").string
          | if . == "**/" then "(.*/)?" elif . == "**" then ".*" elif . == "*" then "[^/]*" elif . == "?" then "[^/]"
            else gsub("(?<c>[.+^$(){}|\\[\\]\\\\])"; "\\" + .c) end] | join("")) + "$";
    ($g | map(re)) as $res
    | inputs | select(. as $f | any($res[]; . as $r | $f | test($r)))' <<<"$files")
  [ -n "$matches" ] || return 1
  printf '%s\n' "$matches"
}

case "${1:-}" in
  context)
    context
    ;;
  setup)
    case "${2:-}" in
      github) shift 2; setup_github "$@" ;;
      repo) shift 2; setup_repo "$@" ;;
      *) usage ;;
    esac
    ;;
  check)
    [ $# -eq 1 ] || usage
    check
    ;;
  publish)
    [ $# -le 2 ] || usage
    publish "${2:-}"
    ;;
  config)
    [ $# -eq 3 ] && [ "$2" = get ] || usage
    config_get "$3"
    ;;
  item)
    [ "${2:-}" = set ] || usage
    shift 2
    item_set "$@"
    ;;
  release)
    [ $# -le 2 ] || usage
    release "${2:-}"
    ;;
  issue)
    [ "${2:-}" = create ] || usage
    shift 2
    issue_create "$@"
    ;;
  protected)
    shift
    protected "$@"
    ;;
  frame)
    # Lifts the docs/-only guard of every frame session in this repository (hooks/frame-guard.sh).
    [ $# -eq 2 ] && [ "$2" = end ] || usage
    d=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "frame end: not inside a git repository"
    rm -rf "$d/senior-mode/frame"
    echo "frame: ended, edits outside docs/ allowed again"
    ;;
  *) usage ;;
esac
