{
  "commands": ["lint", "format", "typecheck", "test", "build"],
  "coverage": { "report": "coverage.xml" },
  "rules": { "packs": ["python"] },
  "protected": [
    "**/migrations/**",
    "alembic/**",
    "**/auth/**",
    "**/security/**",
    ".github/workflows/**",
    "Dockerfile*",
    "**/Dockerfile*",
    "docker-compose*.yml",
    "infra/**",
    ".claude/senior-mode.json",
    ".claude/secret-allowlist",
    ".claude/ratchet-baseline.json",
    ".claude/architecture-baseline.json"
  ],
  "checks": [{ "name": "commit subjects", "run": ".githooks/commit-msg --branch" }],
  "queries": {
    "django": { "template": "queries/django.py", "helper": "tests/query_count.py" },
    "sqlalchemy": { "template": "queries/sqlalchemy.py", "helper": "tests/query_count.py" }
  },
  "release": {
    "packages": { ".": { "release-type": "python", "component": "{{name}}", "include-component-in-tag": true } }
  }
}
