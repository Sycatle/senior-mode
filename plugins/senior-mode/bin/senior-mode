#!/usr/bin/env bash
# senior-mode: project config and GitHub helpers for the senior-mode plugin.
# The config is .claude/senior-mode.json at the repository root, written by /senior-mode:setup.
set -euo pipefail

DEFAULTS='{
  "language": "en",
  "ci": { "mode": "local" },
  "autonomy": { "maxTickets": 3, "parallel": 1, "maxConsecutiveFailures": 2, "merge": false, "escalate": true, "sessionTimeout": 90, "schedule": "02:00" },
  "agent": { "command": "claude" },
  "e2e": { "slots": 2 },
  "limits": { "prLines": 400 },
  "wip": 1,
  "protected": [],
  "secrets": [],
  "audit": true,
  "envGuard": { "forbidden": [] },
  "review": { "sections": [] },
  "docs": { "extra": [] },
  "github": { "protection": "" }
}'
SELF=$(readlink -f "${BASH_SOURCE[0]}")

die() {
  echo "senior-mode: $*" >&2
  exit 1
}

usage() {
  die "usage: senior-mode config get <key> | item set <issue> <field> <option> [<field> <option>]... | item get <issue> [field] | issue create --title <t> --body-file <f> --size <s> [--priority <p>] [--severity critical|high|moderate|low] [--kind <k> --path <p> --rule <r> [--details-file <f> | --no-advisory]] [--status <s>] [--milestone <m>] [--type <t>] [--blocked-by <n>]... [--parent <n>] | pick [--json] [--max N] | start <issue> | run [--max N] [--parallel P] | schedule install [--at HH:MM] [--max N] | schedule remove | schedule status | status [--json] [--since <dur>] [--watch [secs]] [--fix] | statusline | retro [--since <dur>] [--json] | check [--pre-push] | publish [commit] | release [--dry-run] | frame start <idea> | frame end | protected [--base <ref>] | context | setup github [--ci local|actions] | setup repo [--command <name>=<command>]... | setup statusline"
}

config_file() {
  local root file
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
  file="$root/.claude/senior-mode.json"
  [ -f "$file" ] || die "no .claude/senior-mode.json here; run /senior-mode:setup"
  jq empty "$file" 2>/dev/null || die "invalid .claude/senior-mode.json; run /senior-mode:setup to repair it"
  printf '%s\n' "$file"
}

# Prints a config value (strings raw, anything else as JSON), falling back to DEFAULTS: the optional keys
# read as empty (`[]` for a list, an empty line for a string) when absent; any other key is an error.
config_get() {
  local key=$1 file path value
  file=$(config_file)
  path=$(jq -nc --arg k "$key" '$k | split(".")')
  value=$(jq -c --argjson d "$DEFAULTS" --argjson p "$path" '($d * .) | getpath($p)' "$file" 2>/dev/null) ||
    die "unknown config key: $key"
  [ "$value" != null ] || die "unknown config key: $key"
  jq -r 'if type == "string" then . else tojson end' <<<"$value"
}

# owner/name of the origin remote, from an https or ssh URL.
repo_slug() {
  local url
  url=$(git remote get-url origin 2>/dev/null) || die "no origin remote"
  url=${url%.git}
  printf '%s\n' "${url#*github.com[:/]}"
}

# Runs gh, retrying up to 3 times with a growing pause when GitHub fails transiently (#21);
# any other error fails at once. SENIOR_MODE_RETRY_DELAY scales the pause (seconds, default 1).
gh_retry() {
  local attempt err out
  err=$(mktemp)
  for attempt in 1 2 3 4; do
    if out=$(gh "$@" 2>"$err"); then
      rm -f "$err"
      [ -z "$out" ] || printf '%s\n' "$out"
      return 0
    fi
    grep -qiE 'unknown owner type|HTTP 5[0-9][0-9]|timeout|timed out|connection reset|unexpected EOF|secondary rate limit' "$err" &&
      [ "$attempt" -lt 4 ] || break
    sleep $((attempt * ${SENIOR_MODE_RETRY_DELAY:-1}))
  done
  cat "$err" >&2
  rm -f "$err"
  return 1
}

# Id of a board option cached in the config; dies naming the known fields or options.
option_id() {
  local file=$1 field=$2 option=$3 id
  jq -e --arg f "$field" '.project.fields[$f].id' "$file" >/dev/null ||
    die "unknown field $field (known: $(jq -r '.project.fields // {} | keys | join(", ")' "$file")); a config created before this field existed lacks it: rerun senior-mode setup github"
  id=$(jq -r --arg f "$field" --arg o "$option" '.project.fields[$f].options[$o] // empty' "$file")
  [ -n "$id" ] ||
    die "unknown option $option for $field (known: $(jq -r --arg f "$field" '.project.fields[$f].options | keys | join(", ")' "$file"))"
  printf '%s\n' "$id"
}

# Sets single-select fields of an issue's Project item (pairs of field and option), using the ids
# cached in the config. Every pair is checked before the item is touched.
item_set() {
  [ $# -ge 3 ] && [ $(($# % 2)) -eq 1 ] || usage
  local issue=$1 file project owner number item field option i
  local ids=()
  shift
  file=$(config_file)
  project=$(jq -r '.project.id // empty' "$file")
  owner=$(jq -r '.project.owner // empty' "$file")
  number=$(jq -r '.project.number // empty' "$file")
  [ -n "$project" ] && [ -n "$owner" ] && [ -n "$number" ] ||
    die "no Project in .claude/senior-mode.json; run /senior-mode:setup"
  for ((i = 1; i < $#; i += 2)); do
    field=${!i}
    option=$(option_id "$file" "$field" "${@:i+1:1}")
    ids+=("$(jq -r --arg f "$field" '.project.fields[$f].id' "$file")" "$option")
  done
  item=$(gh_retry project item-add "$number" --owner "$owner" \
    --url "https://github.com/$(repo_slug)/issues/$issue" --format json --jq .id)
  for ((i = 0; i < ${#ids[@]}; i += 2)); do
    gh_retry project item-edit --project-id "$project" --id "$item" \
      --field-id "${ids[i]}" --single-select-option-id "${ids[i + 1]}" >/dev/null
    echo "#$issue ${*:i+1:1} = ${*:i+2:1}"
  done
}

# Prints the board fields of an issue's Project item, read in one GraphQL call: the value of one
# field (empty when it has none), or "#<issue> <field> = <value>" for each field that has one.
# shellcheck disable=SC2016 # a GraphQL query, not shell
ITEM_QUERY='query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) { issue(number: $number) { projectItems(first: 20) { nodes {
    project { id }
    fieldValues(first: 20) { nodes { ... on ProjectV2ItemFieldSingleSelectValue { name field { ... on ProjectV2FieldCommon { name } } } } } } } } }
}'
item_get() {
  [ $# -ge 1 ] && [ $# -le 2 ] && [[ $1 =~ ^[0-9]+$ ]] || usage
  local issue=$1 field=${2:-} file project slug answer err
  file=$(config_file)
  project=$(jq -r '.project.id // empty' "$file")
  [ -n "$project" ] || die "no Project in .claude/senior-mode.json; run /senior-mode:setup"
  slug=$(repo_slug)
  answer=$(jq -nc --arg q "$ITEM_QUERY" --arg o "${slug%%/*}" --arg n "${slug#*/}" --argjson i "$issue" \
    '{query: $q, variables: {owner: $o, name: $n, number: $i}}' | gh_retry api graphql --input -) ||
    die "cannot read #$issue from GitHub"
  err=$(jq -r '.errors[0].message // empty' <<<"$answer" 2>/dev/null) || die "GitHub answered something that is not JSON"
  [ -z "$err" ] || die "GitHub refused the query for #$issue: $err"
  jq -e --arg p "$project" '[.data.repository.issue.projectItems.nodes[]? | select(.project.id == $p)] | length > 0' \
    <<<"$answer" >/dev/null || die "#$issue is not on the board"
  jq -r --arg p "$project" --arg f "$field" --arg i "$issue" '
    [.data.repository.issue.projectItems.nodes[] | select(.project.id == $p) | .fieldValues.nodes[] | select(.field.name)]
    | if $f == "" then .[] | "#\($i) \(.field.name) = \(.name)" else (map(select(.field.name == $f) | .name)[0] // "") end' <<<"$answer"
}

# Numbers of the issues linked to an issue through a REST list (blocked_by, sub_issues).
linked() {
  gh_retry api "repos/$1/issues/$2/$3" --paginate --jq '.[].number'
}

# Adds a link unless it exists. Not retried: a POST applied before a timeout would fail again.
link() {
  local slug=$1 issue=$2 path=$3 key=$4 other=$5 existing id
  existing=$(linked "$slug" "$issue" "$path")
  ! grep -qx "$other" <<<"$existing" || return 0
  id=$(gh_retry api "repos/$slug/issues/$other" --jq .id)
  gh api -X POST "repos/$slug/issues/$issue/$path" -F "$key=$id" >/dev/null
}

# Priority a Severity implies: critical is P0, high is P1, the others none. With --priority too,
# the stricter of the two wins (the lower P number).
severity_priority() {
  case $1 in critical) echo "P0 now" ;; high) echo "P1 next" ;; esac
}

# The details of a critical risk go in a draft security advisory, private to the maintainers. A
# private repository has none: say so. The details are needed before anything is filed.
advisory() {
  local slug=$1 title=$2 details=$3 private url
  private=$(gh_retry repo view "$slug" --json isPrivate --jq .isPrivate)
  if [ "$private" = true ]; then
    echo "private repository: no security advisory opened, keep the details out of the issue"
    return 0
  fi
  [ -n "$details" ] || die "a critical risk in a public repository needs --details-file (the advisory holds the details)"
  [ "$details" != - ] || details=/dev/stdin
  url=$(jq -n --arg s "$title" --rawfile d "$details" --arg n "${slug#*/}" \
    '{summary: $s, description: $d, severity: "critical", vulnerabilities: [{package: {ecosystem: "other", name: $n}}]}' |
    gh api -X POST "repos/$slug/security-advisories" --input - --jq .html_url) || die "could not open the security advisory"
  echo "draft security advisory: $url"
}

# Creates a ticket with its board fields, milestone, type label, blocked-by links and parent epic.
# --severity adds the Severity field and the label `security`. --kind, --path and --rule (a risk
# outside the ticket) add the line `security-id: <sha256 of the three>` to the body: an open issue
# that carries it is reported and left alone. A critical one in a public repository also opens a
# draft security advisory holding --details-file, which never goes in the issue (spec 130);
# --no-advisory skips that for a risk that is no flaw of the project's own code (an alert GitHub raises).
# An open issue with the same title is reused, so a run cut short can be repeated (spec 0001 §7):
# its body, fields, milestone, label and links converge to the arguments, its Status only with --status.
issue_create() {
  local title="" body="" size="" priority="" severity="" status="" milestone="" type="" parent=""
  local kind="" path="" rule="" details="" sid="" text private no_advisory=""
  local blockers=() edits=() file slug found number url b fields implied have
  while [ $# -gt 0 ]; do
    case $1 in -h | --help)
      echo "usage: senior-mode issue create --title <t> --body-file <file|-> --size <S|M|L> [--priority <option>] [--severity critical|high|moderate|low] [--kind <k> --path <p> --rule <r> [--details-file <file|-> | --no-advisory]] [--status <option>] [--milestone <title>] [--type feature|bug|task|chore] [--blocked-by <n>]... [--parent <n>]"
      echo "--priority is required unless --severity is critical (P0) or high (P1). --kind, --path and --rule go together and need --severity."
      return 0 ;;
    esac
    if [ "$1" = --no-advisory ]; then
      no_advisory=1
      shift
      continue
    fi
    [ $# -ge 2 ] || usage
    case $1 in
      --title) title=$2 ;;
      --body-file) body=$2 ;;
      --size) size=$2 ;;
      --priority) priority=$2 ;;
      --severity) severity=$2 ;;
      --kind) kind=$2 ;;
      --path) path=$2 ;;
      --rule) rule=$2 ;;
      --details-file) details=$2 ;;
      --status) status=$2 ;;
      --milestone) milestone=$2 ;;
      --type) type=$2 ;;
      --blocked-by) blockers+=("$2") ;;
      --parent) parent=$2 ;;
      *) usage ;;
    esac
    shift 2
  done
  case $severity in "" | critical | high | moderate | low) ;; *) die "unknown severity $severity (critical, high, moderate, low)" ;; esac
  implied=$(severity_priority "$severity")
  [ -n "$priority" ] || priority=$implied
  [ -n "$title" ] && [ -n "$size" ] && [ -n "$priority" ] ||
    die "issue create needs --title, --body-file, --size and --priority (optional with --severity critical or high)"
  [ "$body" = - ] || [ -f "$body" ] || die "no body file: $body"
  if [ -n "$kind$path$rule" ]; then
    [ -n "$kind" ] && [ -n "$path" ] && [ -n "$rule" ] || die "--kind, --path and --rule go together, none empty"
    [ -n "$severity" ] || die "--kind, --path and --rule need --severity"
    case $kind$path$rule in *$'\n'*) die "--kind, --path and --rule cannot hold a newline" ;; esac
    sid=$(printf '%s\n%s\n%s\n' "$kind" "$path" "$rule" | sha256sum | cut -d' ' -f1)
  fi
  if [ -n "$details" ]; then
    [ "$severity" = critical ] && [ -n "$sid" ] || die "--details-file is for a critical risk with --kind, --path and --rule"
    [ "$details" = - ] || [ -f "$details" ] || die "no details file: $details"
    [ "$details" != - ] || [ "$body" != - ] || die "--body-file and --details-file cannot both read stdin"
  fi
  [ -z "$no_advisory" ] || [ -z "$details" ] || die "--no-advisory and --details-file exclude each other"
  case $type in "" | feature | bug | task | chore) ;; *) die "unknown type $type (feature, bug, task, chore)" ;; esac
  # ${a[@]+...}: an empty array is unbound under set -u before bash 4.4.
  for b in ${blockers[@]+"${blockers[@]}"}; do
    [[ $b =~ ^[1-9][0-9]*$ ]] || die "not an issue number: $b"
  done
  [ -z "$parent" ] || [[ $parent =~ ^[1-9][0-9]*$ ]] || die "not an issue number: $parent"
  file=$(config_file)
  [ -z "$priority" ] || option_id "$file" Priority "$priority" >/dev/null
  if [ -n "$implied" ]; then
    [[ $priority =~ ^P([0-9]+) ]] && have=${BASH_REMATCH[1]} || have=99
    [[ $implied =~ ^P([0-9]+) ]]
    [ "$have" -lt "${BASH_REMATCH[1]}" ] || priority=$implied
  fi
  fields=(Priority "$priority" Size "$size")
  [ -z "$severity" ] || fields+=(Severity "$severity")
  option_id "$file" Size "$size" >/dev/null
  [ -z "$severity" ] || option_id "$file" Severity "$severity" >/dev/null
  option_id "$file" Priority "$priority" >/dev/null
  option_id "$file" Status "${status:-Backlog}" >/dev/null
  slug=$(repo_slug)

  if [ -n "$sid" ]; then
    found=$(gh_retry issue list --repo "$slug" --state open --limit 1000 --json number,title,body,labels |
      jq -r --arg l "security-id: $sid" 'first(.[] | select(any(.labels[]?; .name == "security") and ((.body // "") | split("\n") | index($l))) | "#\(.number) \(.title)") // empty')
    if [ -n "$found" ]; then
      echo "$found (already filed, security-id ${sid:0:12})"
      return 0
    fi
    # Read once, before anything is created: stdin is gone after the first read.
    text=$(cat "$body")
    [ "$severity" != critical ] || [ -n "$no_advisory" ] || advisory "$slug" "$title" "$details"
    body=$(mktemp)
    printf '%s\n\nsecurity-id: %s\n' "$text" "$sid" >"$body"
  fi

  # The number of an open issue with this title, then its type labels other than the asked one.
  # With a fingerprint only the security-id matches: another issue of the same title is left alone.
  [ -n "$sid" ] || found=$(gh_retry issue list --repo "$slug" --state open --limit 1000 --json number,title,labels |
    jq -r --arg t "$title" --arg k "type:$type" 'first(.[] | select(.title == $t)
      | [.number | tostring] + [.labels[]?.name | select(startswith("type:") and . != $k)]
      | join("\n")) // empty')
  number=$(head -1 <<<"$found")
  if [ -n "$number" ]; then
    echo "#$number $title (already open, body updated)"
    [ -z "$milestone" ] || edits+=(--milestone "$milestone")
    [ -z "$severity" ] || edits+=(--add-label security)
    if [ -n "$type" ]; then
      edits+=(--add-label "type:$type")
      while IFS= read -r b; do
        [ -z "$b" ] || edits+=(--remove-label "$b")
      done <<<"$(tail -n +2 <<<"$found")"
    fi
    [ ${#edits[@]} -eq 0 ] || gh_retry issue edit "$number" --repo "$slug" "${edits[@]}" >/dev/null
    # Not retried: a body read from stdin is gone after the first attempt.
    gh issue edit "$number" --repo "$slug" --body-file "$body" >/dev/null
  else
    url=$(gh issue create --repo "$slug" --title "$title" --body-file "$body" \
      ${milestone:+--milestone "$milestone"} ${type:+--label "type:$type"} ${severity:+--label security})
    number=${url##*/}
    echo "#$number $title (created)"
    status=${status:-Backlog}
  fi
  [ -z "$sid" ] || rm -f "$body"
  [ -z "$status" ] || fields=(Status "$status" "${fields[@]}")
  item_set "$number" "${fields[@]}"
  for b in ${blockers[@]+"${blockers[@]}"}; do
    link "$slug" "$number" dependencies/blocked_by issue_id "$b"
    echo "#$number blocked by #$b"
  done
  if [ -n "$parent" ]; then
    link "$slug" "$parent" sub_issues sub_issue_id "$number"
    echo "#$number under #$parent"
  fi
}

# The open alerts GitHub itself raises (#172), as one JSON object per line: severity, kind, path and
# rule for `issue create`, a title and a body. Only high and critical Dependabot alerts count (GitHub
# says "medium" where we say moderate); a secret-scanning alert is critical. The body names the alert
# and where to read it, never the vulnerability's details, and the secret's value is never read.
# shellcheck disable=SC2016 # jq programs, not shell
DEPENDABOT_ALERTS_JQ='.[] | select(.state == "open" and (.security_advisory.severity | IN("high", "critical")))
  | .security_advisory.severity as $sev | .security_advisory.ghsa_id as $id | .dependency.package.name as $pkg
  | (.dependency.manifest_path // "unknown") as $manifest | .html_url as $url
  | {severity: $sev, kind: "dependabot", path: $manifest, rule: "\($id) \($pkg)",
     title: "Update \($pkg): \($sev) Dependabot alert (\($id))",
     body: "## Context\n\nDependabot reports an open \($sev) alert on `\($pkg)` (\(.dependency.package.ecosystem)) in `\($manifest)`: \($id).\nAlert: \($url)\n\n## Acceptance criteria\n\n- Given the alert is open, when `\($pkg)` is updated to a patched version or removed, then the alert closes.\n"}
  | @json'
# shellcheck disable=SC2016 # jq programs, not shell
SECRET_ALERTS_JQ='.[] | select(.state == "open") | .number as $n | .secret_type as $type
  | (.secret_type_display_name // $type) as $name | .html_url as $url
  | {severity: "critical", kind: "secret-scanning", path: "alerts/\($n)", rule: $type,
     title: "Revoke exposed secret: \($name) (alert #\($n))",
     body: "## Context\n\nGitHub secret scanning reports an exposed \($name) in this repository. The value is not repeated here.\nAlert: \($url)\n\n## Acceptance criteria\n\n- Given the secret is exposed, when it is revoked at its provider and removed from the repository, then the alert is resolved.\n"}
  | @json'

# Files one issue for each open high or critical Dependabot alert and each open secret-scanning alert
# (treated as critical), through `issue create` with a fingerprint, so a second pass files nothing
# new (#144, #172). Below high nothing is filed. An alert source GitHub refuses (scanning not enabled,
# no permission, 404) or an issue that cannot be filed is said on stderr and never stops the caller.
security_alerts() {
  local slug source prog alerts line sev kind path rule title body
  slug=$(repo_slug)
  for source in dependabot secret-scanning; do
    case $source in dependabot) prog=$DEPENDABOT_ALERTS_JQ ;; *) prog=$SECRET_ALERTS_JQ ;; esac
    if ! alerts=$(gh_retry api "repos/$slug/$source/alerts?state=open&per_page=100" --paginate --jq "$prog" 2>&1); then
      echo "security alerts: $source alerts not read ($(head -n 1 <<<"${alerts#gh: }"))" >&2
      continue
    fi
    while IFS= read -r line; do
      [ -n "$line" ] || continue
      IFS=$'\t' read -r sev kind path rule title < <(jq -r '[.severity, .kind, .path, .rule, .title] | @tsv' <<<"$line")
      body=$(mktemp)
      jq -r .body <<<"$line" >"$body"
      "$SELF" issue create --title "$title" --body-file "$body" --size S --severity "$sev" \
        --kind "$kind" --path "$path" --rule "$rule" --no-advisory </dev/null ||
        echo "security alerts: $kind alert $rule not filed" >&2
      rm -f "$body"
    done <<<"$alerts"
  done
}

# Pinned so a release does not change with the CLI's latest version; it needs Node 22 or later.
RELEASE_PLEASE=17.11.2

# Runs release-please locally (ADR 0006): tags and publishes a merged release PR, then opens or
# updates the next one. The token goes through a private file, out of the process list.
release() {
  local dry="" root slug token step
  case ${1:-} in "") ;; --dry-run) dry=--dry-run ;; *) usage ;; esac
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
  [ -f "$root/release-please-config.json" ] ||
    die "no release-please-config.json; run senior-mode setup repo"
  slug=$(repo_slug)
  token=$(mktemp)
  # shellcheck disable=SC2064 # expand now: $token is local and gone when the trap runs
  trap "rm -f '$token'" EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  gh auth token >"$token" || die "gh is not logged in; run gh auth login"
  for step in github-release release-pr; do
    (cd "$root" && npx --yes "release-please@$RELEASE_PLEASE" "$step" \
      --token "$token" --repo-url "$slug" ${dry:+"$dry"}) || die "release-please $step failed"
  done
}

# Where the result of `check` is kept for a commit, until `publish` sends it (ADR 0006).
check_record() {
  printf '%s/%s\n' "$(git rev-parse --git-path senior-mode/checks)" "$1"
}

# Whether `check` audits the dependencies (`audit`, on by default); anything but a boolean is an error.
audit_enabled() {
  local value
  value=$(config_get audit)
  [[ $value =~ ^(true|false)$ ]] || die "audit must be true or false, not $value"
  [ "$value" = true ]
}

# Milliseconds on a clock that only goes forward; whole seconds where the shell has no EPOCHREALTIME.
now_ms() {
  if [ -n "${EPOCHREALTIME:-}" ]; then
    local t=${EPOCHREALTIME/[.,]/}
    echo $((t / 1000))
  else
    echo $((SECONDS * 1000))
  fi
}

# The time since $1 (a now_ms value) as "1.2s".
since_ms() {
  local ms=$(($(now_ms) - $1))
  printf '%d.%ds' $((ms / 1000)) $((ms % 1000 / 100))
}

# The paths a push changes, from the lines git gives a pre-push hook on stdin (<ref> <sha> <remote ref>
# <remote sha>): what the remote does not have yet. Prints nothing and fails when they cannot all be told
# (no ref, a deletion, a remote commit this clone does not have, a new branch with no base): the caller then
# runs everything.
pushed_paths() {
  local sha rsha from found=false
  while read -r _ sha _ rsha; do
    [[ $sha =~ ^0+$ ]] && return 1
    if [[ $rsha =~ ^0+$ ]]; then
      from=$(default_branch) && from=$(git merge-base "$sha" "$from") || return 1
    else
      git cat-file -e "$rsha^{commit}" 2>/dev/null || return 1
      from=$rsha
    fi
    git -c core.quotePath=false diff --name-only --no-renames "$from" "$sha" || return 1
    found=true
  done
  $found
}

# Runs the built-in secret scan and dependency audit, then the configured checks, from the repository
# root, each with the time it took. On a clean tree, records the result for HEAD. With --pre-push (the
# hook's stdin is the pushed refs) the checks get the changed paths in SENIOR_MODE_CHANGED_FILES, so one that
# can narrow itself to them does; that run is not recorded, because publish needs a full one.
check() {
  local file root count i name cmd output passed=0 failed="" state description names cmds started took scope=""
  file=$(config_file)
  unset SENIOR_MODE_CHANGED_FILES
  if [ "${1:-}" = --pre-push ]; then
    scope=$(mktemp)
    if pushed_paths >"$scope"; then
      export SENIOR_MODE_CHANGED_FILES=$scope
    else
      rm -f "$scope"
      scope=""
    fi
  fi
  root=$(git rev-parse --show-toplevel)
  count=$(jq '.checks // [] | length' "$file")
  [ "$count" -gt 0 ] || die "no checks in .claude/senior-mode.json; run /senior-mode:setup"
  # Without its dependencies a node project fails typecheck and build with errors that do not say so (#110).
  if deps_missing "$root"; then
    echo "FAIL  dependencies not installed: run $(install_command "$root")"
    rm -f "$scope"
    return 1
  fi
  # The secret scan is not configurable: it runs first, on every preset. The dependency audit follows, and
  # `audit: false` turns it off (ADR 0015).
  names=("secret scan" "dependency audit")
  cmds=("$(printf '%q' "$SELF") secret-scan" "$(printf '%q' "$SELF") audit")
  for ((i = 0; i < count; i++)); do
    names+=("$(jq -r ".checks[$i].name" "$file")")
    cmds+=("$(jq -r ".checks[$i].run" "$file")")
  done
  count=${#names[@]}
  output=$(mktemp)
  for ((i = 0; i < count; i++)); do
    name=${names[i]}
    cmd=${cmds[i]}
    started=$(now_ms)
    # End-to-end suites are heavy: parallel tickets share e2e.slots of them per machine.
    [ "$name" != e2e ] || cmd="$(printf '%q' "$SELF") e2e-lock -- bash -c $(printf '%q' "$cmd")"
    # Git exports GIT_DIR to hooks, absolute in a linked worktree: a check that runs git on a test
    # fixture would write into this repository.
    if (cd "$root" && for v in $(git rev-parse --local-env-vars); do unset "$v"; done && bash -c "$cmd") \
      >"$output" 2>&1; then
      took=$(since_ms "$started")
      passed=$((passed + 1))
      # A check with nothing to do says so on its first line; show why instead of a bare ok.
      if [[ $(head -n 1 "$output") == "skipped: "* ]]; then
        echo "skip  $name: $(head -n 1 "$output" | cut -c10-) ($took)"
      else
        echo "ok    $name ($took)"
      fi
      # A warning of a passing check (an advisory with no severity) is shown, not lost.
      { grep '^warning: ' "$output" || true; } | sed 's/^/      /'
    else
      took=$(since_ms "$started")
      failed="${failed:+$failed, }$name"
      echo "FAIL  $name ($took)"
      # The audit lists every blocking advisory (it caps them itself); another check shows its last lines.
      tail -n "$([ "$name" = "dependency audit" ] && echo 300 || echo 20)" "$output" | sed 's/^/      /'
    fi
  done
  rm -f "$output" "$scope"
  if [ -z "$failed" ]; then
    state=success description="$passed/$count checks passed"
  else
    state=failure description="failed: $failed"
  fi
  description=${description:0:140}
  if [ -n "$scope" ]; then
    echo "note: narrowed to the pushed paths, result not recorded for publishing"
  elif [ -z "$(git status --porcelain)" ]; then
    mkdir -p "$(dirname "$(check_record x)")"
    printf '%s\n%s\n' "$state" "$description" >"$(check_record "$(git rev-parse HEAD)")"
  else
    echo "note: uncommitted changes, result not recorded for publishing"
  fi
  echo "$description"
  [ "$state" = success ]
}

# The sha256 of $1, as sha256sum or shasum prints it.
sha256() {
  if command -v sha256sum >/dev/null; then
    printf %s "$1" | sha256sum | cut -d' ' -f1
  else
    printf %s "$1" | shasum -a 256 | cut -d' ' -f1
  fi
}

# The secret scan of `check` (#143, spec 130): the lines added by <base>...HEAD against the patterns of the
# plugin (`secret-patterns`). Prints `file:line: kind` for each finding, never the value; exit 1 when there
# is one. A value whose sha256 is in `.claude/secret-allowlist` of the base, with a reason, is lifted: a
# branch cannot allowlist its own secret. Runs as its own process (`senior-mode secret-scan`).
secret_scan() {
  local base patterns allow added kind mode re n value raw findings flags path line sep=$'\x1f'
  base=$(default_branch) || {
    echo "skipped: no base branch"
    return 0
  }
  patterns=$(dirname "$SELF")/../secret-patterns
  [ -f "$patterns" ] || die "secret patterns not found: $patterns"
  allow=$(git show "$base:.claude/secret-allowlist" 2>/dev/null |
    grep -E '^[0-9a-f]{64}[[:space:]]+[^[:space:]]' | cut -c1-64) || true
  added=$(mktemp)
  # The copy holds the secrets of the diff: it goes away whatever way this process ends.
  # shellcheck disable=SC2064 # expand now: $added is local and gone when the trap runs
  trap "rm -f '$added'" EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  # The added lines as <file> <line> <text>. A "+++ " line is a file header only before the first hunk.
  git -c core.quotePath=false diff -U0 --no-color --no-ext-diff --no-textconv --no-renames --no-prefix \
    "$base...HEAD" | awk -v s="$sep" '
    /^diff / { header = 1; next }
    header && /^\+\+\+ / { file = substr($0, 5); sub(/\t$/, "", file); next }
    /^@@ / { header = 0; if (match($0, /\+[0-9]+/)) n = substr($0, RSTART + 1, RLENGTH - 1) + 0; next }
    !header && /^\+/ { printf "%s%s%d%s%s\n", file, s, n, s, substr($0, 2); n++ }' >"$added" ||
    die "cannot compare with $base"
  # One grep and one awk per pattern, not one process per matching line: grep -n gives the number of the line
  # of $added, awk drops what is not a secret, and only a finding costs a hash. A finding is <n> <kind>.
  raw=$(
    while IFS=$'\t' read -r kind mode re; do
      case $kind in "" | "#"*) continue ;; esac
      flags=(-noE)
      [ "$mode" != assign ] || flags=(-i -noE)
      cut -d "$sep" -f 3- "$added" | { grep "${flags[@]}" -- "$re" || true; } | awk -v mode="$mode" -v kind="$kind" -v s="$sep" '
        { i = index($0, ":"); n = substr($0, 1, i - 1); m = substr($0, i + 1); v = m }
        mode == "assign" {
          # The value, not the name. A name only looks like a secret when its value holds letters and
          # digits and is neither a placeholder nor a dotted identifier (process.env.TOKEN_1).
          sub(/^[^:=]*[:=][ \t]*["'"'"']?/, "", v)
          if (v !~ /[0-9]/ || v !~ /[A-Za-z]/ || v ~ /^[A-Za-z_][A-Za-z0-9_]*(\.[A-Za-z_][A-Za-z0-9_]*)+$/) next
          if (tolower(v) ~ /example|changeme|placeholder|your|dummy|sample|xxxx/) next
        }
        mode == "url" {
          # A password is not reported when the whole of it is one template form (${X}, $(X), $X, {X}, {{X}},
          # %(x)s, %s, <x>, ***) or, below, a placeholder word, digits kept: a short password, or Secret123, is a
          # real one, and so is one that merely contains a template (Zq9{x}). X is an identifier. A password that
          # is only $name or {name} stays a template. No {n,m} interval: mawk, BSD awk and busybox do not all read it.
          pw = m
          sub(/^[^:]*:\/\/[^:\/@]*:/, "", pw)
          sub(/@.*/, "", pw)
          if (pw ~ /^([$][{][A-Za-z_][A-Za-z0-9_]*[}]|[$][(][A-Za-z_][A-Za-z0-9_]*[)]|[$][A-Za-z_][A-Za-z0-9_]*|[{][A-Za-z_][A-Za-z0-9_]*[}]|[{][{][A-Za-z_][A-Za-z0-9_]*[}][}]|%[(][A-Za-z_][A-Za-z0-9_]*[)]s|(%s)+|<[A-Za-z_][A-Za-z0-9_-]*>|[*][*][*]+)$/) next
          w = tolower(pw)
          gsub(/[_-]/, "", w)
          if (w ~ /^(pass(word|wd)?|secret|example|changeme|changeit|placeholder|dummy|sample|test(ing)?|user(name)?|(your|my)(pass(word|wd)?|secret)?(here)?)$/ || w ~ /^xxx+$/) next
        }
        { printf "%s%s%s%s%s\n", n, s, kind, s, (mode == "block" ? "" : v) }'
    done <"$patterns" |
      while IFS=$sep read -r n kind value; do
        # Only a block needs its lines: the whole key, so that the header, public text, lifts nothing but itself.
        if [ -z "$value" ]; then
          IFS=$sep read -r path line _ < <(sed -n "${n}p" "$added")
          value=$(awk -F"$sep" -v p="$path" -v l="$line" '
            $1 == p && $2 + 0 >= l {
              if (c && $2 + 0 != prev + 1) exit
              prev = $2 + 0
              printf "%s%s", (c++ ? "\n" : ""), $3
              if ($3 ~ /-----END /) exit
            }' "$added")
        fi
        [ -z "$allow" ] || ! grep -qxF "$(sha256 "$value")" <<<"$allow" || continue
        printf '%s%s%s\n' "$n" "$sep" "$kind"
      done
  )
  [ -n "$raw" ] || return 0
  findings=$(awk -F"$sep" '
    NR == FNR { if (!(($1 SUBSEP $2) in seen)) { seen[$1, $2] = 1; k[$1, ++c[$1]] = $2 }; next }
    FNR in c { for (j = 1; j <= c[FNR]; j++) printf "%s:%s: %s\n", $1, $2, k[FNR, j] }' \
    <(printf '%s\n' "$raw") "$added" | sort -t: -k1,1 -k2,2n | uniq) || true
  printf '%s\n' "$findings"
  echo "a value is lifted by \"<sha256 of the value> <reason>\" in .claude/secret-allowlist on $base (printf %s <value> | sha256sum)"
  return 1
}

# The dependency audit of `check` (#142, spec 130): the audit tool of each lockfile at the repository root
# (pnpm-lock.yaml or package-lock.json, requirements.txt, go.sum, Cargo.lock), its JSON read into advisories.
# A high or critical advisory fails, naming package, advisory and fixed version; any other is a warning, an
# advisory with no severity too (pip-audit, govulncheck and cargo audit give none; Dependabot covers it).
# A missing tool, or one that gives no usable answer, fails: nothing was audited. Runs as its own process
# (`senior-mode audit`).
audit_scan() {
  local root rc=0 found=false eco err
  audit_enabled || {
    echo "skipped: off (audit: false)"
    return 0
  }
  root=$(git rev-parse --show-toplevel)
  err=$(mktemp)
  # shellcheck disable=SC2064 # expand now: $err is local and gone when the trap runs
  trap "rm -f '$err'" EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  for eco in pnpm:pnpm-lock.yaml npm:package-lock.json pip:requirements.txt go:go.sum cargo:Cargo.lock; do
    [ -f "$root/${eco#*:}" ] || continue
    # pnpm's lockfile wins over a leftover package-lock.json.
    [ "${eco%%:*}" != npm ] || [ ! -f "$root/pnpm-lock.yaml" ] || continue
    found=true
    audit_one "$root" "${eco%%:*}" "$err" || rc=1
  done
  [ "$found" = true ] || echo "skipped: no lockfile (package-lock.json, pnpm-lock.yaml, requirements.txt, go.sum, Cargo.lock)"
  return "$rc"
}

# Audits the project at $1 with the tool of ecosystem $2 (stderr to the file $3). The filter turns the
# tool's JSON (all of it, as an array of documents) into [{severity, package, advisory, fixed}]; it fails on
# a document that is not that tool's report, so an error answer is never read as a clean audit.
# shellcheck disable=SC2016 # jq programs, not shell
audit_one() {
  local root=$1 eco=$2 err=$3 bin hint filter maxrc=1 out rc=0 adv reason line limit=${SENIOR_MODE_AUDIT_TIMEOUT:-600}
  local argv=() bound=()
  case $eco in
    npm)
      bin=npm hint="install Node.js from https://nodejs.org" argv=(npm audit --json)
      # via lists the advisories (objects) and the packages vulnerable through another (strings).
      filter='[.[0].vulnerabilities | to_entries[].value as $v | $v.via[] | select(type == "object")
        | {severity, package: .name, advisory: ((.url // .title) | split("/") | last),
           fixed: ($v.fixAvailable | if type == "object" then (if .name == $v.name then .version else "\(.name) \(.version)" end)
             elif . == true then "a newer version (npm audit fix)" else "" end)}]'
      ;;
    pnpm)
      bin=pnpm hint="run npm install -g pnpm" argv=(pnpm audit --json)
      filter='[.[0].advisories | to_entries[].value | {severity, package: .module_name,
        advisory: (.github_advisory_id // (.url | split("/") | last)),
        fixed: (if (.patched_versions // "") | IN("", "<0.0.0") then "" else .patched_versions end)}]'
      ;;
    pip)
      # pip-audit before 2.7 printed the list of dependencies itself.
      bin=pip-audit hint="run pipx install pip-audit (or pip install pip-audit)" argv=(pip-audit -r requirements.txt -f json)
      # A dependency it skipped (a local path, -e, not on the index) has a skip_reason and no vulns.
      filter='[(.[0] | if type == "array" then . else .dependencies end)[] | . as $d
        | ((.vulns // [])[] | {severity: null, package: $d.name, advisory: .id, fixed: ((.fix_versions // []) | join(", "))}),
          (select(.skip_reason) | {severity: null, package: $d.name, skipped: .skip_reason})]'
      ;;
    go)
      # govulncheck -json exits 0 whatever it finds. A finding whose first frame names a function is a
      # vulnerability the code calls; the others only require or import the module.
      bin=govulncheck hint="run go install golang.org/x/vuln/cmd/govulncheck@latest" argv=(govulncheck -json ./...)
      maxrc=0
      filter='[.[] | select(.finding) | .finding | select(.trace[0].function)
        | {severity: null, package: .trace[0].module, advisory: .osv, fixed: (.fixed_version // "")}]'
      ;;
    cargo)
      bin=cargo-audit hint="run cargo install cargo-audit --locked" argv=(cargo audit --json)
      filter='[.[0].vulnerabilities.list[] | {severity: null, package: .package.name, advisory: .advisory.id,
        fixed: ((.versions.patched // []) | join(", "))}]'
      ;;
  esac
  command -v "$bin" >/dev/null || {
    echo "$bin not installed: $hint"
    return 1
  }
  # A tool that hangs (a registry that does not answer) would hang `check` and the pre-push hook with it.
  ! command -v timeout >/dev/null || bound=(timeout "$limit")
  out=$(cd "$root" && ${bound[@]+"${bound[@]}"} "${argv[@]}" 2>"$err") || rc=$?
  if [ -n "$out" ] && [ "$rc" -le "$maxrc" ] &&
    adv=$(jq -sc "$filter | map(.severity |= (if . == null then null else ascii_downcase end)) | unique" <<<"$out" 2>/dev/null); then
    :
  else
    if [ "$rc" -eq 124 ] && [ ${#bound[@]} -gt 0 ]; then
      echo "${argv[*]}: timed out after $limit s (SENIOR_MODE_AUDIT_TIMEOUT), nothing was audited"
      return 1
    fi
    echo "${argv[*]}: no usable answer (exit $rc)"
    # What the tool says of itself: an error object on stdout (npm, pnpm), else its last words on stderr.
    reason=$({ jq -r '(.error // empty) | if type == "object" then (.summary // .message // empty) else . end' <<<"$out" 2>/dev/null
      tail -n 3 "$err"; } | { grep -v '^[[:space:]]*$' || true; } | head -n 3)
    reason=${reason:-the tool gave no output (offline?)}
    echo "  ${reason//$'\n'/$'\n'  }"
    return 1
  fi
  # A dependency a tool skipped is a warning with its reason; any other line names the advisory.
  line='def line: if .skipped then "not audited: \(.package) (\(.skipped))"
    else "\(.severity // "no severity"): \(.package) \(.advisory), "
      + (if .fixed == "" then "no fixed version" else "fixed in \(.fixed)" end) end;'
  jq -r "$line"'.[] | select(.severity | IN("high", "critical") | not) | "warning: " + line' <<<"$adv" |
    audit_cap 20 "warning: ... " warnings
  # Blocking lines come last, whole up to a generous cap: `check` shows the end of a failure.
  jq -r "$line"'.[] | select(.severity | IN("high", "critical")) | line' <<<"$adv" | audit_cap 100 "... " "blocking advisories"
  [ "$(jq '[.[] | select(.severity | IN("high", "critical"))] | length' <<<"$adv")" -eq 0 ]
}

# Prints at most $1 lines of stdin, then "<$2><n> more <$3>".
audit_cap() {
  local n=$1 more=$2 what=$3 total=0 line
  while IFS= read -r line; do
    total=$((total + 1))
    [ "$total" -gt "$n" ] || printf '%s\n' "$line"
  done
  [ "$total" -le "$n" ] || echo "$more$((total - n)) more $what"
  return 0
}

file_owner() { stat -c %u "$1" 2>/dev/null || stat -f %u "$1"; }
file_mode() { stat -c %a "$1" 2>/dev/null || stat -f %Lp "$1"; }

# senior-mode e2e-lock -- <command>...: runs the command once one of `e2e.slots` machine-wide slots
# is free (flock), so parallel tickets never run more end-to-end suites at once than the machine
# holds. The command sees its slot number in SENIOR_MODE_E2E_SLOT (for example to pick a port).
e2e_lock() {
  [ "${1:-}" = -- ] && [ $# -ge 2 ] || usage
  shift
  local slots dir i fd waited=false rc
  slots=$(config_get e2e.slots 2>/dev/null) || slots=2
  [[ $slots =~ ^[1-9][0-9]*$ ]] || die "e2e.slots must be a positive number, not $slots"
  command -v flock >/dev/null || die "e2e-lock needs flock (util-linux)"
  if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
    dir=$XDG_RUNTIME_DIR/senior-mode-e2e
  else
    dir=${TMPDIR:-/tmp}/senior-mode-e2e-$(id -u)
  fi
  [ -L "$dir" ] || [ -d "$dir" ] || mkdir -m 700 "$dir" 2>/dev/null || [ -d "$dir" ] ||
    die "cannot create the e2e lock directory $dir"
  # Other users share /tmp: never use a directory that is a link, not ours or open to others.
  { [ ! -L "$dir" ] && [ "$(file_owner "$dir")" = "$(id -u)" ] && [ "$(file_mode "$dir")" = 700 ]; } ||
    die "e2e lock directory $dir must be a real directory owned by you with mode 0700; remove it or fix it"
  while :; do
    for ((i = 1; i <= slots; i++)); do
      exec {fd}>>"$dir/slot-$i"
      if flock -n "$fd"; then
        set +e
        SENIOR_MODE_E2E_SLOT=$i "$@"
        rc=$?
        exit "$rc"
      fi
      exec {fd}>&-
    done
    [ "$waited" = true ] || echo "senior-mode: waiting for a free e2e slot ($slots in use)" >&2
    waited=true
    sleep "${SENIOR_MODE_LOCK_POLL:-2}"
  done
}

# Open pull requests that contain a commit, with the issues each closes (for the security status).
# shellcheck disable=SC2016 # a GraphQL query, not shell
ASSOC_QUERY='query($owner: String!, $name: String!, $sha: GitObjectID!) { repository(owner: $owner, name: $name) {
  object(oid: $sha) { ... on Commit { associatedPullRequests(first: 10) { nodes { number state
    closingIssuesReferences(first: 20) { nodes { number } } } } } } } }'

# What `publish` says of senior-mode/security on a commit, as "<state> <description>" (ADR 0015): success
# "not required" only when no protected zone of the base branch is touched and no ticket the pull
# request closes is L; pending in every other case, also when that cannot be read. The globs come from
# the base branch, so a branch cannot lift its own zone.
security_verdict() {
  local sha=$1 base globs files zones slug answer issues n size
  GIT_TERMINAL_PROMPT=0 git fetch -q origin 2>/dev/null || true # the base as it is now; offline, the last fetch stands
  base=$(default_branch) || { echo "pending required: no default branch to compare with"; return; }
  if git cat-file -e "$base:.claude/senior-mode.json" 2>/dev/null; then
    globs=$(git show "$base:.claude/senior-mode.json" | jq -c '.protected // []') || globs=null
  else
    globs=$(config_get protected 2>/dev/null) || globs='[]'
  fi
  jq -e 'type == "array" and all(type == "string")' <<<"$globs" >/dev/null ||
    { echo "pending required: protected is not a list of globs"; return; }
  files=$(git -c core.quotePath=false diff --name-only --no-renames "$base...$sha") ||
    { echo "pending required: cannot compare with $base"; return; }
  zones=$(protected_match "$globs" <<<"$files")
  [ -z "$zones" ] || { echo "pending required: protected zone ($(paste -sd, - <<<"$zones" | sed 's/,/, /g'))"; return; }
  slug=$(repo_slug)
  answer=$(jq -nc --arg q "$ASSOC_QUERY" --arg o "${slug%%/*}" --arg n "${slug#*/}" --arg s "$sha" \
    '{query: $q, variables: {owner: $o, name: $n, sha: $s}}' | gh_retry api graphql --input -) || answer=""
  if [ -z "$answer" ] || ! issues=$(jq -r '[.data.repository.object.associatedPullRequests.nodes[] | select(.state == "OPEN")]
    | if length == 0 then error("no open pull request") else [.[].closingIssuesReferences.nodes[].number] | unique | .[] end' \
    <<<"$answer" 2>/dev/null); then
    echo "pending required: no open pull request found for this commit, so its tickets are unknown"
    return
  fi
  for n in $issues; do
    size=$( (item_get "$n" Size) 2>/dev/null) || size=""
    [ -n "$size" ] || { echo "pending required: the Size of #$n is unknown"; return; }
    [ "$size" != L ] || { echo "pending required: closes the L ticket #$n"; return; }
  done
  echo "success not required: no protected zone, not L"
}

# Publishes the recorded check result of a commit as the status senior-mode/ci, and senior-mode/security
# when the pull request does not need the security pass. A due pass is left pending, and a status the
# security agent already set on the commit is never overwritten.
publish() {
  local sha record state description slug verdict current
  sha=$(git rev-parse --verify "${1:-HEAD}^{commit}" 2>/dev/null) || die "unknown commit: ${1:-HEAD}"
  record=$(check_record "$sha")
  [ -f "$record" ] || die "no check result for ${sha:0:7}; run senior-mode check on a clean tree first"
  state=$(sed -n 1p "$record")
  description=$(sed -n 2p "$record")
  slug=$(repo_slug)
  gh_retry api "repos/$slug/statuses/$sha" -f state="$state" -f context=senior-mode/ci \
    -f description="$description" >/dev/null ||
    die "could not publish the status of ${sha:0:7}; push the commit first"
  echo "senior-mode/ci = $state on ${sha:0:7}: $description"
  verdict=$(security_verdict "$sha")
  state=${verdict%% *} description=${verdict#* }
  # Only publish's own words are replaced: a success "not required", a pending "required: ...". Any
  # other state of the context is the security agent's (or a person's) and stays.
  current=$(gh_retry api "repos/$slug/commits/$sha/status" --jq '[.statuses[] | select(.context == "senior-mode/security")
    | select(((.state == "success" and (.description // "" | startswith("not required")))
      or (.state == "pending" and (.description // "" | startswith("required:")))) | not) | .state][0] // empty') || die "could not read the security status of ${sha:0:7}"
  [ -z "$current" ] || { echo "senior-mode/security = $current on ${sha:0:7}: left as it is"; return 0; }
  gh_retry api "repos/$slug/statuses/$sha" -f state="$state" -f context=senior-mode/security \
    -f description="${description:0:140}" >/dev/null || die "could not publish the security status of ${sha:0:7}"
  echo "senior-mode/security = $state on ${sha:0:7}: $description"
}

# Board fields and options (spec 0001 §11), in order. Aliases match options of GitHub's default
# Status field, so that values already set on items survive the repair.
BOARD='{
  "Status": [{"name": "Backlog", "color": "GRAY", "aliases": ["todo"]}, {"name": "Ready", "color": "BLUE"},
    {"name": "In progress", "color": "YELLOW"}, {"name": "In review", "color": "PURPLE"}, {"name": "Done", "color": "GREEN"}],
  "Priority": [{"name": "P0 now", "color": "RED"}, {"name": "P1 next", "color": "ORANGE"},
    {"name": "P2 later", "color": "YELLOW"}, {"name": "P3 someday", "color": "GRAY"}],
  "Size": [{"name": "S", "color": "GREEN"}, {"name": "M", "color": "YELLOW"}, {"name": "L", "color": "RED"}],
  "Severity": [{"name": "critical", "color": "RED"}, {"name": "high", "color": "ORANGE"},
    {"name": "moderate", "color": "YELLOW"}, {"name": "low", "color": "GRAY"}]
}'

# Options to give a field: the wanted ones, keeping the id, colour and description of an existing
# option with the same name (any case), else of an alias, then the field's other options unchanged.
# shellcheck disable=SC2016 # a jq program, not shell
MERGE_OPTIONS='.options as $cur
  | (reduce $want[] as $w ([];
      (map(.id)) as $taken
      | ([$cur[] | select((.id | IN($taken[]) | not) and (.name | ascii_downcase) == ($w.name | ascii_downcase))][0]
         // [$cur[] | select((.id | IN($taken[]) | not) and ((.name | ascii_downcase) | IN(($w.aliases // [])[])))][0]) as $m
      | . + [{name: $w.name, color: ($m.color // $w.color), description: ($m.description // "")}
             + (if $m then {id: $m.id} else {} end)])) as $ours
  | $ours + [$cur[] | select(.id | IN($ours[].id) | not) | {id, name, color, description}]'

# The rules senior-mode owns on the default branch (ADR 0006), as a ruleset of its own: it adds to
# whatever protection the repository has and never rewrites it. Admins may bypass, explicitly.
RULESET='{"name": "senior-mode", "target": "branch", "enforcement": "active",
  "conditions": {"ref_name": {"include": ["~DEFAULT_BRANCH"], "exclude": []}},
  "bypass_actors": [{"actor_id": 5, "actor_type": "RepositoryRole", "bypass_mode": "always"}],
  "rules": [{"type": "deletion"}, {"type": "non_fast_forward"}, {"type": "required_linear_history"},
    {"type": "pull_request", "parameters": {"required_approving_review_count": 0, "dismiss_stale_reviews_on_push": false,
      "require_code_owner_review": false, "require_last_push_approval": false,
      "required_review_thread_resolution": false, "allowed_merge_methods": ["rebase"]}},
    {"type": "required_status_checks", "parameters": {"strict_required_status_checks_policy": true,
      "do_not_enforce_on_create": false,
      "required_status_checks": [{"context": "senior-mode/ci"}, {"context": "senior-mode/review"}, {"context": "senior-mode/security"}]}}]}'

# Single-select fields of a Project, with their options.
board_fields() {
  jq -nc --arg id "$1" '{variables: {id: $id}, query: "query($id: ID!) { node(id: $id) { ... on ProjectV2 {
    fields(first: 50) { nodes { ... on ProjectV2SingleSelectField { id name options { id name color description } } } } } } }"}' |
    gh_retry api graphql --input - --jq '[.data.node.fields.nodes[] | select(.options)]'
}

# Finds the Project of the repository (cached number, else same title) or creates it; prints
# "<number> <id>". Called as `setup_project || die`, which turns off set -e here: every command
# checks its own status.
setup_project() {
  local file=$1 owner=$2 name=$3 slug=$4 number id err
  number=$(jq -r '.project.number // empty' "$file")
  if [ -n "$number" ]; then
    err=$(mktemp)
    if ! id=$(gh_retry project view "$number" --owner "$owner" --format json --jq .id 2>"$err"); then
      grep -q "Could not resolve to a ProjectV2" "$err" || die "cannot read Project #$number: $(cat "$err")"
      number=""
    fi
    rm -f "$err"
  fi
  if [ -z "$number" ]; then
    number=$(gh_retry project list --owner "$owner" --limit 100 --format json \
      --jq "[.projects[] | select(.title == \"$name\")][0].number // empty") || return 1
    if [ -z "$number" ]; then
      number=$(gh_retry project create --owner "$owner" --title "$name" --format json --jq .number) || return 1
      echo "Project #$number $name: created" >&2
    fi
    id=$(gh_retry project view "$number" --owner "$owner" --format json --jq .id) || return 1
  fi
  [ -n "$id" ] || return 1
  gh_retry project link "$number" --owner "$owner" --repo "$slug" >/dev/null || return 1
  echo "$number $id"
}

# Creates missing board fields with their colours, repairs the options of existing ones.
setup_fields() {
  local id=$1 fields field want current options
  fields=$(board_fields "$id")
  for field in Status Priority Size Severity; do
    want=$(jq -c --arg f "$field" '.[$f]' <<<"$BOARD")
    current=$(jq -c --arg f "$field" '.[] | select(.name == $f)' <<<"$fields")
    if [ -z "$current" ]; then
      jq -nc --arg p "$id" --arg n "$field" --argjson w "$want" '{variables: {project: $p, name: $n,
        options: ($w | map({name, color, description: ""}))}, query: "mutation($project: ID!, $name: String!,
        $options: [ProjectV2SingleSelectFieldOptionInput!]!) { createProjectV2Field(input: {projectId: $project,
        dataType: SINGLE_SELECT, name: $name, singleSelectOptions: $options}) { clientMutationId } }"}' |
        gh_retry api graphql --input - >/dev/null
      echo "field $field: created"
      continue
    fi
    options=$(jq -c --argjson want "$want" "$MERGE_OPTIONS" <<<"$current")
    [ "$(jq -c 'map(.name)' <<<"$options")" != "$(jq -c '.options | map(.name)' <<<"$current")" ] || continue
    jq -nc --arg f "$(jq -r .id <<<"$current")" --argjson o "$options" '{variables: {field: $f, options: $o},
      query: "mutation($field: ID!, $options: [ProjectV2SingleSelectFieldOptionInput!]!) {
        updateProjectV2Field(input: {fieldId: $field, singleSelectOptions: $options}) { clientMutationId } }"}' |
      gh_retry api graphql --input - >/dev/null
    echo "field $field: options repaired, existing values kept"
  done
}

# Names the Project's built-in workflows that keep Status true and are off. GitHub has no API to
# turn them on, so this only says where.
setup_board_workflows() {
  local off
  off=$(jq -nc --arg id "$1" '{variables: {id: $id}, query: "query($id: ID!) { node(id: $id) {
    ... on ProjectV2 { workflows(first: 20) { nodes { name enabled } } } } }"}' |
    gh_retry api graphql --input - --jq '[.data.node.workflows.nodes[]
      | select((.name | IN("Item closed", "Pull request merged")) and (.enabled | not)) | .name] | join(", ")') ||
    { echo "built-in workflows: could not read them; check Project → Workflows by hand"; return 0; }
  [ -z "$off" ] ||
    echo "built-in workflows off: $off; turn them on in the Project → Workflows (no API can), so the board moves to Done"
}

# The CODEOWNERS pattern of a `protected` glob (#171), or nothing when CODEOWNERS cannot say it.
# `protected` anchors a glob that has a slash at the root and matches one without a slash at any
# depth; CODEOWNERS, like .gitignore, anchors on a leading slash only, so one is added (`docs/` is
# then the root's docs, as in `protected`). Whitespace, a leading # or !, and brackets have no
# CODEOWNERS spelling.
codeowners_pattern() {
  case $1 in
    "" | *[[:space:]]* | \#* | \!* | *\[*) return 1 ;;
    /* | \*\*/*) printf '%s\n' "$1" ;;
    */*) printf '/%s\n' "$1" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# Maps the `protected` globs to the owner in a block of .github/CODEOWNERS delimited by
# `# senior-mode:begin` and `# senior-mode:end`; only that block is rewritten, so entries added by
# hand survive a rerun. The block goes last in a new one, where GitHub reads the last match first.
# Written, not committed: setup commits nothing, and the file protects once it is on the default branch.
# GitHub reads .github/CODEOWNERS before the root's and docs/'s: it never creates that shadow over a
# file of the project (the ownership there would be lost without a word), and names one it finds.
# The globs CODEOWNERS cannot spell are listed in the block too, so the file says what it leaves out.
# Sets codeowners_owns to true when the block owns a protected zone; review_reason decides on the review.
setup_codeowners() { # root owner globs-json slug
  local file=$1/.github/CODEOWNERS glob pat entries="" skipped="" block new verb shadow="" s there
  codeowners_owns=false
  for s in CODEOWNERS docs/CODEOWNERS; do [ ! -e "$1/$s" ] || shadow+="${shadow:+ and }$s"; done
  if [ -n "$shadow" ] && [ ! -e "$file" ]; then
    # GitHub reads the root's before docs/'s: with both, docs/ is already ignored and only the root's is lost.
    if [ -e "$1/CODEOWNERS" ] && [ -e "$1/docs/CODEOWNERS" ]; then
      shadow="CODEOWNERS would be shadowed by .github/CODEOWNERS, which GitHub reads first, and its ownership lost (docs/CODEOWNERS is already ignored by GitHub, the root's is read first)"
    else
      shadow="$shadow would be shadowed by .github/CODEOWNERS, which GitHub reads first, and its ownership lost"
    fi
    echo "CODEOWNERS: $shadow; .github/CODEOWNERS not written. Move it to .github/CODEOWNERS, then run setup github again, or add the protected zones to it by hand"
    return 0
  fi
  [ -z "$shadow" ] ||
    echo "CODEOWNERS: shadowed by .github/CODEOWNERS and ignored by GitHub: $shadow; merge its entries into .github/CODEOWNERS and delete it, or its ownership stays lost"
  while IFS= read -r glob; do
    if pat=$(codeowners_pattern "$glob"); then entries+="$pat @$2"$'\n'; else skipped+="${skipped:+, }$glob"; fi
  done < <(jq -r '.[]' <<<"$3")
  [ -z "$skipped" ] || echo "CODEOWNERS: no spelling for $skipped, left out; those zones are owned by no one, so code owner review does not cover them and they stay with the reviewer"
  block="# senior-mode:begin (managed from protected in .claude/senior-mode.json; edit outside this block)"$'\n'"$entries"
  [ -z "$skipped" ] || block+="# left to the reviewer, CODEOWNERS has no spelling for them: $skipped"$'\n'
  block+="# senior-mode:end"
  if [ ! -e "$file" ]; then
    [ -n "$entries$skipped" ] || return 0
    mkdir -p "$1/.github"
    printf '%s\n' "$block" >"$file"
    verb=created
  elif ! grep -qE '^# senior-mode:(begin|end)' "$file"; then
    [ -n "$entries$skipped" ] || return 0
    printf '%s\n\n%s\n' "$(cat "$file")" "$block" >"$file"
    verb=updated
  # One opening marker, then one closing marker, else awk refuses and the file is left alone.
  elif ! new=$(BLOCK=$block awk '
      /^# senior-mode:begin/ { if (seen++) bad = 1; print ENVIRON["BLOCK"]; skip = 1; next }
      /^# senior-mode:end/ { if (!skip) bad = 1; skip = 0; next }
      !skip { print } END { exit (bad || skip) }' "$file"); then
    echo "CODEOWNERS: senior-mode markers broken, file left untouched; restore one begin and one end marker"
    return 0
  elif [ "$new" != "$(cat "$file")" ]; then
    printf '%s\n' "$new" >"$file"
    verb=updated
  fi
  if [ -z "$entries" ]; then
    [ -z "${verb:-}" ] ||
      echo "CODEOWNERS: $verb .github/CODEOWNERS, no protected zone owned; commit it (setup commits nothing)"
    return 0
  fi
  codeowners_owns=true
  [ -z "${verb:-}" ] ||
    echo "CODEOWNERS: $verb .github/CODEOWNERS, protected zones owned by @$2; commit it (setup commits nothing), the ruleset reads the default branch's copy"
  # Said on every run, a rerun that changes nothing included: until the default branch holds this very
  # file, GitHub reads no CODEOWNERS from it and the review requirement binds nothing.
  # Only a 404 says the default branch has none; any other error leaves the question open.
  if there=$(gh_retry api "repos/$4/contents/.github/CODEOWNERS" -H "Accept: application/vnd.github.raw" 2>&1); then
    [ "$there" != "$(cat "$file")" ] || return 0
    there="the default branch holds another copy"
  elif grep -q 'HTTP 404' <<<"$there"; then
    there="the default branch has none"
  else
    there="could not read .github/CODEOWNERS on the default branch: $there"
  fi
  echo "CODEOWNERS: code owner review enforces nothing until .github/CODEOWNERS is on the default branch ($there): commit it and merge it"
}

# Whether the senior-mode ruleset of the repository already requires code owner review: status 0 when
# it does, 1 when it is absent, does not, or the plan refuses rulesets (there is none), 2 when it could
# not be read (an error that says nothing of its content).
ruleset_review_on() { # slug
  local id cur
  id=$(gh_retry api "repos/$1/rulesets" \
    --jq '[.[] | select(.name == "senior-mode" and .source_type == "Repository")][0].id // empty' 2>&1) ||
    { ruleset_refused <<<"$id" && return 1 || return 2; }
  [ -n "$id" ] || return 1
  cur=$(gh_retry api "repos/$1/rulesets/$id" \
    --jq '[.rules[]? | select(.type == "pull_request") | .parameters.require_code_owner_review] | any' 2>&1) ||
    return 2
  [ "$cur" = true ]
}

# Why the ruleset requires code owner review, said in words, or nothing and status 1 when no reason holds.
# Setup never lowers a protection: the review stays required when the block owns a zone, when the
# CODEOWNERS file GitHub reads (.github/, then the root, then docs/; a shadow refusal and broken markers
# included) has an owner entry, or when the ruleset already requires it or cannot be read.
review_reason() { # root block-owns slug
  local f rc
  [ "$2" != true ] || { echo "the block owns the protected zones"; return 0; }
  for f in .github/CODEOWNERS CODEOWNERS docs/CODEOWNERS; do
    [ -e "$1/$f" ] || continue
    ! grep -qE '^[[:space:]]*[^#[:space:]][^[:space:]]*[[:space:]]+[^#[:space:]]' "$1/$f" ||
      { echo "$f, the CODEOWNERS file GitHub reads, has an owner entry"; return 0; }
    break
  done
  ruleset_review_on "$3" && rc=0 || rc=$?
  case $rc in
    0) echo "the ruleset already requires it"; return 0 ;;
    2) echo "the current ruleset could not be read, so it may require it"; return 0 ;;
  esac
  return 1
}

# Creates the senior-mode ruleset of the repository, or updates it; $2 is whether it requires code
# owner review (true when CODEOWNERS owns the protected zones).
setup_ruleset() {
  local id body cur
  body=$(jq -c --argjson r "$2" '(.rules[] | select(.type == "pull_request") | .parameters.require_code_owner_review) = $r' \
    <<<"$RULESET")
  id=$(gh_retry api "repos/$1/rulesets" \
    --jq '[.[] | select(.name == "senior-mode" and .source_type == "Repository")][0].id // empty') || return 1
  if [ -n "$id" ]; then
    # Required checks someone added by hand stay: ours are merged into them.
    cur=$(gh_retry api "repos/$1/rulesets/$id" \
      --jq '[.rules[]? | select(.type == "required_status_checks") | .parameters.required_status_checks[]?]') || return 1
    body=$(jq -c --argjson c "${cur:-[]}" '(.rules[] | select(.type == "required_status_checks") | .parameters.required_status_checks) |=
      (. as $ours | $ours + [$c[] | select(.context | IN($ours[].context) | not)])' <<<"$body")
    gh_retry api -X PUT "repos/$1/rulesets/$id" --input - <<<"$body"
  else
    gh_retry api -X POST "repos/$1/rulesets" --input - <<<"$body"
  fi
}

# True when gh's error (stderr, on stdin) is the plan refusing rulesets: HTTP 403 and GitHub's message
# "Upgrade to GitHub Pro or make this repository public to enable this feature." (a Free account or
# organization, private repository). Matches the status and a stable fragment, not the whole sentence.
ruleset_refused() {
  local err
  err=$(cat)
  grep -q 'HTTP 403' <<<"$err" && grep -qiE 'upgrade to github (pro|team)|make this repository public' <<<"$err"
}

# Sets github.protection (spec 0001 §13): ruleset, or none when the plan refuses it; none also forces
# ci.mode local, since the pre-push hook is then the only gate. Prints the plain-words warning.
setup_protection() { # config-file ruleset|none
  local was=""
  [ "$(jq -r '.ci.mode' "$1")" != actions ] || was=" (changed from actions)"
  if [ "$2" = none ]; then
    json_update "$1" '.github.protection = "none" | .ci.mode = "local"' || [ $? -eq 2 ] || die "could not write .claude/senior-mode.json"
    echo "protection: NOT enforced on the server. GitHub offers no rulesets or branch protection on a private repository of a Free account or organization, so anyone with push access can push to the default branch. ci.mode is local$was: the pre-push hook is the only gate."
    echo "protection: to enforce it, make the repository public, or upgrade to GitHub Pro or Team and run setup again; otherwise accept it and keep the local gate."
  else
    json_update "$1" '.github.protection = "ruleset"' || [ $? -eq 2 ] || die "could not write .claude/senior-mode.json"
  fi
}

# The GitHub side of a project (spec 0001 §11, #11), idempotent: Project linked to the repository with
# Status, Priority, Size and Severity; labels; rebase-only merges; a ruleset requiring the three statuses
# (ADR 0006, 0015); ids cached in the config.
# ci.mode local: the checks run before each push, so the repository's own workflows are disabled
# (files kept) and spend no Actions budget. GitHub's built-in ones (dynamic/: Dependabot, Pages)
# are left alone. ci.mode actions: our workflow is turned back on if an earlier local run disabled it.
setup_workflows() { # slug mode
  local list id wname path state disabled=""
  list=$(gh_retry workflow list --all --limit 1000 --repo "$1" --json id,name,path,state \
    --jq '.[] | select(.path | startswith(".github/workflows/")) | "\(.id)\t\(.path)\t\(.state)\t\(.name)"') ||
    die "cannot list the workflows of $1"
  while IFS=$'\t' read -r id path state wname; do
    [ -n "$id" ] || continue
    if [ "$2" = local ] && [ "$state" = active ]; then
      gh_retry workflow disable "$id" --repo "$1" >/dev/null || die "cannot disable workflow $wname"
      disabled+="${disabled:+, }$wname"
    elif [ "$2" = actions ] && [ "$path" = .github/workflows/senior-mode.yml ] && [ "$state" != active ]; then
      gh_retry workflow enable "$id" --repo "$1" >/dev/null || die "cannot enable workflow $wname"
      echo "workflows: $wname enabled again (ci.mode actions)"
    fi
  done <<<"$list"
  # Read only: the setting is the repository owner's call, and a token secret works around it.
  if [ "$2" = actions ] && [ "$(gh_retry api "repos/$1/actions/permissions/workflow" \
    --jq .can_approve_pull_request_reviews 2>/dev/null)" = false ] &&
    ! gh api "repos/$1/actions/secrets/RELEASE_PLEASE_TOKEN" >/dev/null 2>&1; then
    echo "releases: GitHub Actions may not open pull requests here, so the release job cannot open its PR; allow it in Settings > Actions > General, or store a token as the RELEASE_PLEASE_TOKEN secret"
  fi
  [ -z "$disabled" ] || echo "workflows: disabled $disabled (ci.mode local: checks run before each push; files kept; \`gh workflow enable <name>\` turns one back on, and senior-mode setup github --ci actions stops setup from disabling them again)"
}

# Switches on one GitHub security feature. A refusal (the plan, a token without the permission) is
# said, not fatal: the other features and the rest of setup go on.
security_feature() { # label gh-api-arguments...
  local label=$1 err
  shift
  if err=$(gh_retry api "$@" 2>&1 >/dev/null); then
    echo "security: $label: on"
  else
    err=$(head -n 1 <<<"${err#gh: }")
    echo "security: $label: not enabled ($err); the plan or the token refuses it, setup goes on"
  fi
}

# GitHub's own scanners (ADR 0015, #172, amended by #222): Dependabot alerts, secret scanning and push
# protection. Each may be refused by the plan. Dependabot security updates stay off and no
# dependabot.yml is written: GitHub has no severity filter for them, so alerts become issues only (#144
# path, high and critical). A dependabot.yml of the project's own is left as it is.
setup_security() { # root slug
  security_feature "Dependabot alerts" -X PUT "repos/$2/vulnerability-alerts"
  security_feature "secret scanning (with push protection)" -X PATCH "repos/$2" \
    -f "security_and_analysis[secret_scanning][status]=enabled" \
    -f "security_and_analysis[secret_scanning_push_protection][status]=enabled"
  [ ! -e "$1/.github/dependabot.yml" ] ||
    echo "dependabot.yml: untouched (senior-mode writes none; security updates are not turned on, alerts become issues)"
}

setup_github() {
  local root file slug owner name owner_type project number id fields labels label color description err ci="" globs review=false codeowner codeowners_owns=false reason
  case "$*" in "") ;; "--ci local" | "--ci actions") ci=$2 ;; *) usage ;; esac
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
  file=$root/.claude/senior-mode.json
  mkdir -p "$root/.claude"
  [ -f "$file" ] || echo '{}' >"$file"
  jq empty "$file" 2>/dev/null || die "invalid .claude/senior-mode.json; fix or remove it, then run setup again"
  if [ -n "$ci" ]; then
    { jq --arg m "$ci" '.ci.mode = $m' "$file" >"$file.tmp" && mv "$file.tmp" "$file"; } ||
      die "could not write .claude/senior-mode.json"
  fi
  slug=$(repo_slug) owner=${slug%%/*} name=${slug#*/}
  owner_type=$(gh_retry api "repos/$slug" --jq .owner.type) || die "cannot read $slug on GitHub"

  project=$(setup_project "$file" "$owner" "$name" "$slug") || die "could not find or create the Project"
  read -r number id <<<"$project"
  setup_fields "$id"
  fields=$(board_fields "$id") || die "could not read the fields of Project #$number"
  jq --arg o "$owner" --argjson n "$number" --arg id "$id" --argjson f "$fields" \
    '.project = {owner: $o, number: $n, id: $id, fields: ($f | map(select(.name | IN("Status", "Priority", "Size", "Severity"))
      | {key: .name, value: {id, options: (.options | map({key: .name, value: .id}) | from_entries)}}) | from_entries)}' \
    "$file" >"$file.tmp" || die "could not write .claude/senior-mode.json"
  mv "$file.tmp" "$file"
  echo "Project #$number $name: linked, fields Status, Priority, Size, Severity; ids cached in .claude/senior-mode.json"
  setup_board_workflows "$id"

  labels='needs-human|d93f0b|Waiting for a human decision or merge
needs-info|fbca04|Missing information before work can start
blocked|b60205|Blocked by something outside this ticket
security|ee0701|A security risk, with its Severity on the board'
  [ "$owner_type" = Organization ] || labels+='
type:feature|a2eeef|New capability for users
type:bug|d73a4a|Something does not work as specified
type:task|c5def5|Work that is neither a feature nor a bug
type:chore|ededed|Maintenance with no user-visible change'
  while IFS='|' read -r label color description; do
    gh_retry label create "$label" --repo "$slug" --color "$color" --description "$description" --force >/dev/null
  done <<<"$labels"
  echo "labels: $(cut -d'|' -f1 <<<"$labels" | paste -sd' ' -)"

  gh_retry repo edit "$slug" --enable-rebase-merge --enable-merge-commit=false --enable-squash-merge=false \
    --delete-branch-on-merge >/dev/null
  echo "merges: rebase only, branches deleted after merge"

  globs=$(jq -c '.protected // []' "$file")
  jq -e 'type == "array" and all(type == "string")' <<<"$globs" >/dev/null ||
    die "protected in .claude/senior-mode.json must be an array of globs"
  codeowner=""
  if [ "$globs" != "[]" ]; then
    # A user owns their repository; an organization is no CODEOWNERS owner, the signed-in user is.
    codeowner=$owner
    [ "$owner_type" != Organization ] || codeowner=$(gh_retry api user --jq .login) || die "cannot read your GitHub login"
  fi
  setup_codeowners "$root" "$codeowner" "$globs" "$slug"
  if [ "$globs" != "[]" ]; then
    if reason=$(review_reason "$root" "$codeowners_owns" "$slug"); then
      review=true
      [ "$codeowners_owns" = true ] ||
        echo "code owners: code owner review stays required: $reason; setup never lowers an existing protection, and .github/CODEOWNERS owns no protected zone"
    else
      echo "code owners: code owner review is not required, no CODEOWNERS entry owns anything and the ruleset did not require it (a rule requiring it would wait for an approval nobody can give)"
    fi
  fi

  # Before the workflows: a refused ruleset forces ci.mode local, which decides what happens to them.
  if err=$(setup_ruleset "$slug" "$review" 2>&1 >/dev/null); then
    setup_protection "$file" ruleset
    echo "default branch: ruleset senior-mode, pull requests only, rebase, senior-mode/ci, senior-mode/review and senior-mode/security on an up-to-date branch, linear history; admins may bypass with gh pr merge --admin; other protection untouched"
    [ "$review" = false ] || echo "code owners: a pull request touching a protected zone needs the owner's approval, and GitHub never lets an author approve their own pull request; agents act as the owner (#175 gives them an identity of their own), so merging one is the owner's call by hand, with gh pr merge --admin"
  elif ruleset_refused <<<"$err"; then
    setup_protection "$file" none
  else
    die "ruleset on the default branch: $err"
  fi

  setup_workflows "$slug" "$(jq -r '.ci.mode // "local"' "$file")"
  setup_security "$root" "$slug"
}

# Writes `jq <filter> <file>` back to the file only when the JSON changes, so a file without real
# change keeps its formatting. Extra arguments go to jq.
json_update() {
  local file=$1 filter=$2 new
  shift 2
  new=$(jq "$@" "$filter" "$file") || return 1
  [ "$(jq -S . <<<"$new")" = "$(jq -S . "$file")" ] && return 2
  printf '%s\n' "$new" >"$file"
}

# Copies a template where nothing exists yet; never replaces a file. Prints what it did.
place() { # template destination label
  if [ -e "$2" ]; then echo "$3: kept"; return; fi
  mkdir -p "$(dirname "$2")"
  cp "$1" "$2"
  echo "$3: created"
}

# Installs or refreshes one of our scripts in .githooks/ (marked "# senior-mode:" on its second
# line); a file of the project's own with that name is kept.
githooks_install() { # root source label
  local dest
  dest=$1/.githooks/$(basename "$2")
  if [ -e "$dest" ] && ! grep -q '^# senior-mode:' "$dest"; then
    echo "$3: yours kept"
  elif ! cmp -s "$2" "$dest" || [ ! -x "$dest" ]; then
    mkdir -p "$1/.githooks"
    cp "$2" "$dest"
    chmod +x "$dest"
    echo "$3: installed"
  fi
}

# Installs or refreshes the senior-mode git hooks; a hook of the project's own is kept.
setup_githooks() {
  local root=$1 tpl=$2 hook path
  for hook in commit-msg pre-push; do
    githooks_install "$root" "$tpl/githooks/$hook" "git hook $hook"
  done
  path=$(git -C "$root" config core.hooksPath || true)
  if [ -z "$path" ]; then
    git -C "$root" config core.hooksPath .githooks
  elif [ "$path" != .githooks ]; then
    echo "git hooks: core.hooksPath is $path; call .githooks/commit-msg and .githooks/pre-push from there"
  fi
}

# Adds the Principles block to CLAUDE.md, or refreshes it; a missing CLAUDE.md imports AGENTS.md when
# there is one, else starts from the skeleton that the setup skill fills from the code.
setup_claude_md() {
  local root=$1 tpl=$2 name=$3 claude=$1/CLAUDE.md block=$2/principles.md skeleton new lines
  if [ ! -e "$claude" ] && [ -f "$root/AGENTS.md" ]; then
    # The repository already has agent instructions (frameworks scaffold AGENTS.md): point to them.
    printf '# %s\n\n@AGENTS.md\n\n' "$name" >"$claude"
    cat "$block" >>"$claude"
    echo "CLAUDE.md: created, it imports the existing AGENTS.md, the skeleton is not needed"
  elif [ ! -e "$claude" ]; then
    skeleton=$(cat "$tpl/CLAUDE.md")
    # Split around the one placeholder: a pattern substitution would read & in the name (bash 5.2).
    { printf '%s\n\n' "${skeleton%%\{\{name\}\}*}$name${skeleton#*\{\{name\}\}}"; cat "$block"; } >"$claude"
    echo "CLAUDE.md: created from the skeleton; commands, code map and pitfalls to fill"
  elif ! grep -qE '^<!-- /?senior-mode:principles' "$claude"; then
    { echo; cat "$block"; } >>"$claude"
    echo "CLAUDE.md: Principles added, the rest kept"
  # One opening marker, then one closing marker, else awk refuses and the file is left alone.
  elif ! new=$(awk -v f="$block" '
      /^<!-- senior-mode:principles/ { if (seen++) bad = 1; while ((getline l < f) > 0) print l; close(f); skip = 1; next }
      /^<!-- \/senior-mode:principles -->/ { if (!skip) bad = 1; skip = 0; next }
      !skip { print } END { exit (bad || skip) }' "$claude"); then
    echo "CLAUDE.md: Principles markers broken, file left untouched; restore one opening and one closing marker"
  elif [ "$new" != "$(cat "$claude")" ]; then
    # Written in place, so a symlinked CLAUDE.md and its mode survive.
    printf '%s\n' "$new" >"$claude"
    echo "CLAUDE.md: Principles refreshed"
  fi
  lines=$(wc -l <"$claude")
  [ "$lines" -le 80 ] || echo "CLAUDE.md: $lines lines, over 80; trim it to what the code does not tell"
}

# Commands of a package.json project (spec 0001 §14, #13, #42): its scripts, run by the package
# manager of its lockfile; tsc --noEmit when a tsconfig has no typecheck script and typescript is a
# dependency (npx would otherwise fetch the unrelated "tsc" package), run without ever downloading;
# npm's placeholder test script is no test. Its install command is the lockfile's, frozen (npm install
# without one). Prints {commands, framework, typescript}.
# shellcheck disable=SC2016 # jq program, not shell
node_detect() {
  # exec runs an installed binary only: npx and bunx would download a missing one.
  local root=$1 pm=npm exec="npx --no --" install="npm install" tsconfig=false
  if [ -f "$root/pnpm-lock.yaml" ]; then pm=pnpm exec="pnpm exec" install="pnpm install --frozen-lockfile"
  elif [ -f "$root/yarn.lock" ]; then
    pm=yarn exec=yarn install="yarn install --frozen-lockfile"
    # Yarn 2 and later (a .yarnrc.yml) says --immutable.
    [ ! -f "$root/.yarnrc.yml" ] || install="yarn install --immutable"
  elif [ -f "$root/bun.lock" ] || [ -f "$root/bun.lockb" ]; then pm=bun exec="bun run" install="bun install --frozen-lockfile"
  elif [ -f "$root/package-lock.json" ]; then install="npm ci"
  fi
  [ ! -f "$root/tsconfig.json" ] || tsconfig=true
  jq -c --arg pm "$pm" --arg exec "$exec" --arg install "$install" --argjson tsconfig "$tsconfig" '(.scripts // {}) as $s
    | def run($n): if $s[$n] then "\($pm) run \($n)" else null end;
    ((.dependencies.typescript // .devDependencies.typescript) != null) as $ts
    # Next.js 15.5+ generates its route types only on build or dev: a fresh worktree needs
    # next typegen before typecheck (#112). A range without a version (latest, canary) is recent.
    | (.dependencies.next // .devDependencies.next) as $next
    | ($next != null and (($next | [scan("[0-9]+")]) as $n
        | if ($next | test("^[~^>=v ]*[0-9]")) then ($n[0] | tonumber) > 15
            or (($n[0] | tonumber) == 15 and (($n[1] // "0") | tonumber) >= 5)
          else true end)) as $typegen
    | {commands: ({
        lint: run("lint"),
        typecheck: ((run("typecheck") // run("type-check")
          // (if $tsconfig and $ts then "\($exec) tsc --noEmit" else null end))
          | if . and $typegen and (($s.typecheck // $s["type-check"] // "") | contains("typegen") | not)
            then "\($exec) next typegen && \(.)" else . end),
        test: (if ($s.test // "") | test("no test specified") then null else run("test") end),
        build: run("build"),
        e2e: (run("test:e2e") // run("e2e")),
        install: $install
      } | with_entries(select(.value != null))),
      framework: (if (.dependencies.next // .devDependencies.next) then "next" else null end),
      typescript: ($ts or $tsconfig)}' \
    "$root/package.json"
}

# The preset of a project that has no package.json and no stored preset (spec 0001 §14): the
# manifests that name one language first, then Python's files (a requirements.txt is common anywhere).
other_preset() {
  local root=$1 f
  [ ! -f "$root/go.mod" ] || { echo go; return; }
  [ ! -f "$root/Cargo.toml" ] || { echo rust; return; }
  for f in pyproject.toml setup.py requirements.txt; do
    [ ! -f "$root/$f" ] || { echo python; return; }
  done
  echo generic
}

# Whether a Python project uses a tool: a config file of its own, or its name as a word in the
# manifests (pytest-cov is not pytest).
py_uses() { # root tool [config-file...]
  local root=$1 tool=$2 f
  shift 2
  for f in "$@"; do [ ! -f "$root/$f" ] || return 0; done
  for f in "$root"/pyproject.toml "$root"/setup.cfg "$root"/setup.py "$root"/tox.ini "$root"/Pipfile "$root"/requirements*.txt; do
    if [ -f "$f" ] && grep -qiE "(^|[^A-Za-z0-9_-])$tool([^A-Za-z0-9_-]|\$)" "$f"; then return 0; fi
  done
  return 1
}

# Commands of a Python project (spec 0001 §14, #72): the tools it uses, run through uv or poetry
# when their lockfile exists. Ruff before flake8; black's format check before ruff's, as black is only
# named by projects that format with it; mypy before pyright; build when pyproject.toml has a
# build-system. Its install command is `uv sync` or `poetry install` with their lockfile, else none.
# Prints {commands}.
# shellcheck disable=SC2016 # jq program, not shell
python_detect() {
  local root=$1 run="" install="" lint="" format="" typecheck="" test="" build=""
  if [ -f "$root/uv.lock" ]; then run="uv run " install="uv sync"
  elif [ -f "$root/poetry.lock" ]; then run="poetry run " install="poetry install"
  fi
  if py_uses "$root" ruff ruff.toml .ruff.toml; then lint="${run}ruff check ."
  elif py_uses "$root" flake8 .flake8; then lint="${run}flake8"
  fi
  if py_uses "$root" black; then format="${run}black --check ."
  elif py_uses "$root" ruff ruff.toml .ruff.toml; then format="${run}ruff format --check ."
  fi
  if py_uses "$root" mypy mypy.ini .mypy.ini; then typecheck="${run}mypy ."
  elif py_uses "$root" pyright pyrightconfig.json; then typecheck="${run}pyright"
  fi
  ! py_uses "$root" pytest pytest.ini conftest.py || test="${run}pytest"
  ! grep -qs '^\[build-system\]' "$root/pyproject.toml" || build="${run}python -m build"
  jq -nc --arg lint "$lint" --arg format "$format" --arg typecheck "$typecheck" --arg test "$test" \
    --arg build "$build" --arg install "$install" '{commands: ({lint: $lint, format: $format, typecheck: $typecheck,
      test: $test, build: $build, install: $install} | with_entries(select(.value != "")))}'
}

# Commands of a Go module (spec 0001 §14, #72): vet, joined by golangci-lint when its config exists,
# then test and build over every package; its install command downloads the modules. Prints {commands}.
go_detect() {
  local root=$1 lint="go vet ./..." f
  for f in "$root"/.golangci.yml "$root"/.golangci.yaml "$root"/.golangci.toml "$root"/.golangci.json; do
    [ ! -f "$f" ] || lint="go vet ./... && golangci-lint run"
  done
  jq -nc --arg lint "$lint" '{commands: {lint: $lint, test: "go test ./...", build: "go build ./...",
    install: "go mod download"}}'
}

# Commands of a Cargo project (spec 0001 §14, #72): clippy denying warnings, rustfmt in check mode,
# test and build; its install command fetches the crates. Prints {commands}.
rust_detect() {
  jq -nc '{commands: {lint: "cargo clippy --all-targets -- -D warnings", format: "cargo fmt --check",
    test: "cargo test", build: "cargo build", install: "cargo fetch"}}'
}

# The preset of a project: the stored one (typescript, its former name, is node), else node when a
# package.json exists, else the one of its manifest (go, rust, python), else generic.
project_preset() {
  local root=$1 pname=""
  [ ! -f "$root/.claude/senior-mode.json" ] || pname=$(jq -r '.preset // empty' "$root/.claude/senior-mode.json" 2>/dev/null) || true
  [ "$pname" != typescript ] || pname=node
  if [ -n "$pname" ]; then :
  elif [ -f "$root/package.json" ]; then pname=node
  else pname=$(other_preset "$root")
  fi
  printf '%s\n' "$pname"
}

# What the preset $2 detects in the project at $1, as JSON ({} for a preset that detects nothing).
preset_detect() {
  case $2 in
    node) node_detect "$1" ;;
    python) python_detect "$1" ;;
    go) go_detect "$1" ;;
    rust) rust_detect ;;
    *) echo '{}' ;;
  esac
}

# The command that installs the dependencies of the project at $1 (#110): `commands.install` of its
# config, else the one its preset detects; empty when it has none.
install_command() {
  local root=$1 cmd=""
  [ ! -f "$root/.claude/senior-mode.json" ] || cmd=$(jq -r '.commands.install // empty' "$root/.claude/senior-mode.json" 2>/dev/null) || true
  [ -n "$cmd" ] || cmd=$(preset_detect "$root" "$(project_preset "$root")" 2>/dev/null | jq -r '.commands.install // empty') || true
  printf '%s\n' "$cmd"
}

# Whether the node project at $1 declares dependencies and has no node_modules (nor Yarn's Plug'n'Play).
deps_missing() {
  [ "$(project_preset "$1")" = node ] && [ -f "$1/package.json" ] && [ ! -d "$1/node_modules" ] && [ ! -e "$1/.pnp.cjs" ] &&
    jq -e '((.dependencies // {}) + (.devDependencies // {}) | length) > 0' "$1/package.json" >/dev/null 2>&1
}

# The static x.y.z version of a TOML table (the first of the tables given that has one), or 0.0.0.
toml_version() {
  local v
  v=$(awk -v tables="$2 ${3:-}" 'BEGIN { n = split(tables, t, " ") }
    /^\[/ { s = $0; sub(/[ \t]*#.*/, "", s); gsub(/[][ \t]/, "", s); on = 0; for (i = 1; i <= n; i++) if (s == t[i]) on = 1; next }
    on && /^version[ \t]*=[ \t]*"/ { match($0, /"[^"]*"/); print substr($0, RSTART + 1, RLENGTH - 2); exit }' "$1")
  [[ $v =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] && printf '%s\n' "$v" || printf '0.0.0\n'
}

# The documents and checks of a project (spec 0001 §12, §14, #12), idempotent; whatever the project
# already has is extended, never replaced. The preset is the stored one (typescript, its former name,
# becomes node), else node when a package.json exists, else the one of its manifest (go, rust, python),
# else generic. `--command <name>=<command>` stores a command of the preset (lint, format, typecheck,
# test, build; e2e for node) and derives its check; `--command install=<command>` stores the command that
# installs the dependencies of a new worktree, which has no check.
# shellcheck disable=SC2016 # jq programs, not shell
setup_repo() {
  local root file tpl pname preset lang name commands='{}' detected out ours guard
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
  file=$root/.claude/senior-mode.json
  tpl=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
  # A preset stored earlier wins over detection.
  pname=$(project_preset "$root")
  preset=$tpl/presets/$pname/preset.json
  [ -f "$preset" ] || die "unknown preset $pname in .claude/senior-mode.json"
  detected=$(preset_detect "$root" "$pname") || die "could not read package.json"
  tpl=$tpl/templates
  while [ $# -gt 0 ]; do
    [ "$1" = --command ] && [[ ${2:-} == ?*=?* ]] || usage
    jq -e --arg k "${2%%=*}" '.commands + ["install"] | index($k)' "$preset" >/dev/null ||
      die "unknown command ${2%%=*}; expected one of $(jq -r '.commands + ["install"] | join(", ")' "$preset")"
    commands=$(jq -c --arg k "${2%%=*}" --arg v "${2#*=}" '.[$k] = $v' <<<"$commands")
    shift 2
  done
  mkdir -p "$root/.claude"
  [ -f "$file" ] || echo '{}' >"$file"
  jq empty "$file" 2>/dev/null || die "invalid .claude/senior-mode.json; fix or remove it, then run setup again"
  lang=$(jq -r '.language // "en"' "$file")
  [ -d "$tpl/$lang" ] || lang=en
  name=$(basename "$root")

  setup_githooks "$root" "$tpl"
  # The environment guard: only when envGuard.forbidden lists something. The check stays when the
  # key is removed later, and then reports itself skipped.
  guard=false
  jq -e '(.envGuard.forbidden // []) | type == "array" and all(type == "string")' "$file" >/dev/null ||
    die "envGuard.forbidden in .claude/senior-mode.json must be a list of strings"
  if jq -e '(.envGuard.forbidden // []) | length > 0' "$file" >/dev/null; then
    guard=true
    githooks_install "$root" "$tpl/githooks/env-guard.sh" "check script env-guard.sh"
  fi
  # The commit subjects check runs our commit-msg hook; a project's own hook may not understand it.
  ours=false
  ! grep -q '^# senior-mode:' "$root/.githooks/commit-msg" 2>/dev/null || ours=true
  out=0
  json_update "$file" '.preset = $pn | .commands = ($d.commands // {}) + (.commands // {}) + $c
    | if $d.framework then .framework = $d.framework else . end | .commands as $all
    | ($p[0].commands | map(select($all[.] != null) | {name: ., run: $all[.]})) as $derived
    | ($derived + (if $ours then $p[0].checks else [] end)
        + (if $guard then [{name: "env guard", run: ".githooks/env-guard.sh"}] else [] end)) as $want
    | .checks = ((.checks // []) as $have
      | [$have[] | if $c[.name] then .run = $c[.name] else . end]
        + [$want[] | select(.name as $n | $have | any(.name == $n) | not)])
    | if has("protected") then .
      else (($p[0].protected // []) + ($p[0].frameworks[.framework // ""].protected // [])) as $g
        | if ($g | length) > 0 then .protected = $g else . end end' \
    --argjson c "$commands" --argjson ours "$ours" --argjson guard "$guard" --slurpfile p "$preset" --arg pn "$pname" \
    --argjson d "$detected" || out=$?
  [ "$out" -ne 1 ] || die "could not write .claude/senior-mode.json"
  echo "preset: $pname$(jq -r --argjson d "$detected" '[if $d.typescript == true then "TypeScript"
    elif $d.typescript == false then "JavaScript" else empty end, .framework // empty]
    | select(length > 0) | " (\(join(", ")))"' "$file")"
  echo "checks: $(jq -r '[.checks[].name] | join(", ")' "$file")"
  # On a first setup `setup github` ran before `protected` existed: no block was written yet.
  ! jq -e '(.protected // []) | length > 0' "$file" >/dev/null || grep -qs '^# senior-mode:begin' "$root/.github/CODEOWNERS" ||
    echo "CODEOWNERS: the protected zones are not owned yet; rerun senior-mode setup github to write .github/CODEOWNERS"
  [ "$pname" != node ] || jq -r --argjson d "$detected" '["lint", "typecheck", "test", "build"] - (.commands | keys)
    - (if $d.typescript then [] else ["typecheck"] end)
    | select(length > 0) | "missing: \(join(", ")) (no script; propose tools, never install without a yes)"' "$file"

  setup_claude_md "$root" "$tpl/$lang" "$name"
  if [ -n "$(find "$root" "$root/.github" "$root/docs" -maxdepth 1 -iname 'pull_request_template*' 2>/dev/null)" ]; then
    echo "pull request template: kept"
  else
    place "$tpl/$lang/pull_request_template.md" "$root/.github/pull_request_template.md" "pull request template"
  fi
  place "$tpl/$lang/ISSUE_TEMPLATE/feature.yml" "$root/.github/ISSUE_TEMPLATE/feature.yml" "issue form feature"
  place "$tpl/$lang/ISSUE_TEMPLATE/bug.yml" "$root/.github/ISSUE_TEMPLATE/bug.yml" "issue form bug"
  # The system overview the docs skill keeps current (spec 0001 §8); never overwritten.
  place "$tpl/$lang/architecture.md" "$root/docs/architecture.md" "docs/architecture.md"
  # Other workflows are left as they are; local mode disables them on GitHub (setup github).
  [ "$(jq -r '.ci.mode // "local"' "$file")" != actions ] ||
    place "$tpl/workflows/senior-mode.yml" "$root/.github/workflows/senior-mode.yml" "workflow senior-mode.yml"

  [ -f "$root/.claude/settings.json" ] || echo '{}' >"$root/.claude/settings.json"
  out=0
  json_update "$root/.claude/settings.json" 'def add($xs): reduce $xs[] as $x (. // []; if index([$x]) then . else . + [$x] end);
    .permissions.allow |= add($s[0].permissions.allow) | .permissions.deny |= add($s[0].permissions.deny)' \
    --slurpfile s "$tpl/settings.json" || out=$?
  [ "$out" -ne 1 ] || die "could not update .claude/settings.json"
  [ "$out" -ne 0 ] || echo "settings: senior-mode permissions added to .claude/settings.json"

  if [ ! -e "$root/release-please-config.json" ]; then
    # Without a previous release, release-please would start at 1.0.0: a new project starts at 0.1.0.
    # A package.json version counts as the last release, so the manifest holds it and the next
    # release bumps it (initial-version would publish it again).
    local last=0.0.0 from=package.json
    if [ -f "$root/package.json" ]; then
      last=$(jq -r '.version // "0.0.0"' "$root/package.json" 2>/dev/null) || last=0.0.0
    elif [ -f "$root/Cargo.toml" ]; then
      from=Cargo.toml
      last=$(toml_version "$root/Cargo.toml" package)
    elif [ -f "$root/pyproject.toml" ]; then
      from=pyproject.toml
      last=$(toml_version "$root/pyproject.toml" project tool.poetry)
    fi
    if [ "$pname" = go ] && [ "$last" = 0.0.0 ]; then
      from="git tag"
      last=$(git -C "$root" tag --list 'v[0-9]*.[0-9]*.[0-9]*' --sort=-v:refname 2>/dev/null |
        grep -E -m1 '^v[0-9]+\.[0-9]+\.[0-9]+$' | sed 's/^v//') || true
      last=${last:-0.0.0}
    fi
    jq --arg n "$name" '.release | .packages["."] += {component: $n, "initial-version": "0.1.0"}' \
      "$preset" >"$root/release-please-config.json"
    if [ ! -e "$root/.release-please-manifest.json" ]; then
      jq -n --arg v "$last" '{".": $v}' >"$root/.release-please-manifest.json"
      if [ "$last" != 0.0.0 ] && [ -z "$(git -C "$root" tag --list)" ]; then
        echo "releases: first release follows $last ($from)$([ "$last" != 1.0.0 ] ||
          echo '; to start at 0.1.0, set "." to "0.0.0" in .release-please-manifest.json')"
      fi
    fi
    echo "releases: release-please configured"
  fi
  echo "secrets: keep only dev-only secrets on a machine where agents run; the secrets guard stops honest mistakes, not a determined reader"
}

# What a session needs at start (SessionStart hook, spec 0001 §15): a short router and, on a ticket
# branch <type>/<issue>-<slug>, the ticket, its Status, its spec and acceptance criteria. Never fails.
context() {
  local root branch issue json spec status criteria
  cat <<'ROUTER'
senior-mode is active: framing, specs and ADRs, test-driven delivery, atomic Conventional Commits, GitHub Project board.
Commands are /senior-mode:<name>; "go" or "enchaîne" takes the next Ready ticket. Disciplines load by themselves; ask the scout agent for codebase facts.
ROUTER
  # Spec 0001 §10, "Sessions without a human": the one rule, stated where a run session starts.
  [ -z "${SENIOR_MODE_RUN:-}" ] || echo "Unattended run: nobody answers questions. Take the recommended option for reversible choices; never accept an L spec or an ADR, never touch a protected zone: label needs-human and stop with a report."
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  if [ ! -f "$root/.claude/senior-mode.json" ]; then
    echo "This repository is not set up for senior-mode; /senior-mode:setup adopts it."
    return 0
  fi
  branch=$(git symbolic-ref --short -q HEAD) || return 0
  issue=$(sed -nE 's#^[a-z]+/([0-9]+)-.*#\1#p' <<<"$branch")
  [ -n "$issue" ] || return 0
  echo
  if ! json=$(gh issue view "$issue" --json number,title,state,body,projectItems 2>/dev/null); then
    echo "Current ticket: #$issue, branch $branch; details not loaded (GitHub unreachable)."
    return 0
  fi
  jq -r --arg b "$branch" '"Current ticket: #\(.number) \(.title) (\(.state | ascii_downcase), Status: \(.projectItems[0].status.name // "not on the board")), branch \($b)"' <<<"$json"
  spec=$(jq -r .body <<<"$json" | grep -oE 'docs/specs/[A-Za-z0-9._-]+\.md' | head -1) || true
  if [ -n "$spec" ]; then
    status=$(sed -nE 's/^status: *//p' "$root/$spec" 2>/dev/null | head -1) || true
    echo "Spec: $spec (${status:-file not found})"
  fi
  criteria=$(jq -r .body <<<"$json" | awk '/^## / { on = /Acceptance criteria/; next } on && /^- /' |
    head -6 | cut -c1-200)
  [ -z "$criteria" ] || printf 'Acceptance criteria:\n%s\n' "$criteria"
}

# The default branch to compare with: origin's HEAD, else the usual names, remote first.
default_branch() {
  local ref b
  if ref=$(git symbolic-ref --short -q refs/remotes/origin/HEAD); then
    printf '%s\n' "$ref"
    return 0
  fi
  for b in origin/main origin/master main master; do
    if git rev-parse -q --verify "$b^{commit}" >/dev/null; then
      printf '%s\n' "$b"
      return 0
    fi
  done
  return 1
}

# Files changed on this branch since it left the base (default: the default branch) that match a
# glob of `protected` in the config (spec 0001 §10). Prints them; exit 1 when there is none.
# A glob without a slash matches a name at any depth; with a slash it is anchored at the repository
# root: `*` stays in one path segment, `**/` spans any number of directories, `?` is one character.
# shellcheck disable=SC2016 # a jq program, not shell
protected() {
  local base="" file globs files matches
  while [ $# -gt 0 ]; do
    [ "$1" = --base ] && [ $# -ge 2 ] || usage
    base=$2
    shift 2
  done
  file=$(config_file)
  globs=$(jq -c '.protected // []' "$file")
  jq -e 'type == "array" and all(type == "string")' <<<"$globs" >/dev/null ||
    die "protected in .claude/senior-mode.json must be an array of globs"
  [ "$globs" != "[]" ] || return 1
  [ -n "$base" ] || base=$(default_branch) || die "no default branch found; pass --base <ref>"
  git rev-parse -q --verify "$base^{commit}" >/dev/null || die "unknown ref: $base"
  # --no-renames: a file moved out of a protected zone is listed under its old path too.
  files=$(git -c core.quotePath=false diff --name-only --no-renames "$base...HEAD") ||
    die "cannot compare with $base"
  matches=$(protected_match "$globs" <<<"$files")
  [ -n "$matches" ] || return 1
  printf '%s\n' "$matches"
}

# The file names on stdin that match a glob of the JSON list $1, as `protected` reads them.
# shellcheck disable=SC2016 # a jq program, not shell
protected_match() {
  jq -Rrn --argjson g "$1" '
    def re:
      (if startswith("/") then .[1:] elif contains("/") then . else "**/" + . end) as $g
      | "^" + ([$g | match("\\*\\*/|\\*\\*|\\*|\\?|[^*?]+"; "g").string
          | if . == "**/" then "(.*/)?" elif . == "**" then ".*" elif . == "*" then "[^/]*" elif . == "?" then "[^/]"
            else gsub("(?<c>[.+^$(){}|\\[\\]\\\\])"; "\\" + .c) end] | join("")) + "$";
    ($g | map(re)) as $res
    | inputs | select(. as $f | any($res[]; . as $r | $f | test($r)))'
}

# The Project items, and with $1 = true the repository facts that `status` adds, in one GraphQL
# query (spec 0001 §7, §15); only a Project of more than 100 items takes a second call.
# shellcheck disable=SC2016 # a GraphQL query, not shell
BOARD_QUERY='query($project: ID!, $owner: String!, $name: String!, $after: String, $repo: Boolean!) {
  node(id: $project) { ... on ProjectV2 { items(first: 100, after: $after) {
    pageInfo { hasNextPage endCursor }
    nodes {
      fieldValues(first: 20) { nodes { ... on ProjectV2ItemFieldSingleSelectValue { name field { ... on ProjectV2FieldCommon { name } } } } }
      content { ... on Issue { number title url state closedAt labels(first: 20) { nodes { name } }
        milestone { title dueOn } blockedBy(first: 20) { nodes { number state } } } } } } } }
  repository(owner: $owner, name: $name) @include(if: $repo) {
    latestRelease { tagName publishedAt }
    branches: refs(refPrefix: "refs/heads/", first: 100) { nodes { name } }
    pullRequests(states: OPEN, first: 50) { nodes { number title url isDraft headRefName labels(first: 10) { nodes { name } }
      commits(last: 1) { nodes { commit { statusCheckRollup { state contexts(first: 30) { nodes { __typename
        ... on StatusContext { context state } ... on CheckRun { name conclusion } } } } } } } } }
    closed: issues(states: CLOSED, first: 50, orderBy: {field: UPDATED_AT, direction: DESC}) { nodes { number title closedAt stateReason } }
    merged: pullRequests(states: MERGED, first: 50, orderBy: {field: UPDATED_AT, direction: DESC}) { nodes { number title mergedAt } }
  }
}'

# Prints {items, prs, closed, merged, release}: tickets with their board fields, labels, milestone and
# open blockers; open pull requests with their failing statuses; recent closed issues and merged pull
# requests; the latest release. The last four are empty unless $1 is true.
# shellcheck disable=SC2016 # a jq program, not shell
board_data() {
  local with_repo=${1:-false} file project slug after="" page pages="[]" more=true count=0 err
  file=$(config_file)
  project=$(jq -r '.project.id // empty' "$file")
  [ -n "$project" ] || die "no Project in .claude/senior-mode.json; run /senior-mode:setup"
  slug=$(repo_slug)
  while [ "$more" = true ]; do
    page=$(jq -nc --arg q "$BOARD_QUERY" --arg p "$project" --arg o "${slug%%/*}" --arg n "${slug#*/}" \
      --arg a "$after" --argjson r "$with_repo" '{query: $q, variables: ({project: $p, owner: $o, name: $n, repo: $r}
      + (if $a == "" then {} else {after: $a} end))}' | gh_retry api graphql --input -) ||
      die "cannot read the Project from GitHub"
    err=$(jq -r '.errors[0].message // empty' <<<"$page" 2>/dev/null) || die "GitHub answered something that is not JSON"
    [ -z "$err" ] || die "GitHub refused the Project query: $err"
    pages=$(jq -c --argjson p "$page" '. + [$p]' <<<"$pages")
    more=$(jq -r '.data.node.items.pageInfo.hasNextPage // false' <<<"$page")
    after=$(jq -r '.data.node.items.pageInfo.endCursor // empty' <<<"$page")
    with_repo=false
    count=$((count + 1))
    [ "$count" -lt 20 ] || break
  done
  jq -c 'def single($f): [.fieldValues.nodes[] | select(.field.name == $f) | .name][0];
    def failing: [.commits.nodes[0].commit.statusCheckRollup.contexts.nodes[]?
      | select((.state // "") | IN("FAILURE", "ERROR")) // select((.conclusion // "") | IN("FAILURE", "TIMED_OUT", "CANCELLED", "STARTUP_FAILURE"))
      | .context // .name];
    (.[0].data.repository // {}) as $r
    | {items: [.[].data.node.items.nodes[] | select(.content.number != null) | .content as $c
        | {number: $c.number, title: $c.title, url: $c.url, open: ($c.state == "OPEN"),
           status: single("Status"), priority: single("Priority"), size: single("Size"), severity: single("Severity"),
           labels: [$c.labels.nodes[].name], milestone: $c.milestone.title, due: $c.milestone.dueOn,
           blockers: [$c.blockedBy.nodes[] | select(.state == "OPEN") | .number]}],
       prs: [$r.pullRequests.nodes[]? | {number, title, url, branch: .headRefName, labels: [.labels.nodes[].name], failing: failing}],
       branches: [$r.branches.nodes[]?.name],
       closed: [$r.closed.nodes[]? | {number, title, closedAt, reason: .stateReason}],
       merged: [$r.merged.nodes[]? | {number, title, mergedAt}],
       release: ($r.latestRelease | if . then {tag: .tagName, date: .publishedAt} else null end)}' <<<"$pages"
}

# The tickets `run` and `next` take (spec 0001 §7): Ready, open, not size L, not blocked (open
# "blocked by" link, `blocked` label), not waiting for information (`needs-info`). Sorted by Priority
# (P0 first), a critical Severity ahead of the others, then milestone due date, then number.
# shellcheck disable=SC2016 # a jq program, not shell
PICK_DEF='def pick: [.items[] | select(.open and .status == "Ready" and .size != "L" and (.blockers | length == 0)
    and ((.labels | index("blocked")) | not) and ((.labels | index("needs-info")) | not))]
  | sort_by([([(.priority // "") | scan("^P([0-9]+)") | .[0] | tonumber] | first // 99),
    (if .severity == "critical" then 0 else 1 end), (.due // "9999"), .number]);'

# senior-mode pick [--json] [--max N]
pick() {
  local json=false max="" data
  while [ $# -gt 0 ]; do
    case $1 in
      --json) json=true ;;
      --max)
        [[ ${2:-} =~ ^[1-9][0-9]*$ ]] || die "pick --max needs a positive number"
        max=$2
        shift
        ;;
      *) usage ;;
    esac
    shift
  done
  data=$(board_data false) || exit 1
  if [ "$json" = true ]; then
    jq -c --argjson max "${max:-0}" "$PICK_DEF"'pick | if $max > 0 then .[:$max] else . end
      | map({number, title, url, priority, size, milestone, due})' <<<"$data"
  else
    jq -r --argjson max "${max:-0}" "$PICK_DEF"'pick | if $max > 0 then .[:$max] else . end
      | if length == 0 then "No Ready ticket to pick." else .[] | "#\(.number) \(.priority // "no priority") · \(.size // "?") · \(.title)"
        + (if .milestone then " (\(.milestone))" else "" end) end' <<<"$data"
  fi
}

# Lowercase ASCII words of a title joined by dashes, at most 40 characters cut at a word; a leading
# `type(scope): ` of a Conventional Commit title is dropped. Accents are transliterated with iconv when
# it can (under a UTF-8 locale, else it writes `?`), and any non-ASCII byte left is dropped, so a branch
# name is portable whatever the locale (#111).
slugify() {
  local full s
  full=$(LC_ALL=C.UTF-8 iconv -f UTF-8 -t ASCII//TRANSLIT <<<"$1" 2>/dev/null) || full=$1
  full=$(printf '%s' "$full" | LC_ALL=C tr -cd '\000-\177' | LC_ALL=C tr '[:upper:]' '[:lower:]' |
    LC_ALL=C sed -E 's/^[a-z]+(\([^)]*\))?!?: //; s/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
  s=${full:0:40}
  [ ${#full} -le 40 ] || [ "${full:40:1}" = - ] || s=${s%-*}
  printf '%s\n' "${s%-}"
}

# The ref a new branch starts from: origin's default branch, else a local main or master.
start_base() {
  local main=$1 base
  base=$(git -C "$main" symbolic-ref -q --short refs/remotes/origin/HEAD) ||
    base=$(git -C "$main" for-each-ref --format='%(refname:short)' refs/remotes/origin/main refs/remotes/origin/master | head -1)
  [ -n "$base" ] || base=$(git -C "$main" for-each-ref --format='%(refname:short)' refs/heads/main refs/heads/master | head -1)
  [ -n "$base" ] || return 1
  printf '%s\n' "$base"
}

# Every worktree senior-mode makes (a ticket, a framing, the docs session of a run) is
# `${XDG_DATA_HOME:-~/.local/share}/senior-mode/worktrees/<repo>/<name>` (#224): never a sibling of the
# repository, and not under its .git, where Claude Code refuses edits as sensitive files. $1 is the main
# worktree of the repository, $2 the name (`<issue>`, `frame-<slug>`, `run-docs-<stamp>`). <repo> is its
# basename and 8 hex digits of the checksum of its absolute path, so two clones never collide. The same
# path from any worktree. Older worktrees (beside the repository, or under .git/senior-mode/worktrees)
# stay where they are; `branch_worktree` finds them by their branch.
worktree_path() {
  printf '%s/senior-mode/worktrees/%s-%08x/%s\n' "${XDG_DATA_HOME:-$HOME/.local/share}" "$(basename "$1")" \
    "$(printf '%s' "$1" | cksum | cut -d' ' -f1)" "$2"
}

# The path of the worktree of repository $1 that has branch $2 checked out; nothing when there is none.
branch_worktree() {
  git -C "$1" worktree list --porcelain | awk -v b="refs/heads/$2" '$1 == "worktree" {p = substr($0, 10)} $1 == "branch" && $2 == b {print p}'
}

# The worktrees of the tickets in the repository of $1, as `<issue> <path>` lines, wherever they are: any
# worktree on a branch `<type>/<issue>-<slug>` with a type `start` makes (feat, fix, chore).
ticket_worktrees() {
  git -C "$1" worktree list --porcelain | awk '$1 == "worktree" {p = substr($0, 10)}
    $1 == "branch" && match($2, /^refs\/heads\/(feat|fix|chore)\/[0-9]+(-|$)/) {
      n = substr($2, 12); sub(/^[a-z]+\//, "", n); sub(/[^0-9].*/, "", n); print n, p}'
}

# senior-mode frame start <idea>: the worktree `frame-<slug>` and the branch `docs/<slug>` of a
# framing (spec 0001 §8), from origin's default branch, so parallel framings never share a working tree
# or branch. Refuses when the local default branch holds commits origin lacks: they would ride along in
# the framing's pull request.
frame_start() {
  local name common main base branch path local_branch ahead
  name=$(slugify "${1:-}")
  [ -n "$name" ] || usage
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "not inside a git repository"
  main=${common%/.git}
  git -C "$main" fetch -q origin 2>/dev/null || die "cannot fetch origin"
  base=$(start_base "$main") || die "no default branch to frame from"
  local_branch=${base#origin/}
  if git -C "$main" show-ref -q --verify "refs/heads/$local_branch"; then
    ahead=$(git -C "$main" rev-list --count "$base..$local_branch")
    [ "$ahead" -eq 0 ] ||
      die "$local_branch is ahead of $base by $ahead commit(s) (unpushed, such as a setup commit): push or open a pull request for them first, then frame again"
  fi
  branch=docs/$name
  path=$(branch_worktree "$main" "$branch")
  if [ -z "$path" ]; then
    path=$(worktree_path "$main" "frame-$name")
    [ ! -e "$path" ] || die "$path exists and is not the worktree of $branch"
    if git -C "$main" show-ref -q --verify "refs/heads/$branch"; then
      git -C "$main" worktree add -q "$path" "$branch" >/dev/null || die "cannot create the worktree"
    else
      git -C "$main" worktree add -q --no-track -b "$branch" "$path" "$base" >/dev/null || die "cannot create the worktree"
    fi
  fi
  echo "branch $branch"
  echo "worktree $path"
}

# Whether `start` is called by a live `run` (#145): `run` keeps a random token in the shell variable
# RUN_TOKEN, which is never exported (and cleared at startup, so a variable set by hand does not survive),
# and writes the same token to a 0600 file of its own, whose path it gives `start` in
# SENIOR_MODE_RUN_TOKEN_FILE. Both must agree. SENIOR_MODE_RUN=1 alone proves nothing: it only tells the
# guard hooks that the session is unattended. The aim is to stop an accidental or hand-set bypass; a
# process of the same user can still read the file, but cannot start a `start` that holds the token.
run_token_ok() {
  local f=${SENIOR_MODE_RUN_TOKEN_FILE:-}
  [ -n "${RUN_TOKEN:-}" ] && [ -n "$f" ] && [ -f "$f" ] && [ ! -L "$f" ] || return 1
  [ "$(file_owner "$f")" = "$(id -u)" ] && [ "$(file_mode "$f")" = 600 ] || return 1
  [ "$(cat "$f" 2>/dev/null)" = "$RUN_TOKEN" ]
}

# Refuses to start <issue> when the open tickets In progress, other than it, already reach `wip`.
# A run is bounded by autonomy.parallel instead, so `start` skips this when run_token_ok.
wip_check() {
  local limit data others
  limit=$(config_get wip)
  [[ $limit =~ ^[1-9][0-9]*$ ]] || die "wip must be a positive whole number, not $limit"
  data=$(board_data false)
  others=$(jq -r --argjson n "$1" --argjson w "$limit" '[.items[] | select(.open and .status == "In progress"
    and .number != $n) | "#\(.number) \(.title)"] | select(length >= $w) | join(", ")' <<<"$data")
  [ -z "$others" ] ||
    die "work in progress is at its limit (wip $limit): $others. Finish it first (merge, or set it back to Ready), or raise wip in .claude/senior-mode.json"
}

# senior-mode start <issue>: the worktree and the branch `<type>/<issue>-<slug>` of a ticket, then Status
# In progress. Shared by `next` and `run`. The branch type follows the `type:` label (feature: feat, bug:
# fix, task and chore: chore; feat without a label). The branch starts from the default branch, fetched
# first when origin answers; the worktree is `<data dir>/senior-mode/worktrees/<repo>/<issue>` (#224, see `worktree_path`).
# Rerunning reuses the branch and the worktree, wherever an earlier start put it. A new worktree gets its dependencies (a node one that
# lost them too), installed with the project's install command (#110); a failed install only warns, and
# `check` says what is missing. Prints `branch <name>` and `worktree <path>`.
start() {
  [ $# -eq 1 ] && [[ $1 =~ ^[1-9][0-9]*$ ]] || usage
  local issue=$1 slug info state title labels type common main name base branch path existing created=false cmd
  slug=$(repo_slug)
  info=$(gh_retry issue view "$issue" --repo "$slug" --json title,labels,state) || die "cannot read issue #$issue"
  state=$(jq -r '.state' <<<"$info")
  [ "$state" = OPEN ] || die "issue #$issue is ${state,,}"
  run_token_ok || wip_check "$issue"
  title=$(jq -r '.title' <<<"$info")
  labels=$(jq -r '.labels[].name' <<<"$info")
  case $(sed -n 's/^type://p' <<<"$labels" | head -1) in
    bug) type=fix ;;
    task | chore) type=chore ;;
    *) type=feat ;;
  esac
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "not inside a git repository"
  main=${common%/.git}
  name=$(slugify "$title")
  # The branch of an earlier start wins, whatever its slug.
  branch=$(git -C "$main" for-each-ref --format='%(refname:short)' "refs/heads/$type/$issue-*" | head -1)
  branch=${branch:-$type/$issue${name:+-$name}}
  existing=$(branch_worktree "$main" "$branch")
  if [ -n "$existing" ]; then
    path=$existing
  else
    created=true
    path=$(worktree_path "$main" "$issue")
    [ ! -e "$path" ] || die "$path exists and is not the worktree of $branch"
    if ! git -C "$main" show-ref -q --verify "refs/heads/$branch"; then
      git -C "$main" fetch -q origin 2>/dev/null || true
      base=$(start_base "$main") || die "no default branch to start $branch from"
      git -C "$main" worktree add -q --no-track -b "$branch" "$path" "$base" >/dev/null || die "cannot create the worktree"
    else
      git -C "$main" worktree add -q "$path" "$branch" >/dev/null || die "cannot create the worktree"
    fi
  fi
  echo "branch $branch"
  echo "worktree $path"
  if [ "$created" = true ] || deps_missing "$path"; then
    cmd=$(install_command "$path")
    if [ -n "$cmd" ]; then
      echo "senior-mode: installing dependencies: $cmd" >&2
      (cd "$path" && bash -c "$cmd" </dev/null >&2) ||
        echo "senior-mode: could not install dependencies in $path; run: $cmd" >&2
    fi
  fi
  item_set "$issue" Status "In progress"
}

# Seconds in a duration such as 90m, 12h, 7d or 2w.
duration_seconds() {
  [[ $1 =~ ^([0-9]+)([mhdw])$ ]] || die "not a duration: $1 (use for example 12h, 7d or 2w)"
  case ${BASH_REMATCH[2]} in
    m) echo $((BASH_REMATCH[1] * 60)) ;;
    h) echo $((BASH_REMATCH[1] * 3600)) ;;
    d) echo $((BASH_REMATCH[1] * 86400)) ;;
    w) echo $((BASH_REMATCH[1] * 604800)) ;;
  esac
}

# UTC ISO 8601 time of an epoch, the format GitHub uses (GNU date, then BSD).
iso_time() {
  date -u -d "@$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || date -u -r "$1" +%Y-%m-%dT%H:%M:%SZ
}

# The dashboard as JSON, from board_data; $1 is the start of the period, $2 now, $3 the repository, $locals the
# local branch names.
# shellcheck disable=SC2016 # a jq program, not shell
STATUS_JQ='. as $d | $d.items as $items | {
  repository: $repo, generatedAt: $now, since: $since,
  done: [$d.closed[] | select(.closedAt >= $since and .reason != "NOT_PLANNED") | {number, title, closedAt}] | sort_by(.closedAt) | reverse,
  mergedPullRequests: ([$d.merged[] | select(.mergedAt >= $since)] | length),
  inProgress: [$items[] | select(.open and .status == "In progress") | {number, title}],
  inReview: [$items[] | select(.open and .status == "In review") | . as $i
    | {number, title, pr: ([$d.prs[] | select(.branch | test("^[a-z]+/\($i.number)-")) | .number][0])}],
  blocked: [$items[] | select(.open) | ([
      (if (.labels | index("blocked")) then "blocked" else empty end),
      (if (.labels | index("needs-info")) then "needs information" else empty end),
      (if (.blockers | length) > 0 and (.status | IN("Ready", "In progress", "In review"))
        then "waits for " + (.blockers | map("#\(.)") | join(", ")) else empty end)]) as $r
    | select($r | length > 0) | {number, title, reasons: $r}],
  waiting: (([$d.prs[] | select(.labels | index("needs-human")) | {kind: "pull request", number, title, why: "needs a human decision"}]
      + [$d.prs[] | select(.failing | length > 0) | {kind: "pull request", number, title, why: ("failing: " + (.failing | join(", ")))}]
      + [$items[] | select(.open and (.labels | index("needs-human"))) | {kind: "ticket", number, title, why: "needs a human decision"}])
    | group_by([.kind, .number]) | map(.[0] + {why: (map(.why) | join("; "))})),
  drift: ([$items[] | select((.open | not) and .status != "Done")
      | {number, title, kind: "closed", why: "closed but \(.status // "without a Status")"}]
    + [$items[] | select(.open and .status == "Done") | {number, title, kind: "open-done", why: "open but Done"}]
    + [$items[] | select(.open and (.status | IN("In progress", "In review"))) | . as $i
      | select([$d.prs[].branch, $d.branches[], $locals[]] | any(test("^[a-z]+/\($i.number)(-|$)")) | not)
      | {number, title, kind: "stale", why: "\(.status) with no open pull request and no branch"}]),
  wip: {limit: $wip, count: ([$items[] | select(.open and .status == "In progress")] | length)},
  audit: $audit,
  next: ($d | pick | .[:3] | map({number, title, priority, size, milestone})),
  release: {latest: $d.release, pr: ([$d.prs[] | select(.branch | startswith("release-please")) | {number, title}][0])}
}'

# The same, in plain words; $head says which period it covers.
# shellcheck disable=SC2016 # a jq program, not shell
STATUS_TEXT_JQ='def sec($h; $ls): $h, (if ($ls | length) == 0 then "  nothing" else ($ls[] | "  " + .) end);
  def ticket: "#\(.number) \(.title)";
  "senior-mode · \(.repository) · \(.generatedAt)", "",
  sec("\($head) (\(.done | length))"; [.done[] | ticket] + (if .mergedPullRequests > 0
    then ["\(.mergedPullRequests) pull request\(if .mergedPullRequests > 1 then "s" else "" end) merged"] else [] end)),
  sec("In progress (\(.inProgress | length)\(if .wip.count > .wip.limit then ", over the limit of \(.wip.limit)" else "" end))";
    [.inProgress[] | ticket + (if .worktree then " (worktree \(.worktree))" else "" end)]),
  sec("In review (\(.inReview | length))"; [.inReview[] | ticket + (if .pr then " (pull request #\(.pr))" else "" end)]),
  sec("Blocked or missing information (\(.blocked | length))"; [.blocked[] | ticket + ": " + (.reasons | join(", "))]),
  sec("Waiting for a human (\(.waiting | length))"; [.waiting[] | "\(.kind) #\(.number) \(.title): \(.why)"]),
  (if (.drift | length) > 0 then sec("Board drift (\(.drift | length))"; [.drift[] | ticket + ": " + .why]) else empty end),
  (if .audit then empty else "Dependency audit: off (audit: false)" end),
  sec("Next Ready"; [.next[] | "#\(.number) \(.priority // "no priority") · \(.size // "?") · \(.title)"
    + (if .milestone then " (\(.milestone))" else "" end)]),
  "Release",
  (if .release.latest then "  Last release \(.release.latest.tag), \(.release.latest.date[:10])." else "  No release yet." end)
    + (if .release.pr then " Release pull request #\(.release.pr.number) is open." else " No release pull request open." end)'

# The repairs of `status --fix`, one JSON line per drift entry: {number, title, fixed, line}. Only a
# closed ticket is set Done; what else drifted needs a human's judgement and is left, saying why.
# Fails when a repair failed.
status_fix() {
  local entry n title kind why rc=0
  while IFS= read -r entry; do
    n=$(jq -r .number <<<"$entry") title=$(jq -r .title <<<"$entry") kind=$(jq -r .kind <<<"$entry")
    why=$(jq -r .why <<<"$entry")
    case $kind in
      closed)
        if (item_set "$n" Status Done) >/dev/null; then
          jq -nc --argjson n "$n" --arg t "$title" '{number: $n, title: $t, fixed: true,
            line: "fixed: #\($n) \($t): closed, Status set to Done"}'
        else
          rc=1
          jq -nc --argjson n "$n" --arg t "$title" '{number: $n, title: $t, fixed: false,
            line: "not fixed: #\($n) \($t): could not set the Status Done"}'
        fi
        ;;
      open-done)
        jq -nc --argjson n "$n" --arg t "$title" --arg w "$why" '{number: $n, title: $t, fixed: false,
          line: "left: #\($n) \($t): \($w); a human decides whether it is finished (close it) or not (move it back)"}' ;;
      *)
        jq -nc --argjson n "$n" --arg t "$title" --arg w "$why" '{number: $n, title: $t, fixed: false,
          line: "left: #\($n) \($t): \($w); a human decides whether to resume it or move it back to Ready"}' ;;
    esac
  done < <(jq -c '.drift[]' <<<"$1")
  return "$rc"
}

# One status report. $1 json|text, $2 --since duration or "", $3 true to move the "last time" mark,
# $4 true to repair the drift (--fix).
status_once() {
  local json=$1 since=$2 save=$3 fix=${4:-false} root cache now_s now since_iso head data out wip audit results fixed trees locals
  local lines="" rc=0
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
  cache=$root/.claude/senior-mode/status-seen
  now_s=$(date +%s)
  now=$(iso_time "$now_s")
  if [ -n "$since" ]; then
    since_iso=$(iso_time $((now_s - $(duration_seconds "$since"))))
    head="Done in the last $since"
  elif [ -s "$cache" ]; then
    since_iso=$(sed -n 1p "$cache")
    head="Done since last time"
  else
    since_iso=$(iso_time $((now_s - 604800)))
    head="Done in the last 7d"
  fi
  data=$(board_data true) || return 1
  wip=$(config_get wip)
  [[ $wip =~ ^[1-9][0-9]*$ ]] || die "wip must be a positive whole number, not $wip"
  if audit_enabled; then audit=true; else audit=false; fi
  # The local branches count too: a ticket worked on and not pushed yet has a branch.
  locals=$(git for-each-ref --format='%(refname:short)' refs/heads | jq -Rsc 'split("\n") | map(select(length > 0))') || locals='[]'
  out=$(jq -c --arg now "$now" --arg since "$since_iso" --arg repo "$(repo_slug)" --argjson wip "$wip" \
    --argjson audit "$audit" --argjson locals "$locals" "$PICK_DEF$STATUS_JQ" <<<"$data") ||
    die "could not build the status"
  trees=$(ticket_worktrees "$root" | jq -Rsc 'split("\n") | map(select(length > 0) | capture("^(?<n>[0-9]+) (?<p>.*)$")) | map({(.n): .p}) | add // {}') ||
    trees='{}'
  out=$(jq -c --argjson t "$trees" '.inProgress |= map(. + {worktree: ($t[.number | tostring])})' <<<"$out")
  if [ "$fix" = true ]; then
    results=$(status_fix "$out") || rc=1
    fixed=$(jq -sc '[.[] | select(.fixed)]' <<<"$results")
    lines=$(jq -r '.line' <<<"$results")
    out=$(jq -c --argjson f "$fixed" '. + {fixed: ($f | map({number, title}))}' <<<"$out")
  fi
  if [ "$json" = true ]; then
    printf '%s\n' "$out"
  else
    jq -r --arg head "$head" "$STATUS_TEXT_JQ" <<<"$out"
    [ -z "$lines" ] || printf '\n%s\n' "$lines"
  fi
  if [ "$save" = true ]; then
    # The directory ignores itself, so the mark never dirties the tree that `check` records.
    mkdir -p "$(dirname "$cache")"
    echo '*' >"$(dirname "$cache")/.gitignore"
    printf '%s\n' "$now" >"$cache"
  fi
  return "$rc"
}

# senior-mode status [--json] [--since <dur>] [--watch [secs]] [--fix]
# A plain run reports what is new since the previous plain run and moves that mark; --json, --since
# and --watch only read it. --fix repairs the board drift once, so it does not mix with --watch.
status() {
  local json=false since="" watch=false secs=30 fix=false
  while [ $# -gt 0 ]; do
    case $1 in
      --json) json=true ;;
      --fix) fix=true ;;
      --since)
        [ -n "${2:-}" ] || usage
        since=$2
        duration_seconds "$since" >/dev/null
        shift
        ;;
      --watch)
        watch=true
        if [[ ${2:-} =~ ^[1-9][0-9]*$ ]]; then
          secs=$2
          shift
        fi
        ;;
      *) usage ;;
    esac
    shift
  done
  if [ "$watch" = true ]; then
    [ "$json" = false ] || die "status --watch cannot print JSON"
    [ "$fix" = false ] || die "status --watch cannot --fix: a repair runs once, on purpose"
    while :; do
      if [ -t 1 ]; then printf '\033[H\033[2J'; else echo; fi
      status_once false "$since" false || echo "GitHub did not answer; trying again in ${secs}s"
      sleep "$secs"
    done
  fi
  if [ "$json" = false ] && [ -z "$since" ]; then
    status_once false "" true "$fix" || exit 1
  else
    status_once "$json" "$since" false "$fix" || exit 1
  fi
}

# What `retro` needs beyond the board (spec 0001 §7): the status changes and reopenings of recently
# updated issues, and recently merged pull requests with their size and reviews. One more query.
# shellcheck disable=SC2016 # a GraphQL query, not shell
HISTORY_QUERY='query($owner: String!, $name: String!, $since: DateTime!) {
  repository(owner: $owner, name: $name) {
    issues(first: 100, filterBy: {since: $since}, orderBy: {field: UPDATED_AT, direction: DESC}) { nodes { number title
      timelineItems(first: 50, itemTypes: [PROJECT_V2_ITEM_STATUS_CHANGED_EVENT, REOPENED_EVENT]) { nodes { __typename
        ... on ProjectV2ItemStatusChangedEvent { createdAt status } ... on ReopenedEvent { createdAt } } } } }
    pullRequests(states: MERGED, first: 50, orderBy: {field: UPDATED_AT, direction: DESC}) { nodes { number title headRefName
      additions deletions mergedAt labels(first: 10) { nodes { name } }
      reviews(first: 20) { nodes { state bodyText author { login } } } } }
  }
}'

# Modification time of a file, in epoch seconds (GNU stat, then BSD).
file_mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1"
}

# The run outcomes of this repository (one object per ticket run, `run` writes it to
# <git common dir>/senior-mode/runs/<stamp>/<n>.json with `ticket`, `outcome`, `escalated`, `reason`,
# `model`, `finishedAt`), as {found, failed, escalated} for the period starting at $2. $1 is the git
# common directory. Absent or unreadable files are not an error; the session logs next to the
# outcomes (<n>-<model>.json) are not outcomes. An outgrown ticket counts as failed.
retro_runs() {
  local dir=$1/senior-mode/runs f
  if [ ! -d "$dir" ]; then
    echo '{"found":false,"failed":[],"escalated":[]}'
    return 0
  fi
  {
    for f in "$dir"/*/[0-9]*.json; do
      [[ $f =~ /[0-9]+\.json$ ]] && [ -f "$f" ] || continue
      jq -c --arg m "$(iso_time "$(file_mtime "$f")")" 'if type == "object"
        then {ticket, outcome, escalated, reason, at: (.finishedAt // $m)} else empty end' "$f" 2>/dev/null || true
    done
  } | jq -sc --arg since "$2" '[.[] | select(.at >= $since)] as $l | {found: true,
    failed: [$l[] | select(.outcome | IN("failed", "outgrown")) | {ticket, reason, at}] | sort_by(.ticket),
    escalated: [$l[] | select(.escalated == true or .outcome == "escalated") | {ticket, reason, at}] | sort_by(.ticket)}'
}

# The failed results `check` recorded since the epoch $1, in this repository and its worktrees (ADR 0006).
retro_checks() {
  local common d f mt
  common=$(git rev-parse --path-format=absolute --git-common-dir)
  {
    for d in "$common/senior-mode/checks" "$common"/worktrees/*/senior-mode/checks; do
      [ -d "$d" ] || continue
      for f in "$d"/*; do
        [ -f "$f" ] && [ "$(sed -n 1p "$f")" = failure ] || continue
        mt=$(file_mtime "$f")
        [ "$mt" -ge "$1" ] || continue
        jq -nc --arg c "$(basename "$f" | cut -c1-7)" --arg d "$(sed -n 2p "$f")" --arg at "$(iso_time "$mt")" \
          '{commit: $c, description: $d, at: $at}'
      done
    done
  } | jq -sc 'sort_by(.at)'
}

# The facts of a period as JSON. Inputs: $d board_data, $h the history, $runs, $checks; $since, $now, $repo.
# Cycle time runs from the first move to In progress to the close of the ticket; a ticket with no
# recorded start is left out of it. A size is over when the pull request holds more than 1.5 times the
# lines its size allows (S ~50, M ~400, spec §5), since those are approximate.
# shellcheck disable=SC2016 # a jq program, not shell
RETRO_JQ='def branch_ticket: [capture("^[a-z]+/(?<n>[0-9]+)-") | .n | tonumber] | first;
  def round1: . * 10 | round / 10;
  . as $d | $h.data.repository.issues.nodes as $iss | $h.data.repository.pullRequests.nodes as $prs
  | ($d.items | map({key: (.number | tostring), value: .}) | from_entries) as $byn
  | def lines($n): [$prs[] | select((.headRefName | branch_ticket) == $n) | .additions + .deletions] | if length == 0 then null else add end;
  def cycle($c): ([$iss[] | select(.number == $c.number) | .timelineItems.nodes[]
      | select(.__typename == "ProjectV2ItemStatusChangedEvent" and .status == "In progress") | .createdAt] | sort | first) as $start
    | if $start == null then null else (($c.closedAt | fromdateiso8601) - ($start | fromdateiso8601)) / 3600
      | if . < 0 then null else round1 end end;
  def excerpt: gsub("\\s+"; " ") | gsub("^ | $"; "") | .[:160];
  def why: (if (.labels | index("needs-human")) then ["needs-human label"] else [] end)
    + ([.reviews[]? | select(.state == "CHANGES_REQUESTED")] | last
      | if . then ["changes requested by \(.author.login // "someone")" + (if (.bodyText | test("\\S")) then ": " + (.bodyText | excerpt) else "" end)] else [] end);
  [$d.closed[] | select(.closedAt >= $since and .reason != "NOT_PLANNED") | . as $c | ($byn[($c.number | tostring)] // {}) as $i
    | {number, title, size: $i.size, closedAt, cycleHours: cycle($c), lines: lines($c.number)}] | sort_by(.number) as $done
  | [$done[] | select(.cycleHours != null) | .cycleHours] | sort as $hs
  | {repository: $repo, generatedAt: $now, since: $since, done: $done,
     cycle: {measured: ($hs | length),
       medianHours: (if ($hs | length) == 0 then null else (($hs[(($hs | length) - 1) / 2 | floor] + $hs[($hs | length) / 2 | floor]) / 2) | round1 end),
       worst: ([$done[] | select(.cycleHours != null)] | max_by(.cycleHours) | if . then {number, title, hours: .cycleHours} else null end)},
     humanPullRequests: (([$d.prs[] | select(.labels | index("needs-human")) | {number, title, state: "open", why: ["needs-human label"]}]
       + [$prs[] | select(.mergedAt >= $since) | .labels = [.labels.nodes[].name] | .reviews = .reviews.nodes
         | {number, title, state: "merged", why: why} | select(.why | length > 0)]) | sort_by(.number)),
     runs: $runs,
     reopened: [$iss[] | . as $i | ([.timelineItems.nodes[] | select(.__typename == "ReopenedEvent" and .createdAt >= $since)] | last) as $e
       | select($e != null) | {number: $i.number, title: $i.title, at: $e.createdAt}] | sort_by(.number),
     checkFailures: $checks,
     sizes: [$done[] | select((.size | IN("S", "M")) and .lines != null) | (if .size == "S" then 50 else 400 end) as $l
       | {number, title, size, lines, limit: $l, over: (.lines > $l * 1.5)}]}'

# The same, in plain words; $head says which period it covers.
# shellcheck disable=SC2016 # a jq program, not shell
RETRO_TEXT_JQ='def sec($h; $ls): $h, (if ($ls | length) == 0 then "  nothing" else ($ls[] | "  " + .) end);
  def ticket: "#\(.number) \(.title)";
  "senior-mode retro · \(.repository) · \(.generatedAt)", "",
  sec("\($head) (\(.done | length))"; [.done[] | ticket + (if .cycleHours then " · \(.cycleHours)h" else "" end)]),
  "Cycle time (In progress to Done)",
  (if .cycle.measured == 0 then "  nothing measured"
   else "  median \(.cycle.medianHours)h, worst \(.cycle.worst.hours)h (\(.cycle.worst | ticket)), over \(.cycle.measured) ticket\(if .cycle.measured > 1 then "s" else "" end)" end),
  sec("Needed a human (\(.humanPullRequests | length))"; [.humanPullRequests[]
    | "pull request #\(.number) \(.title)\(if .state == "open" then " (still open)" else "" end): \(.why | join("; "))"]),
  (if .runs.found then sec("Failed or escalated runs (\((.runs.failed | length) + (.runs.escalated | length)))";
     [.runs.failed[] | "#\(.ticket): failed: \(.reason // "no reason recorded")"]
     + [.runs.escalated[] | "#\(.ticket): escalated: \(.reason // "no reason recorded")"])
   else "Failed or escalated runs", "  no run logs" end),
  sec("Reopened (\(.reopened | length))"; [.reopened[] | ticket]),
  sec("Check failures (\(.checkFailures | length))"; [.checkFailures[] | "\(.commit): \(.description)"]),
  sec("Estimates against reality"; [.sizes[] | select(.over) | "#\(.number) \(.size): \(.lines) lines, the size allows about \(.limit)"]
    + (if (.sizes | length) > 0 and all(.sizes[]; .over | not) then ["all within their size"] else [] end))'

# senior-mode retro [--since <dur>] [--json]
# The facts of the weekly review (default period: 7 days). Reads only; the skill turns them into proposals.
retro() {
  local json=false since="7d" root now_s now since_s since_iso data history runs checks slug
  while [ $# -gt 0 ]; do
    case $1 in
      --json) json=true ;;
      --since)
        [ -n "${2:-}" ] || usage
        since=$2
        duration_seconds "$since" >/dev/null
        shift
        ;;
      *) usage ;;
    esac
    shift
  done
  root=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "not inside a git repository"
  now_s=$(date +%s)
  now=$(iso_time "$now_s")
  since_s=$((now_s - $(duration_seconds "$since")))
  since_iso=$(iso_time "$since_s")
  slug=$(repo_slug)
  # --json keeps stdout pure.
  if [ "$json" = true ]; then security_alerts >&2; else security_alerts; fi
  data=$(board_data true) || exit 1
  history=$(jq -nc --arg q "$HISTORY_QUERY" --arg o "${slug%%/*}" --arg n "${slug#*/}" --arg s "$since_iso" \
    '{query: $q, variables: {owner: $o, name: $n, since: $s}}' | gh_retry api graphql --input -) ||
    die "cannot read the history from GitHub"
  [ -z "$(jq -r '.errors[0].message // empty' <<<"$history" 2>/dev/null)" ] ||
    die "GitHub refused the history query: $(jq -r '.errors[0].message' <<<"$history")"
  runs=$(retro_runs "$root" "$since_iso")
  checks=$(retro_checks "$since_s")
  data=$(jq -c --argjson h "$history" --argjson runs "$runs" --argjson checks "$checks" --arg now "$now" --arg since "$since_iso" \
    --arg repo "$slug" "$RETRO_JQ" <<<"$data") || die "could not build the retro"
  if [ "$json" = true ]; then
    printf '%s\n' "$data"
  else
    jq -r --arg head "Done in the last $since" "$RETRO_TEXT_JQ" <<<"$data"
  fi
}

# One line for Claude Code's status line (spec 0001 §20): the ticket of the branch, the last check
# recorded for it and, during a run, a mark. Offline and fast; prints nothing where senior-mode is not
# set up, and never fails. Claude Code sends the session as JSON on stdin; its directory is used.
statusline() {
  local input="" dir root branch ticket record state="no check" parts
  [ -t 0 ] || input=$(cat)
  dir=$(jq -r '.workspace.current_dir // .cwd // empty' <<<"$input" 2>/dev/null) || dir=""
  [ -z "$dir" ] || cd "$dir" 2>/dev/null || return 0
  root=$(git rev-parse --show-toplevel 2>/dev/null) || return 0
  [ -f "$root/.claude/senior-mode.json" ] || return 0
  branch=$(git symbolic-ref --short -q HEAD) || branch=$(git rev-parse --short HEAD 2>/dev/null) || return 0
  ticket=$(sed -nE 's#^[a-z]+/([0-9]+)-.*#\1#p' <<<"$branch")
  parts=${ticket:+#$ticket}
  parts=${parts:-$branch}
  record=$(check_record "$(git rev-parse HEAD 2>/dev/null)") || true
  if [ -f "$record" ]; then
    if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
      state="check stale"
    elif [ "$(sed -n 1p "$record")" = success ]; then
      state="check ok"
    else
      state="check FAILED"
    fi
  fi
  parts+=" · $state"
  [ -z "${SENIOR_MODE_RUN:-}" ] || parts+=" · run in progress"
  printf '%s\n' "$parts"
}

# The command of the status line setup writes. A plugin cannot ship a status line, and the plugin's
# directory changes with every version, so the command looks the script up each time: the install
# path in Claude Code's plugin registry, else the newest version in its plugin cache; nothing is
# printed when the plugin is not installed.
# shellcheck disable=SC2016 # a command for the project's settings, not for this shell
STATUSLINE_COMMAND='b=$(jq -r '\''[.plugins | to_entries[] | select(.key | startswith("senior-mode@")) | .value[].installPath] | last // empty'\'' "$HOME/.claude/plugins/installed_plugins.json" 2>/dev/null)/bin/senior-mode; [ -x "$b" ] || b=$(ls -d "$HOME"/.claude/plugins/cache/*/senior-mode/*/bin/senior-mode 2>/dev/null | sort -V | tail -1); [ -x "$b" ] && exec "$b" statusline; exit 0'

# Writes the status line of the project into .claude/settings.json. A status line of the project's
# own is kept; ours is refreshed. A project setting hides the user's own status line in this project.
setup_statusline() {
  local root file current out=0
  root=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
  file=$root/.claude/settings.json
  mkdir -p "$root/.claude"
  [ -f "$file" ] || echo '{}' >"$file"
  jq empty "$file" 2>/dev/null || die "invalid .claude/settings.json; fix or remove it, then run setup again"
  current=$(jq -r '.statusLine.command // empty' "$file")
  if [ -n "$current" ] && ! grep -q 'senior-mode' <<<"$current"; then
    echo "statusline: yours kept; to add senior-mode's, call \`senior-mode statusline\` from your command"
    return 0
  fi
  # shellcheck disable=SC2016 # a jq program, not shell
  json_update "$file" '.statusLine = {type: "command", command: $c}' --arg c "$STATUSLINE_COMMAND" || out=$?
  [ "$out" -ne 1 ] || die "could not update .claude/settings.json"
  if [ "$out" -eq 2 ]; then
    echo "statusline: already set in .claude/settings.json"
  else
    echo "statusline: set in .claude/settings.json (ticket, last check, run in progress)"
  fi
}

# The headless CLI named by agent.command (default claude): on PATH, else where its installer puts it
# (cron and systemd timers have a short PATH).
agent_bin() {
  local cmd
  cmd=$(config_get agent.command)
  command -v "$cmd" 2>/dev/null && return 0
  [ -x "$HOME/.local/bin/$cmd" ] || die "$cmd not found on PATH or in ~/.local/bin (agent.command)"
  printf '%s\n' "$HOME/.local/bin/$cmd"
}

# The task of the headless session of one ticket (spec 0001 §10, ADR 0007): number, title, branch.
run_prompt() {
  cat <<EOF
You are one ticket session of an autonomous senior-mode run on $RUN_SLUG. Nobody will answer
questions: decide within the ticket, its spec and the project's rules, or give up as described below.

Deliver ticket #$1 ("$2") in this worktree, on branch $3, as the senior-mode team:
1. Read the ticket (\`gh issue view $1\`), its spec and its acceptance criteria.
2. The test-author agent writes failing tests from the acceptance criteria and records the red run;
   the implementer agent makes them pass (skills tdd, verify, commit): tests land in the same commit
   as the code they cover.
3. \`senior-mode check\` passes on a clean tree; push the branch; open a pull request from the
   template with \`Closes #$1\` and the red run; \`senior-mode publish\`;
   \`senior-mode item set $1 Status "In review"\`.
4. The reviewer agent reviews the pull request in a fresh context (skill review) and sets
   senior-mode/review; when publish left senior-mode/security pending, the security agent reviews it
   too; at most 2 fix rounds, with check and publish after each push.
5. Never merge, never touch another ticket: \`senior-mode run\` decides what happens next. A risk
   you meet outside this ticket is filed, never fixed here: \`senior-mode issue create --severity ...
   --kind ... --path ... --rule ...\` (no exploit detail in the body).

Last, write exactly one line to the file \$SENIOR_MODE_RUN_OUTCOME:
- \`delivered\` once the pull request is open with senior-mode/ci, senior-mode/review and senior-mode/security set;
- \`outgrown: <reason>\` if the ticket is bigger than its size or needs a human decision;
- \`failed: <reason>\` otherwise, in one plain sentence.
EOF
}

# Starts a session script in the background, in its own session so that run_kill can kill the group
# without killing run; without setsid the session cannot be stopped (run_kill says so).
run_detach() {
  if command -v setsid >/dev/null; then
    nohup setsid bash "$1" >/dev/null 2>&1 &
  else
    nohup bash "$1" >/dev/null 2>&1 &
  fi
}

# Writes the script of a ticket session on a model and starts it in a window of the tmux session
# senior-mode-run, else in the background. The script leaves <n>.exit when the session ends.
# shellcheck disable=SC2016 # lines of the script, expanded when it runs
run_launch() {
  local n=$1 model=$2 script=$RUN_DIR/$1.sh cmd
  rm -f "$RUN_DIR/$n.outcome" "$RUN_DIR/$n.exit" "$RUN_DIR/$n.pgid"
  RUN_MODEL[$n]=$model
  RUN_STARTED[$n]=$SECONDS
  {
    echo '#!/usr/bin/env bash'
    # Its process group, for run_timeout to kill the session with everything it started.
    printf 'ps -o pgid= -p $$ | tr -d " " >%q\n' "$RUN_DIR/$n.pgid"
    printf 'cd %q || exit 1\n' "${RUN_WT[$n]}"
    printf 'SENIOR_MODE_RUN=1 SENIOR_MODE_RUN_OUTCOME=%q %q -p --model %q --permission-mode bypassPermissions --output-format json' \
      "$RUN_DIR/$n.outcome" "$RUN_CLAUDE" "$model"
    [ -z "${SENIOR_MODE_PLUGIN_DIR:-}" ] || printf ' --plugin-dir %q' "$SENIOR_MODE_PLUGIN_DIR"
    printf ' "$(cat %q)" >%q 2>%q\n' "$RUN_DIR/$n.prompt" "$RUN_DIR/$n-$model.json" "$RUN_DIR/$n-$model.log"
    printf 'echo $? >%q.tmp && mv %q.tmp %q\n' "$RUN_DIR/$n.exit" "$RUN_DIR/$n.exit" "$RUN_DIR/$n.exit"
  } >"$script"
  cmd="bash $(printf '%q' "$script")"
  if command -v tmux >/dev/null; then
    if tmux has-session -t senior-mode-run 2>/dev/null; then
      tmux new-window -d -t senior-mode-run -n "#$n" "$cmd"
    else
      tmux new-session -d -s senior-mode-run -n "#$n" "$cmd"
    fi
  else
    run_detach "$script"
  fi
  echo "#$n: session started on $model"
}

# Opens the ticket with `senior-mode start` (worktree, branch and Status In progress, named and tracked
# as everywhere else), then launches it on Sonnet. A ticket that cannot be opened is given up.
run_start() {
  local n=$1 out rc=0
  out=$(SENIOR_MODE_RUN=1 SENIOR_MODE_RUN_TOKEN_FILE="$RUN_DIR/token" start "$n" 2>"$RUN_DIR/$n.err") || rc=$?
  RUN_BRANCH[$n]=$(sed -n 's/^branch //p' <<<"$out")
  RUN_WT[$n]=$(sed -n 's/^worktree //p' <<<"$out")
  if [ -z "${RUN_WT[$n]}" ]; then
    run_giveup "$n" "no worktree: $(head -n 1 "$RUN_DIR/$n.err")"
    return 1
  fi
  [ "$rc" -eq 0 ] || echo "#$n: could not set the Status In progress: $(head -n 1 "$RUN_DIR/$n.err")" >&2
  run_prompt "$n" "${RUN_TITLE[$n]}" "${RUN_BRANCH[$n]}" >"$RUN_DIR/$n.prompt"
  run_launch "$n" sonnet
}

# A ticket the run stops working on: back to Backlog with a comment, kept worktree and branch.
run_giveup() {
  local n=$1 reason=$2
  (item_set "$n" Status Backlog) >/dev/null || echo "#$n: could not set the Status Backlog" >&2
  gh api "repos/$RUN_SLUG/issues/$n/comments" -f body="An autonomous senior-mode run stopped working on this ticket: $reason

It is back in Backlog. The branch \`${RUN_BRANCH[$n]}\` is kept as it was, in the worktree \`${RUN_WT[$n]}\`." \
    >/dev/null || echo "#$n: could not comment on the ticket" >&2
  RUN_FAILED+=("#$n ${RUN_TITLE[$n]}: $reason (branch ${RUN_BRANCH[$n]} kept)")
  RUN_FAILS=$((RUN_FAILS + 1))
  [ "$RUN_FAILS" -lt "$RUN_MAXFAIL" ] || RUN_STOP="$RUN_FAILS failed ticket(s) in a row (autonomy.maxConsecutiveFailures)"
}

# Kills the process group of the session script $1 (<name>.sh, its group in <name>.pgid), the ticket
# number or docs; $2 names it in the message when it cannot be stopped.
run_kill() {
  local name=$1 pgid="" i
  pgid=$(cat "$RUN_DIR/$name.pgid" 2>/dev/null) || pgid=""
  # Only the group of this session's script: a pgid file that is empty, 0 or 1, run's own group or a
  # leader that is not <name>.sh is never signalled.
  if [[ $pgid =~ ^([2-9]|[1-9][0-9]+)$ ]] && [ "$pgid" != "$(ps -o pgid= -p $$ | tr -d ' ')" ] &&
    [[ $(ps -o args= -p "$pgid" 2>/dev/null) == *"/$name.sh"* ]]; then
    kill -TERM -- "-$pgid" 2>/dev/null || true
    for ((i = 0; i < 20; i++)); do kill -0 -- "-$pgid" 2>/dev/null || break; sleep 0.1; done
    kill -KILL -- "-$pgid" 2>/dev/null || true
  else
    echo "$2: session not stopped (no process group of its own to kill), it may still be running" >&2
  fi
}

# A session that outlived autonomy.sessionTimeout: killed with its process group (the group of a tmux
# window or of setsid; processes that left it by their own setsid are out of reach), then the ticket is
# labelled needs-human with the log path, recorded as failed and counted for the circuit breaker. Not
# retried on Opus: ADR 0014 escalates failed work, not a stuck session. Its Status stays In progress,
# needs-human is the signal.
run_timeout() {
  local n=$1 reason log=$RUN_DIR/$1-${RUN_MODEL[$1]}.log
  reason="timed out after $RUN_TIMEOUT minute$([ "$RUN_TIMEOUT" -eq 1 ] || echo s)"
  run_kill "$n" "#$n"
  gh_retry api "repos/$RUN_SLUG/issues/$n/labels" -f 'labels[]=needs-human' >/dev/null ||
    echo "#$n: could not label the ticket needs-human" >&2
  gh api "repos/$RUN_SLUG/issues/$n/comments" -f body="An autonomous senior-mode run stopped this ticket's session: $reason (autonomy.sessionTimeout).

The session log is \`$log\`. The branch \`${RUN_BRANCH[$n]}\` is kept as it was, in the worktree \`${RUN_WT[$n]}\`; the Status is unchanged. A person decides what happens next." \
    >/dev/null || echo "#$n: could not comment on the ticket" >&2
  run_record "$n" failed "$reason"
  RUN_FAILED+=("#$n ${RUN_TITLE[$n]}: $reason (branch ${RUN_BRANCH[$n]} kept, log $log)")
  RUN_FAILS=$((RUN_FAILS + 1))
  [ "$RUN_FAILS" -lt "$RUN_MAXFAIL" ] || RUN_STOP="$RUN_FAILS failed ticket(s) in a row (autonomy.maxConsecutiveFailures)"
}

# A delivered ticket: merged when merging is on and every bound holds (ADR 0003, 0008), else listed
# for a human with the reason. $2 is the open pull request as the REST list gives it.
run_merge() {
  local n=$1 pr sha reason="" missing files zones
  pr=$(jq -r '.[0].number' <<<"$2")
  sha=$(jq -r '.[0].head.sha' <<<"$2")
  if [ "$RUN_MERGE" != true ]; then
    reason="merging is off (autonomy.merge)"
  elif [ "$RUN_PROTECTION" != ruleset ]; then
    reason="the server enforces no branch protection (github.protection is ${RUN_PROTECTION:-unset})"
  elif jq -e '[.[0].labels[]?.name] | index("needs-human")' <<<"$2" >/dev/null; then
    reason="labelled needs-human"
  elif ! missing=$(gh_retry api "repos/$RUN_SLUG/commits/$sha/status" | jq -r '["senior-mode/ci", "senior-mode/review", "senior-mode/security"]
      - [.statuses[] | select(.state == "success") | .context] | join(" and ")'); then
    reason="its statuses could not be read"
  elif [ -n "$missing" ]; then
    reason="$missing not green"
  # The command applies the protected zones, not the reviewer: the files GitHub would merge, against
  # the globs of the base branch, so a pull request cannot unprotect itself. --match-head-commit
  # refuses a head pushed after these checks.
  elif [ "$RUN_ZONES_KNOWN" != true ]; then
    reason="the protected zones could not be read: $RUN_BASE has no .claude/senior-mode.json"
  elif ! files=$(gh_retry api "repos/$RUN_SLUG/pulls/$pr/files" --paginate --jq '.[] | .filename, (.previous_filename // empty)'); then
    reason="its changed files could not be read"
  elif zones=$(protected_match "$RUN_GLOBS" <<<"$files") && [ -n "$zones" ]; then
    reason="it touches a protected zone ($(paste -sd, - <<<"$zones" | sed 's/,/, /g'))"
  elif gh pr merge "$pr" --rebase --match-head-commit "$sha" -R "$RUN_SLUG" >/dev/null 2>"$RUN_DIR/$n.merge"; then
    RUN_MERGED+=("#$n ${RUN_TITLE[$n]} (pull request #$pr)")
    RUN_PRS+=("#$pr")
    (item_set "$n" Status Done) >/dev/null || echo "#$n: merged, but could not set the Status Done" >&2
    return 0
  else
    reason="the merge failed: $(head -n 1 "$RUN_DIR/$n.merge")"
  fi
  RUN_WAITING+=("#$n ${RUN_TITLE[$n]}: pull request #$pr, $reason")
}

# Writes the outcome of a ticket, the file `retro` reads: $RUN_DIR/<n>.json holds {ticket, outcome
# (delivered, outgrown or failed), escalated (the ticket went to Opus), reason (the last failure the
# session reported, null for a clean delivery), model (of the last session), finishedAt}. $2 is the
# outcome and $3 the reason, possibly empty. Spec 0001 section 10.
run_record() {
  jq -nc --argjson n "$1" --arg o "$2" --arg r "$3" --arg m "${RUN_MODEL[$1]}" --arg e "${RUN_ESCALATED[$1]:-false}" \
    --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{ticket: $n, outcome: $o, escalated: ($e == "true"),
    reason: (if $r == "" then null else $r end), model: $m, finishedAt: $t}' >"$RUN_DIR/$1.json"
}

# Reads how a finished session went. Returns 1 when the ticket goes on (a retry on Opus).
run_finish() {
  local n=$1 outcome pulls='[]'
  outcome=$(head -n 1 "$RUN_DIR/$n.outcome" 2>/dev/null) || outcome=""
  [ -n "$outcome" ] || outcome="failed: the session ended without saying how it went (exit code $(cat "$RUN_DIR/$n.exit"), log in $RUN_DIR)"
  if [ "$outcome" = delivered ]; then
    pulls=$(gh_retry api "repos/$RUN_SLUG/pulls?head=${RUN_SLUG%%/*}:${RUN_BRANCH[$n]}&state=open") || pulls='[]'
    jq -e 'length > 0' <<<"$pulls" >/dev/null ||
      outcome="failed: the session said delivered but there is no open pull request for its branch"
  fi
  case $outcome in
    delivered)
      RUN_FAILS=0
      run_record "$n" delivered "${RUN_REASON[$n]:-}"
      run_merge "$n" "$pulls"
      ;;
    outgrown:*)
      RUN_STOP="#$n outgrew its size"
      run_record "$n" outgrown "${outcome#outgrown: }"
      run_giveup "$n" "it outgrew its size: ${outcome#outgrown: }"
      ;;
    *)
      if [ "$RUN_ESCALATE" = true ] && [ "${RUN_MODEL[$n]}" = sonnet ]; then
        printf '\nA first attempt on Sonnet gave up: %s\nIts work is in this worktree; build on it or reset it.\n' \
          "${outcome#failed: }" >>"$RUN_DIR/$n.prompt"
        RUN_ESCALATED[$n]=true
        RUN_REASON[$n]=${outcome#failed: }
        run_launch "$n" opus
        return 1
      fi
      run_record "$n" failed "${outcome#failed: }"
      run_giveup "$n" "${outcome#failed: }"
      ;;
  esac
}

# After merges, one session brings the living docs up to date, on its own branch and pull request. It is
# bounded like a ticket session (autonomy.sessionTimeout, killed with its process group) and its outcome
# is written to $RUN_DIR/docs-outcome.json ({session, outcome (done or failed), reason, finishedAt}; not a
# ticket, so `retro` does not read it). No ticket to label: a failure is on stderr and in the report. The
# worktree and branch are kept as they were.
# shellcheck disable=SC2016 # lines of the script, expanded when it runs
run_docs() {
  local wt branch=docs/run-$RUN_STAMP script=$RUN_DIR/docs.sh reason="" rc started=$SECONDS
  wt=$(worktree_path "$RUN_ROOT" "run-docs-$RUN_STAMP")
  git fetch -q origin 2>/dev/null || true
  git worktree add -q -b "$branch" "$wt" "$RUN_BASE" 2>/dev/null || {
    echo "docs: no worktree, skipped" >&2
    return 0
  }
  printf "Pull requests %s were just merged on %s. Bring the living docs up to date with them (README, architecture, user-facing changelog), with the project's docs skill if it has one. If nothing needs to change, stop. Otherwise commit on branch %s, run senior-mode check, push and open a pull request; never merge it.\n" \
    "${RUN_PRS[*]}" "$RUN_SLUG" "$branch" >"$RUN_DIR/docs.prompt"
  {
    echo '#!/usr/bin/env bash'
    printf 'ps -o pgid= -p $$ | tr -d " " >%q\n' "$RUN_DIR/docs.pgid"
    printf 'cd %q || exit 1\n' "$wt"
    printf 'SENIOR_MODE_RUN=1 %q -p --model sonnet --permission-mode bypassPermissions --output-format json' "$RUN_CLAUDE"
    [ -z "${SENIOR_MODE_PLUGIN_DIR:-}" ] || printf ' --plugin-dir %q' "$SENIOR_MODE_PLUGIN_DIR"
    printf ' "$(cat %q)" >%q 2>%q\n' "$RUN_DIR/docs.prompt" "$RUN_DIR/docs.json" "$RUN_DIR/docs.log"
    printf 'echo $? >%q.tmp && mv %q.tmp %q\n' "$RUN_DIR/docs.exit" "$RUN_DIR/docs.exit" "$RUN_DIR/docs.exit"
  } >"$script"
  run_detach "$script"
  until [ -f "$RUN_DIR/docs.exit" ]; do
    if [ $((SECONDS - started)) -ge $((RUN_TIMEOUT * ${SENIOR_MODE_TIMEOUT_UNIT:-60})) ]; then
      reason="docs session timed out after $RUN_TIMEOUT minute$([ "$RUN_TIMEOUT" -eq 1 ] || echo s)"
      run_kill docs docs
      break
    fi
    sleep "${SENIOR_MODE_POLL:-15}"
  done
  if [ -z "$reason" ]; then
    rc=$(cat "$RUN_DIR/docs.exit")
    [ "$rc" -eq 0 ] || reason="docs session failed (exit code $rc, log in $RUN_DIR/docs.log)"
  fi
  [ -z "$reason" ] || {
    echo "docs: $reason" >&2
    RUN_FAILED+=("$reason (branch $branch kept, log $RUN_DIR/docs.log)")
  }
  jq -nc --arg r "$reason" --arg t "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{session: "docs", outcome: (if $r == "" then "done" else "failed" end),
    reason: (if $r == "" then null else $r end), finishedAt: $t}' >"$RUN_DIR/docs-outcome.json"
}

# Is the plugin enabled for the sessions the run starts? Claude Code keeps it in `enabledPlugins`
# ("<plugin>@<marketplace>": true) of the user settings (CLAUDE_CONFIG_DIR, else ~/.claude) and of the
# project's tracked .claude/settings.json; the project's wins. Ticket sessions run in fresh worktrees of
# the base branch, so the project's file is read from $RUN_BASE: an untracked settings.local.json is not in
# their worktree and does not count.
run_plugin_enabled() {
  {
    cat "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" 2>/dev/null || true
    git show "$RUN_BASE:.claude/settings.json" 2>/dev/null || true
  } | jq -es 'reduce .[] as $s ({}; . + ($s.enabledPlugins // {}))
    | to_entries | any(.[]; (.key | startswith("senior-mode@")) and .value == true)' >/dev/null 2>&1
}

# Once a day, a probe session that tries a command guard-bash denies in every session and that is inert
# if the deny fails (git init of a temporary directory under a core.hooksPath override). It runs in a
# throwaway worktree of the base branch, what a ticket session sees, and is stopped after
# SENIOR_MODE_PROBE_TIMEOUT seconds (default 300). The probe passes when the deny shows in the session's
# output and the directory was not created. The date of the last pass is in <git common dir>/senior-mode/probe.
# A failed probe leaves its output in probe.log.
run_probe() {
  local state=$1/senior-mode/probe tmp why="" rc=0 pid dog
  [ "$(cat "$state" 2>/dev/null)" != "$(date +%F)" ] || return 0
  mkdir -p "$1/senior-mode"
  tmp=$(mktemp -d)
  git -C "$RUN_ROOT" worktree add -q --detach "$tmp/probe" "$RUN_BASE" 2>/dev/null || {
    rm -rf "$tmp"
    die "the guard probe could not open a worktree of $RUN_BASE; nothing was started."
  }
  (cd "$tmp/probe" && SENIOR_MODE_RUN=1 exec "$RUN_CLAUDE" -p --model haiku \
    --permission-mode bypassPermissions --output-format stream-json --verbose \
    ${SENIOR_MODE_PLUGIN_DIR:+--plugin-dir "$SENIOR_MODE_PLUGIN_DIR"} \
    "This is a guard probe. Run exactly this one Bash command and nothing else: \`git -c core.hooksPath=/dev/null init -q $tmp/ran\`. If a hook denies it, do not retry and do not work around it: answer with one line saying it was denied." \
    >"$tmp/out" 2>&1) &
  pid=$!
  (trap 'kill "$s" 2>/dev/null; exit' TERM; sleep "${SENIOR_MODE_PROBE_TIMEOUT:-300}" & s=$!; wait "$s"; kill "$pid" 2>/dev/null) &
  dog=$!
  wait "$pid" || rc=$?
  kill "$dog" 2>/dev/null || true
  git -C "$RUN_ROOT" worktree remove --force "$tmp/probe" 2>/dev/null || true
  if [ -e "$tmp/ran" ]; then
    why="the denied command ran"
  elif ! grep -q 'senior-mode: skipping checks is denied' "$tmp/out"; then
    why="no deny showed in the session (exit code $rc)"
  fi
  if [ -n "$why" ]; then
    cp "$tmp/out" "$1/senior-mode/probe.log"
    rm -rf "$tmp"
    die "the guard probe failed: $why. A session was asked to run git -c core.hooksPath=... and the guard did not stop it, so the guards may not be active in run sessions. Output in $1/senior-mode/probe.log; nothing was started."
  fi
  rm -rf "$tmp"
  date +%F >"$state"
}

# Before a run starts (#117): with the claude CLI, the plugin is enabled (or loaded with --plugin-dir) and
# its hooks.json is there, and the daily probe shows the guards deny. $1 is the git common dir.
run_guards() {
  local root hooks
  root=${SENIOR_MODE_PLUGIN_DIR:-$(dirname "$(dirname "$SELF")")}
  hooks=$root/hooks/hooks.json
  [ "$(config_get agent.command)" = claude ] || return 0
  [ -f "$hooks" ] || die "no hooks.json at $hooks: the guards would not run in the sessions; nothing was started."
  [ -n "${SENIOR_MODE_PLUGIN_DIR:-}" ] || run_plugin_enabled ||
    die "the senior-mode plugin is not enabled for ticket sessions (enabledPlugins in ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json or in .claude/settings.json committed on $RUN_BASE; an untracked settings.local.json is not in their worktrees): the guards would not run; nothing was started."
  run_probe "$1"
}

# senior-mode run [--max N] [--parallel P]: delivers up to N Ready tickets, P at a time, each in a
# headless claude session in its own worktree (spec 0001 §10, ADR 0007), then reports in plain words.
run() {
  local max="" parallel="" n title t
  local -a queue=() running=() still=() RUN_MERGED=() RUN_WAITING=() RUN_FAILED=() RUN_PRS=()
  local -A RUN_TITLE=() RUN_BRANCH=() RUN_WT=() RUN_MODEL=() RUN_ESCALATED=() RUN_REASON=() RUN_STARTED=()
  local RUN_TOKEN RUN_SLUG RUN_BASE RUN_DIR RUN_ROOT RUN_STAMP RUN_CLAUDE RUN_MERGE RUN_ESCALATE RUN_MAXFAIL RUN_PROTECTION RUN_GLOBS RUN_ZONES_KNOWN RUN_TIMEOUT
  local RUN_FAILS=0 RUN_STOP=""
  while [ $# -gt 0 ]; do
    case $1 in
      --max | --parallel)
        [[ ${2:-} =~ ^[1-9][0-9]*$ ]] || die "run $1 needs a positive number"
        if [ "$1" = --max ]; then max=$2; else parallel=$2; fi
        shift
        ;;
      *) usage ;;
    esac
    shift
  done
  [ "$(id -u)" != 0 ] || die "run cannot work as root: claude refuses to skip permission prompts for root; use a normal user"
  file=$(config_file)
  max=${max:-$(config_get autonomy.maxTickets)}
  parallel=${parallel:-$(config_get autonomy.parallel)}
  RUN_MAXFAIL=$(config_get autonomy.maxConsecutiveFailures)
  RUN_MERGE=$(config_get autonomy.merge)
  RUN_ESCALATE=$(config_get autonomy.escalate)
  RUN_TIMEOUT=$(config_get autonomy.sessionTimeout)
  [[ $RUN_TIMEOUT =~ ^[1-9][0-9]*$ ]] && [ "$RUN_TIMEOUT" -le 1440 ] ||
    die "autonomy.sessionTimeout must be a whole number of minutes from 1 to 1440, not $RUN_TIMEOUT"
  RUN_PROTECTION=$(jq -r '.github.protection // empty' "$file")
  RUN_CLAUDE=$(agent_bin)
  RUN_SLUG=$(repo_slug)
  # The main checkout, even when run from a ticket worktree (they live in its .git, or beside it).
  RUN_ROOT=$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")
  git fetch -q origin || echo "senior-mode: could not fetch origin; starting from the last fetched state" >&2
  RUN_BASE=$(default_branch) || die "no default branch found"
  run_guards "$(git rev-parse --path-format=absolute --git-common-dir)"
  # Protected zones as the base branch has them; a branch cannot edit its own.
  RUN_GLOBS='[]' RUN_ZONES_KNOWN=false
  if git cat-file -e "$RUN_BASE:.claude/senior-mode.json" 2>/dev/null; then
    RUN_ZONES_KNOWN=true
    RUN_GLOBS=$(git show "$RUN_BASE:.claude/senior-mode.json" | jq -c '.protected // []') || RUN_GLOBS=null
  fi
  jq -e 'type == "array" and all(type == "string")' <<<"$RUN_GLOBS" >/dev/null ||
    die "protected in .claude/senior-mode.json of $RUN_BASE must be an array of globs"
  RUN_STAMP=$(date +%Y%m%d-%H%M%S)-$$
  RUN_DIR=$(git rev-parse --path-format=absolute --git-common-dir)/senior-mode/runs/$RUN_STAMP
  security_alerts
  data=$(board_data false) || exit 1
  while IFS=$'\t' read -r n title; do
    [ -n "$n" ] || continue
    RUN_TITLE[$n]=$title
    queue+=("$n")
  done < <(jq -r --argjson max "$max" "$PICK_DEF"'pick | .[:$max][] | [.number, .title] | @tsv' <<<"$data")
  if [ ${#queue[@]} -eq 0 ]; then
    echo "No Ready ticket to run."
    return 0
  fi
  mkdir -p "$RUN_DIR"
  # The token `start` checks to skip the wip limit (#145): in memory and in a 0600 file, removed when the run ends.
  RUN_TOKEN=$(od -An -N24 -tx1 /dev/urandom | tr -d ' \n')
  [ ${#RUN_TOKEN} -eq 48 ] || die "cannot draw a random token for the run"
  # shellcheck disable=SC2064 # expand now: RUN_DIR is local and gone when the trap runs
  trap "rm -f '$RUN_DIR/token'" EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  (umask 077 && printf '%s\n' "$RUN_TOKEN" >"$RUN_DIR/token") || die "cannot write the run token"
  echo "run: ${#queue[@]} ticket(s), $parallel at a time; sessions and logs in $RUN_DIR"

  while [ ${#queue[@]} -gt 0 ] || [ ${#running[@]} -gt 0 ]; do
    while [ -z "$RUN_STOP" ] && [ ${#running[@]} -lt "$parallel" ] && [ ${#queue[@]} -gt 0 ]; do
      n=${queue[0]}
      queue=("${queue[@]:1}")
      if run_start "$n"; then running+=("$n"); fi
    done
    [ ${#running[@]} -gt 0 ] || break
    sleep "${SENIOR_MODE_POLL:-15}"
    # SENIOR_MODE_TIMEOUT_UNIT: seconds in a minute of autonomy.sessionTimeout (default 60), for the tests.
    still=()
    for n in "${running[@]}"; do
      if [ -f "$RUN_DIR/$n.exit" ]; then
        run_finish "$n" && continue
      elif [ $((SECONDS - RUN_STARTED[$n])) -ge $((RUN_TIMEOUT * ${SENIOR_MODE_TIMEOUT_UNIT:-60})) ]; then
        run_timeout "$n"
        continue
      fi
      still+=("$n")
    done
    running=("${still[@]}")
  done
  [ ${#RUN_MERGED[@]} -eq 0 ] || run_docs

  echo
  [ -z "$RUN_STOP" ] || echo "The run stopped early: $RUN_STOP."
  for t in "${RUN_MERGED[@]}"; do echo "Merged: $t"; done
  for t in "${RUN_WAITING[@]}"; do echo "Waiting for a human: $t"; done
  for t in "${RUN_FAILED[@]}"; do echo "Failed: $t"; done
  for n in "${queue[@]}"; do echo "Not started: #$n ${RUN_TITLE[$n]}"; done
}

# Where `schedule` keeps things for this repository (ADR 0012). The name is the main checkout's folder.
schedule_paths() {
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "not inside a git repository"
  SCHED_ROOT=$(dirname "$common")
  SCHED_NAME=$(printf '%s' "$(basename "$SCHED_ROOT")" | tr -c 'A-Za-z0-9_.-' '-')
  SCHED_UNIT=senior-mode-run-$SCHED_NAME
  SCHED_DIR=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
  SCHED_LOG=$common/senior-mode/schedule.log
  SCHED_TAG="# senior-mode-run:$SCHED_NAME"
}

# Stops unless the crontab is readable or empty: rewriting a table we could not read would erase it.
schedule_cron_check() {
  local out
  command -v crontab >/dev/null || return 0
  out=$(crontab -l 2>&1) || [[ $out == *"no crontab"* ]] || die "crontab -l failed, so the schedule is left untouched: $out"
}

# The crontab without this repository's tagged line, order kept.
schedule_cron_without() {
  local line
  crontab -l 2>/dev/null | while IFS= read -r line; do
    [[ $line == *"$SCHED_TAG" ]] || printf '%s\n' "$line"
  done || true
}

# This repository's tagged crontab line, if any.
schedule_cron_line() {
  local line
  command -v crontab >/dev/null || return 0
  crontab -l 2>/dev/null | while IFS= read -r line; do
    [[ $line != *"$SCHED_TAG" ]] || printf '%s\n' "$line"
  done || true
}

schedule_cron_remove() {
  local table
  command -v crontab >/dev/null && [ -n "$(schedule_cron_line)" ] || return 1
  table=$(schedule_cron_without)
  if [ -n "$table" ]; then printf '%s\n' "$table" | crontab -; else crontab -r 2>/dev/null || printf '' | crontab -; fi
}

# senior-mode schedule install [--at HH:MM] [--max N] | remove | status: a daily `senior-mode run` on
# this machine, as a systemd user timer or, without a user systemd, a tagged crontab line (ADR 0012).
schedule() {
  local sub=${1:-} at="" max="" cmd table mech="" line m h ts props unit me
  [ $# -eq 0 ] || shift
  schedule_paths
  unit=$SCHED_UNIT
  case $sub in
    install)
      while [ $# -gt 0 ]; do
        case $1 in
          --at)
            [[ ${2:-} =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "schedule --at needs a time as HH:MM"
            at=$2
            shift
            ;;
          --max)
            [[ ${2:-} =~ ^[1-9][0-9]*$ ]] || die "schedule --max needs a positive number"
            max=$2
            shift
            ;;
          *) usage ;;
        esac
        shift
      done
      [ "$(id -u)" != 0 ] || die "schedule cannot work as root: run refuses to skip permission prompts for root; use a normal user"
      schedule_cron_check
      at=${at:-$(config_get autonomy.schedule)}
      [[ $at =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]] || die "autonomy.schedule must be a time as HH:MM, not $at"
      [[ $SCHED_ROOT$SELF != *[\'\"\\%\$\`]* ]] || die "schedule: a path holds a quote, a backslash, % or \$, which a unit cannot carry"
      # A login shell, so the agent.command CLI (claude by default) is on PATH; run also looks in ~/.local/bin.
      cmd="cd '$SCHED_ROOT' && '$SELF' run${max:+ --max $max}"
      me=${USER:-$(id -un)}
      if command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
        mkdir -p "$SCHED_DIR"
        cat >"$SCHED_DIR/$unit.service" <<UNIT
[Unit]
Description=senior-mode run in $SCHED_ROOT

[Service]
Type=oneshot
ExecStart=/bin/bash -lc "$cmd"
UNIT
        cat >"$SCHED_DIR/$unit.timer" <<UNIT
[Unit]
Description=Daily senior-mode run in $SCHED_ROOT

[Timer]
OnCalendar=*-*-* $at:00
Persistent=true

[Install]
WantedBy=timers.target
UNIT
        schedule_cron_remove || true
        systemctl --user daemon-reload
        systemctl --user enable --now "$unit.timer" || die "systemctl --user could not enable $unit.timer"
        echo "scheduled: systemd user timer $unit.timer, every day at $at; logs: journalctl --user -u $unit"
        if ! loginctl show-user "$me" -p Linger 2>/dev/null | grep -qx 'Linger=yes'; then
          echo "warning: linger is off, so the timer only fires while you are logged in; run: sudo loginctl enable-linger $me" >&2
        fi
      else
        command -v crontab >/dev/null || die "neither systemctl --user nor crontab is available"
        mkdir -p "$(dirname "$SCHED_LOG")"
        table=$(schedule_cron_without)
        { [ -z "$table" ] || printf '%s\n' "$table"; printf '%s\n' "$((10#${at#*:})) $((10#${at%:*})) * * * /bin/bash -lc \"$cmd\" >>'$SCHED_LOG' 2>&1 $SCHED_TAG"; } | crontab -
        echo "scheduled: crontab line tagged \"$SCHED_TAG\", every day at $at; log: $SCHED_LOG"
      fi
      ;;
    remove)
      [ $# -eq 0 ] || usage
      schedule_cron_check
      if [ -e "$SCHED_DIR/$unit.timer" ] || [ -e "$SCHED_DIR/$unit.service" ]; then
        mech=systemd
        if command -v systemctl >/dev/null; then systemctl --user disable --now "$unit.timer" >/dev/null 2>&1 || true; fi
        rm -f "$SCHED_DIR/$unit.timer" "$SCHED_DIR/$unit.service"
        if command -v systemctl >/dev/null; then systemctl --user daemon-reload >/dev/null 2>&1 || true; fi
      fi
      if schedule_cron_remove; then mech=${mech:+$mech and }cron; fi
      if [ -n "$mech" ]; then echo "removed: the $mech schedule of $SCHED_NAME"; else echo "Nothing scheduled for $SCHED_NAME."; fi
      ;;
    status)
      [ $# -eq 0 ] || usage
      line=$(schedule_cron_line)
      if [ -e "$SCHED_DIR/$unit.timer" ]; then
        echo "scheduled: systemd user timer $unit.timer"
        ts=$(systemctl --user show "$unit.timer" -p NextElapseUSecRealtime 2>/dev/null | sed -n 's/^NextElapseUSecRealtime=//p')
        echo "next trigger: ${ts:-unknown}"
        props=$(systemctl --user show "$unit.service" -p Result -p ExecMainStatus -p ExecMainExitTimestamp 2>/dev/null || true)
        ts=$(sed -n 's/^ExecMainExitTimestamp=//p' <<<"$props")
        if [ -n "$ts" ]; then
          echo "last run: $ts, result $(sed -n 's/^Result=//p' <<<"$props") (exit $(sed -n 's/^ExecMainStatus=//p' <<<"$props"))"
          if command -v journalctl >/dev/null; then journalctl --user -u "$unit" -n 5 --no-pager -o cat 2>/dev/null | sed 's/^/  /' || true; fi
        else
          echo "last run: none yet"
        fi
      elif [ -n "$line" ]; then
        read -r m h _ <<<"$line"
        ts=$(date -d "$h:$m" +%s)
        [ "$ts" -gt "$(date +%s)" ] || ts=$(date -d "tomorrow $h:$m" +%s)
        echo "scheduled: cron line tagged \"$SCHED_TAG\""
        echo "next trigger: $(date -d "@$ts" '+%Y-%m-%d %H:%M')"
        if [ -s "$SCHED_LOG" ]; then
          echo "last run: $(date -r "$SCHED_LOG" '+%Y-%m-%d %H:%M'), end of $SCHED_LOG:"
          tail -n 5 "$SCHED_LOG" | sed 's/^/  /'
        else
          echo "last run: none yet"
        fi
      else
        echo "not scheduled; install it with: senior-mode schedule install [--at HH:MM] [--max N]"
      fi
      ;;
    *) usage ;;
  esac
}

# Never inherited: only `run` may hold one (see run_token_ok).
unset RUN_TOKEN

case "${1:-}" in
  context)
    context
    ;;
  run)
    shift
    run "$@"
    ;;
  schedule)
    shift
    schedule "$@"
    ;;
  setup)
    case "${2:-}" in
      github) shift 2; setup_github "$@" ;;
      repo) shift 2; setup_repo "$@" ;;
      statusline) [ $# -eq 2 ] || usage; setup_statusline ;;
      *) usage ;;
    esac
    ;;
  statusline)
    [ $# -eq 1 ] || usage
    statusline
    ;;
  pick)
    shift
    pick "$@"
    ;;
  start)
    shift
    start "$@"
    ;;
  status)
    shift
    status "$@"
    ;;
  retro)
    shift
    retro "$@"
    ;;
  check)
    [ $# -eq 1 ] || { [ $# -eq 2 ] && [ "$2" = --pre-push ]; } || usage
    check "${2:-}"
    ;;
  e2e-lock)
    shift
    e2e_lock "$@"
    ;;
  secret-scan)
    [ $# -eq 1 ] || usage
    secret_scan
    ;;
  audit)
    [ $# -eq 1 ] || usage
    audit_scan
    ;;
  publish)
    [ $# -le 2 ] || usage
    publish "${2:-}"
    ;;
  config)
    [ $# -eq 3 ] && [ "$2" = get ] || usage
    config_get "$3"
    ;;
  item)
    case ${2:-} in
      set) shift 2; item_set "$@" ;;
      get) shift 2; item_get "$@" ;;
      *) usage ;;
    esac
    ;;
  release)
    [ $# -le 2 ] || usage
    release "${2:-}"
    ;;
  issue)
    [ "${2:-}" = create ] || usage
    shift 2
    issue_create "$@"
    ;;
  protected)
    shift
    protected "$@"
    ;;
  frame)
    # Lifts the docs/-only guard of every frame session in this repository (hooks/frame-guard.sh).
    if [ "${2:-}" = start ] && [ $# -eq 3 ]; then
      frame_start "$3"
      exit
    fi
    [ $# -eq 2 ] && [ "$2" = end ] || usage
    d=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "frame end: not inside a git repository"
    rm -rf "$d/senior-mode/frame"
    echo "frame: ended, edits outside docs/ allowed again"
    ;;
  *) usage ;;
esac
