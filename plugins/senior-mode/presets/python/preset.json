{
  "commands": ["lint", "format", "typecheck", "test", "build"],
  "protected": [
    "**/migrations/**",
    "alembic/**",
    "**/auth/**",
    "**/security/**",
    ".github/workflows/**",
    "Dockerfile*",
    "**/Dockerfile*",
    "docker-compose*.yml",
    "infra/**"
  ],
  "checks": [{ "name": "commit subjects", "run": ".githooks/commit-msg --branch" }],
  "release": {
    "packages": { ".": { "release-type": "python", "component": "{{name}}", "include-component-in-tag": true } }
  }
}
