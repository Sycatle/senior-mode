#!/usr/bin/env bash
# senior-mode: refuses a commit whose subject is not a Conventional Commit (spec 0001 §11).
# Standalone, so it works in any terminal. `commit-msg <file>` checks a commit message;
# `commit-msg --subjects` checks subjects read on stdin, one per line.
set -u
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: [^ ].*$'
status=0

check() {
  case $1 in '' | 'Merge '* | 'fixup! '* | 'squash! '* | 'amend! '*) return ;; esac
  [[ $1 =~ $pattern ]] && return
  echo "Not a Conventional Commit: $1" >&2
  status=1
}

if [ "${1:-}" = --subjects ]; then
  while IFS= read -r subject || [ -n "$subject" ]; do check "$subject"; done
else
  check "$(grep -v '^#' "$1" | sed -n '/[^[:space:]]/{p;q;}')"
fi
[ "$status" -eq 0 ] ||
  echo "Expected <type>(<scope>): <summary>, type among feat fix docs style refactor perf test build ci chore revert." >&2
exit "$status"
