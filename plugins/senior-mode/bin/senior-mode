#!/usr/bin/env bash
# senior-mode: project config and GitHub helpers for the senior-mode plugin.
# The config is .claude/senior-mode.json at the repository root, written by /senior-mode:setup.
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
LIB=$(dirname "$SELF")/lib

usage() {
  die "usage: senior-mode config get <key> | config explain <key> | config validate [--json] | override list | override show <file> | doctor [--json] | version | item set <issue> <field> <option> [<field> <option>]... | item get <issue> [field] | issue create --title <t> --body-file <f> --size <s> [--priority <p>] [--severity critical|high|moderate|low] [--kind <k> --path <p> --rule <r> [--details-file <f> | --no-advisory]] [--status <s>] [--milestone <m>] [--type <t>] [--blocked-by <n>]... [--parent <n>] | pick [--json] [--max N] | start <issue> [--base <ref>] | preflight <issue>... | hotfix <issue> | run [--max N] [--parallel P] | schedule install [--at HH:MM] [--max N] | schedule remove | schedule status | serve [--install|--uninstall|--resume] | status [--json] [--since <dur>] [--watch [secs]] [--fix] [--publish] | clean [--dry-run] [--days N] | statusline | retro [--since <dur> | --iteration [<name>]] [--json] | check [--pre-push|--ci-only|--changed|--all|--no-cache|--tier 3 [--publish <sha>]|--update-baseline] | untested [--changed] [--check] [<glob>...] | publish [commit] | preview | shots <pr> | release [--dry-run|--patch] | frame start <idea> | frame decide <issue> <question> <answer> | frame end | protected [--base <ref>] | red-tests record <issue> | red-tests verify <issue> | slot -- <command>... | ready [--pr <n> | --milestone <m>... | --optin | <n>...] [--dry-run] | checkpoint [--done <t>]... [--doing <t>]... [--next <t>]... [--assumption <t>]... | context | architecture [--write|--check] | ratchet [--init] | survey | setup github [--ci local|actions|existing] [--migrate|--upgrade] [--project <n|url> [--home <owner/name>] [--move-items]] [--dry-run] | setup repo [--command <name>=<command>]... [--dry-run] [--adopt [--debt]] [--knowledge] | setup repo --hooks | setup detect [--json] | setup answers [--strictness strict|fast] [--language en|fr] [--autonomy ask|alone] [--lsp yes|no] [--previews platform|ready|off] [--dry-run] | setup org <owner> [--apply] [--print-ruleset] | setup remove [--apply] | setup statusline | demo [--yes] [--budget <usd>] [--clean]"
}

# The modules hold definitions only: function bodies and constants, no statement runs at load time.
# shellcheck source=lib/common.sh
. "$LIB/common.sh"
# shellcheck source=lib/config.sh
. "$LIB/config.sh"
# shellcheck source=lib/doctor.sh
. "$LIB/doctor.sh"
# shellcheck source=lib/workflow.sh
. "$LIB/workflow.sh"
# shellcheck source=lib/state.sh
. "$LIB/state.sh"
# shellcheck source=lib/board.sh
. "$LIB/board.sh"
# shellcheck source=lib/release.sh
. "$LIB/release.sh"
# shellcheck source=lib/hotfix.sh
. "$LIB/hotfix.sh"
# shellcheck source=lib/check.sh
. "$LIB/check.sh"
# shellcheck source=lib/journeys.sh
. "$LIB/journeys.sh"
# shellcheck source=lib/shots.sh
. "$LIB/shots.sh"
# shellcheck source=lib/characterize.sh
. "$LIB/characterize.sh"
# shellcheck source=lib/architecture.sh
. "$LIB/architecture.sh"
# shellcheck source=lib/ratchet.sh
. "$LIB/ratchet.sh"
# shellcheck source=lib/skeleton.sh
. "$LIB/skeleton.sh"
# shellcheck source=lib/evals.sh
. "$LIB/evals.sh"
# shellcheck source=lib/guard.sh
. "$LIB/guard.sh"
# shellcheck source=lib/setup-board.sh
. "$LIB/setup-board.sh"
# shellcheck source=lib/setup.sh
. "$LIB/setup.sh"
# shellcheck source=lib/packages.sh
. "$LIB/packages.sh"
# shellcheck source=lib/setup-workflow.sh
. "$LIB/setup-workflow.sh"
# shellcheck source=lib/setup-knowledge.sh
. "$LIB/setup-knowledge.sh"
# shellcheck source=lib/survey.sh
. "$LIB/survey.sh"
# shellcheck source=lib/debt.sh
. "$LIB/debt.sh"
# shellcheck source=lib/setup-answers.sh
. "$LIB/setup-answers.sh"
# shellcheck source=lib/setup-remove.sh
. "$LIB/setup-remove.sh"
# shellcheck source=lib/org.sh
. "$LIB/org.sh"
# shellcheck source=lib/deploy.sh
. "$LIB/deploy.sh"
# shellcheck source=lib/status.sh
. "$LIB/status.sh"
# shellcheck source=lib/status-hygiene.sh
. "$LIB/status-hygiene.sh"
# shellcheck source=lib/status-board.sh
. "$LIB/status-board.sh"
# shellcheck source=lib/statusline.sh
. "$LIB/statusline.sh"
# The status sections (see lib/status.sh): one file each, no line here; .github/scripts/shellcheck.sh checks them.
for section in "$LIB"/status.d/*.sh; do
  # shellcheck source=/dev/null
  . "$section"
done
# shellcheck source=lib/retro.sh
. "$LIB/retro.sh"
# shellcheck source=lib/context.sh
. "$LIB/context.sh"
# shellcheck source=lib/checkpoint.sh
. "$LIB/checkpoint.sh"
# shellcheck source=lib/repomap.sh
. "$LIB/repomap.sh"
# shellcheck source=lib/retro-learn.sh
. "$LIB/retro-learn.sh"
# shellcheck source=lib/retro-notes.sh
. "$LIB/retro-notes.sh"
# shellcheck source=lib/retro-proof.sh
. "$LIB/retro-proof.sh"
# shellcheck source=lib/clean.sh
. "$LIB/clean.sh"
# shellcheck source=lib/run.sh
. "$LIB/run.sh"
# shellcheck source=lib/prompts.sh
. "$LIB/prompts.sh"
# shellcheck source=lib/schedule.sh
. "$LIB/schedule.sh"
# shellcheck source=lib/watchdog.sh
. "$LIB/watchdog.sh"
# shellcheck source=lib/lease.sh
. "$LIB/lease.sh"
# shellcheck source=lib/egress.sh
. "$LIB/egress.sh"
# shellcheck source=lib/sandbox.sh
. "$LIB/sandbox.sh"
# shellcheck source=lib/serve.sh
. "$LIB/serve.sh"
# shellcheck source=lib/demo.sh
. "$LIB/demo.sh"

# shellcheck source=lib/broker.sh
. "$LIB/broker.sh"
# shellcheck source=lib/additive.sh
. "$LIB/additive.sh"
# shellcheck source=lib/dependabot.sh
. "$LIB/dependabot.sh"

# Never inherited: only `run` may hold one (see run_token_ok).
unset RUN_TOKEN

# The branch pattern of the project as a regex, for the jq programs that read a branch back to its ticket.
SENIOR_MODE_BRANCH_RE=$(workflow_branch_re 2>/dev/null) || SENIOR_MODE_BRANCH_RE=""
export SENIOR_MODE_BRANCH_RE

case "${1:-}" in
  context)
    context
    ;;
  checkpoint)
    shift
    checkpoint "$@"
    ;;
  run)
    shift
    run "$@"
    ;;
  schedule)
    shift
    schedule "$@"
    ;;
  serve)
    shift
    serve "$@"
    ;;
  setup)
    case "${2:-}" in
      github)
        shift 2
        case " $* " in
          *" --move-items "*) setup_github_move "$@" ;;
          *) setup_github "$@" ;;
        esac
        ;;
      repo) shift 2; setup_repo "$@" ;;
      detect) shift 2; setup_detect "$@" ;;
      answers) shift 2; setup_answers "$@" ;;
      remove) shift 2; setup_remove "$@" ;;
      org) shift 2; setup_org "$@" ;;
      statusline) [ $# -eq 2 ] || usage; setup_statusline ;;
      *) usage ;;
    esac
    ;;
  demo)
    shift
    demo "$@"
    ;;
  statusline)
    [ $# -eq 1 ] || usage
    statusline
    ;;
  doctor)
    shift
    doctor "$@"
    ;;
  version | --version)
    [ $# -eq 1 ] || usage
    print_version
    ;;
  pick)
    shift
    pick "$@"
    ;;
  start)
    shift
    start "$@"
    ;;
  preflight)
    shift
    preflight "$@"
    ;;
  hotfix)
    shift
    hotfix "$@"
    ;;
  status)
    shift
    status "$@"
    ;;
  clean)
    shift
    clean "$@"
    ;;
  retro)
    shift
    retro "$@"
    ;;
  check)
    shift
    check "$@"
    ;;
  e2e-lock)
    shift
    e2e_lock "$@"
    ;;
  slot)
    shift
    slot "$@"
    ;;
  ready)
    shift
    ready "$@"
    ;;
  secret-scan)
    [ $# -eq 1 ] || usage
    secret_scan
    ;;
  context-hygiene)
    [ $# -eq 1 ] || usage
    context_hygiene
    ;;
  commit-trailers)
    [ $# -eq 1 ] || usage
    commit_trailers
    ;;
  fk-check)
    [ $# -eq 1 ] || usage
    fk_check
    ;;
  migrations-check)
    [ $# -eq 1 ] || usage
    migrations_check
    ;;
  untested)
    shift
    untested "$@"
    ;;
  audit)
    [ $# -eq 1 ] || usage
    audit_scan
    ;;
  deps)
    [ $# -eq 1 ] || usage
    deps_scan
    ;;
  journeys-check)
    [ $# -le 2 ] || usage
    journeys_check "${2:-}"
    ;;
  vision-check)
    [ $# -eq 1 ] || usage
    vision_check
    ;;
  knowledge-check)
    [ $# -eq 1 ] || usage
    knowledge_check
    ;;
  architecture-check)
    [ $# -eq 1 ] || usage
    architecture_check
    ;;
  ratchet-check)
    [ $# -eq 1 ] || usage
    ratchet_check
    ;;
  ratchet)
    shift
    ratchet_cmd "$@"
    ;;
  architecture)
    [ $# -le 2 ] || usage
    architecture_cmd "${2:-}"
    ;;
  survey)
    shift
    survey_cmd "$@"
    ;;
  publish)
    [ "${2:-}" != --changed ] || die "publish sends the result of a full check: --changed is refused"
    [ $# -le 2 ] || usage
    publish "${2:-}"
    ;;
  preview)
    shift
    deploy_preview "$@"
    ;;
  shots)
    [ $# -eq 2 ] || usage
    shots "$2"
    ;;
  config)
    case ${2:-} in
      get) [ $# -eq 3 ] || usage; config_get "$3" ;;
      explain) [ $# -eq 3 ] || usage; config_explain "$3" ;;
      validate) shift 2; config_validate "$@" ;;
      *) usage ;;
    esac
    ;;
  override)
    shift
    override "$@"
    ;;
  item)
    case ${2:-} in
      set) shift 2; item_set_checked "$@" ;;
      get) shift 2; item_get "$@" ;;
      *) usage ;;
    esac
    ;;
  release)
    [ $# -le 2 ] || usage
    release "${2:-}"
    ;;
  issue)
    [ "${2:-}" = create ] || usage
    shift 2
    issue_create "$@"
    ;;
  protected)
    shift
    protected "$@"
    ;;
  red-tests)
    shift
    red_tests "$@"
    ;;
  frame)
    # Lifts the docs/-only guard of every frame session in this repository (hooks/frame-guard.sh).
    if [ "${2:-}" = start ] && [ $# -eq 3 ]; then
      frame_start "$3"
      exit
    fi
    if [ "${2:-}" = decide ] && [ $# -eq 5 ]; then
      frame_decide "$3" "$4" "$5"
      exit
    fi
    [ $# -eq 2 ] && [ "$2" = end ] || usage
    d=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "frame end: not inside a git repository"
    rm -rf "$d/senior-mode/frame"
    echo "frame: ended, edits outside docs/ allowed again"
    ;;
  *) usage ;;
esac
