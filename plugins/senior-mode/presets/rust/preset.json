{
  "commands": ["lint", "format", "test", "build"],
  "coverage": { "report": "lcov.info" },
  "rules": { "packs": ["rust"] },
  "protected": [
    "**/migrations/**",
    "**/auth/**",
    "**/security/**",
    ".github/workflows/**",
    "Dockerfile*",
    "**/Dockerfile*",
    "docker-compose*.yml",
    "infra/**",
    ".claude/senior-mode.json",
    ".claude/secret-allowlist",
    ".claude/ratchet-baseline.json",
    ".claude/architecture-baseline.json"
  ],
  "checks": [{ "name": "commit subjects", "run": ".githooks/commit-msg --branch" }],
  "queries": { "sqlx": { "template": "queries/sqlx.rs", "helper": "tests/support/query_count.rs" } },
  "release": {
    "packages": { ".": { "release-type": "rust", "component": "{{name}}", "include-component-in-tag": true } }
  }
}
