#!/usr/bin/env bash
# senior-mode: project config and GitHub helpers for the senior-mode plugin.
# The config is .claude/senior-mode.json at the repository root, written by /senior-mode:setup.
# shellcheck source-path=SCRIPTDIR
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
LIB=$(dirname "$SELF")/lib

usage() {
  die "usage: senior-mode config get <key> | item set <issue> <field> <option> [<field> <option>]... | item get <issue> [field] | issue create --title <t> --body-file <f> --size <s> [--priority <p>] [--severity critical|high|moderate|low] [--kind <k> --path <p> --rule <r> [--details-file <f> | --no-advisory]] [--status <s>] [--milestone <m>] [--type <t>] [--blocked-by <n>]... [--parent <n>] | pick [--json] [--max N] | start <issue> | run [--max N] [--parallel P] | schedule install [--at HH:MM] [--max N] | schedule remove | schedule status | serve [--install|--uninstall|--resume] | status [--json] [--since <dur>] [--watch [secs]] [--fix] [--publish] | clean [--dry-run] [--days N] | statusline | retro [--since <dur> | --iteration [<name>]] [--json] | check [--pre-push] | publish [commit] | release [--dry-run] | frame start <idea> | frame end | protected [--base <ref>] | red-tests record <issue> | slot -- <command>... | ready [--pr <n>] [--dry-run] | context | setup github [--ci local|actions] [--migrate|--upgrade] [--dry-run] | setup repo [--command <name>=<command>]... | setup remove [--apply] | setup statusline"
}

# The modules hold definitions only: function bodies and constants, no statement runs at load time.
# shellcheck source=lib/common.sh
. "$LIB/common.sh"
# shellcheck source=lib/board.sh
. "$LIB/board.sh"
# shellcheck source=lib/release.sh
. "$LIB/release.sh"
# shellcheck source=lib/check.sh
. "$LIB/check.sh"
# shellcheck source=lib/guard.sh
. "$LIB/guard.sh"
# shellcheck source=lib/setup-board.sh
. "$LIB/setup-board.sh"
# shellcheck source=lib/setup.sh
. "$LIB/setup.sh"
# shellcheck source=lib/setup-remove.sh
. "$LIB/setup-remove.sh"
# shellcheck source=lib/status.sh
. "$LIB/status.sh"
# shellcheck source=lib/clean.sh
. "$LIB/clean.sh"
# shellcheck source=lib/run.sh
. "$LIB/run.sh"
# shellcheck source=lib/prompts.sh
. "$LIB/prompts.sh"
# shellcheck source=lib/schedule.sh
. "$LIB/schedule.sh"
# shellcheck source=lib/serve.sh
. "$LIB/serve.sh"

# Never inherited: only `run` may hold one (see run_token_ok).
unset RUN_TOKEN

case "${1:-}" in
  context)
    context
    ;;
  run)
    shift
    run "$@"
    ;;
  schedule)
    shift
    schedule "$@"
    ;;
  serve)
    shift
    serve "$@"
    ;;
  setup)
    case "${2:-}" in
      github) shift 2; setup_github "$@" ;;
      repo) shift 2; setup_repo "$@" ;;
      remove) shift 2; setup_remove "$@" ;;
      statusline) [ $# -eq 2 ] || usage; setup_statusline ;;
      *) usage ;;
    esac
    ;;
  statusline)
    [ $# -eq 1 ] || usage
    statusline
    ;;
  pick)
    shift
    pick "$@"
    ;;
  start)
    shift
    start "$@"
    ;;
  status)
    shift
    status "$@"
    ;;
  clean)
    shift
    clean "$@"
    ;;
  retro)
    shift
    retro "$@"
    ;;
  check)
    [ $# -eq 1 ] || { [ $# -eq 2 ] && [ "$2" = --pre-push ]; } || usage
    check "${2:-}"
    ;;
  e2e-lock)
    shift
    e2e_lock "$@"
    ;;
  slot)
    shift
    slot "$@"
    ;;
  ready)
    shift
    ready "$@"
    ;;
  secret-scan)
    [ $# -eq 1 ] || usage
    secret_scan
    ;;
  audit)
    [ $# -eq 1 ] || usage
    audit_scan
    ;;
  publish)
    [ $# -le 2 ] || usage
    publish "${2:-}"
    ;;
  config)
    [ $# -eq 3 ] && [ "$2" = get ] || usage
    config_get "$3"
    ;;
  item)
    case ${2:-} in
      set) shift 2; item_set "$@" ;;
      get) shift 2; item_get "$@" ;;
      *) usage ;;
    esac
    ;;
  release)
    [ $# -le 2 ] || usage
    release "${2:-}"
    ;;
  issue)
    [ "${2:-}" = create ] || usage
    shift 2
    issue_create "$@"
    ;;
  protected)
    shift
    protected "$@"
    ;;
  red-tests)
    shift
    red_tests "$@"
    ;;
  frame)
    # Lifts the docs/-only guard of every frame session in this repository (hooks/frame-guard.sh).
    if [ "${2:-}" = start ] && [ $# -eq 3 ]; then
      frame_start "$3"
      exit
    fi
    [ $# -eq 2 ] && [ "$2" = end ] || usage
    d=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || die "frame end: not inside a git repository"
    rm -rf "$d/senior-mode/frame"
    echo "frame: ended, edits outside docs/ allowed again"
    ;;
  *) usage ;;
esac
