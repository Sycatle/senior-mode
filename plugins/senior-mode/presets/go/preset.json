{
  "commands": ["lint", "test", "build"],
  "coverage": { "report": "coverage.xml" },
  "rules": { "packs": ["go"] },
  "protected": [
    "**/migrations/**",
    "**/auth/**",
    "**/security/**",
    ".github/workflows/**",
    "Dockerfile*",
    "**/Dockerfile*",
    "docker-compose*.yml",
    "infra/**",
    ".claude/senior-mode.json",
    ".claude/secret-allowlist",
    ".claude/ratchet-baseline.json",
    ".claude/architecture-baseline.json"
  ],
  "checks": [{ "name": "commit subjects", "run": ".githooks/commit-msg --branch" }],
  "release": {
    "packages": { ".": { "release-type": "go", "component": "{{name}}", "include-component-in-tag": true } }
  }
}
