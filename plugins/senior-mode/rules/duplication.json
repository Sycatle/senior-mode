{
  "rules": [
    {
      "id": "duplication",
      "since": "2026-11-28",
      "tier": 2,
      "kind": "tool",
      "run": "jscpd --min-lines 10 --min-tokens 50 --reporters json --output {out} --silent --gitignore --ignore \"**/node_modules/**,**/dist/**,**/build/**,**/target/**,**/vendor/**,**/*.md,**/*.json,**/*.lock\" .",
      "format": "jscpd",
      "needs": "jscpd",
      "install": "npm install -g jscpd",
      "fix": "extract the block into the shared folder (rules.shared) and call it from both places"
    }
  ]
}
