{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/Sycatle/senior-mode/main/plugins/senior-mode/schema/senior-mode.schema.json",
  "title": "senior-mode project configuration (.claude/senior-mode.json)",
  "description": "The configuration of a project that uses senior-mode. `senior-mode config validate` (run by `check` and `doctor`) reads this file: it understands type, enum, minimum, maximum, pattern, properties, additionalProperties, items, deprecated, x-replacedBy and x-deprecatedValues.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "description": "This schema, for the editor." },
    "language": { "type": "string", "enum": ["en", "fr"], "description": "Language of the templates and of what Claude writes for you." },
    "lsp": { "type": "boolean", "description": "The answer to the language server proposal of setup: `true` when you enable it in Claude Code, `false` when you decline. Any value stops the proposal." },
    "preset": {
      "type": "string",
      "enum": ["node", "generic", "python", "go", "rust", "typescript"],
      "x-deprecatedValues": { "typescript": "node" },
      "description": "Stack preset; setup detects it."
    },
    "framework": { "type": "string", "description": "`next` when Next.js is a dependency." },
    "commands": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "description": "Commands of the preset (lint, typecheck, test, build, e2e, format, install)."
    },
    "checks": {
      "type": "array",
      "description": "The check list, run in order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "run": { "type": "string", "minLength": 1 },
          "changed": { "type": "string", "minLength": 1, "description": "The command `check --changed` runs on the changed files only; {files} stands for them." }
        }
      }
    },
    "protected": { "type": "array", "items": { "type": "string" }, "description": "Globs of protected zones. Layers add to it, none removes from it." },
    "secrets": { "type": "array", "items": { "type": "string" }, "description": "Extra globs of the secrets guard. Layers add to it." },
    "audit": { "type": "boolean", "description": "false turns off the dependency audit of `check`." },
    "wip": { "type": "integer", "minimum": 1, "description": "Open tickets In progress at once." },
    "slot": { "type": "string", "description": "A shell command that derives the environment of a session slot." },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "mode": { "type": "string", "enum": ["local", "actions", "existing"] } }
    },
    "adopt": {
      "type": "object",
      "description": "Written by setup repo.",
      "additionalProperties": false,
      "properties": { "kind": { "type": "string", "enum": ["evergreen", "legacy"] } }
    },
    "workflow": {
      "type": "object",
      "description": "What setup repo detected of the project's workflow; absent, senior-mode's defaults apply.",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "enum": ["trunk", "integration", "gitflow", "release-branches"] },
        "base": { "type": "string", "description": "The production branch." },
        "integration": { "type": "string", "description": "The branch tickets start from and their pull requests target." },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "branches": { "type": "array", "items": { "type": "string" } },
            "hotfix": { "type": "string" }
          }
        },
        "branch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pattern": { "type": "string", "description": "Branch name with {type}, {issue}, {key} and {slug}." },
            "types": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "commit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "format": { "type": "string", "enum": ["conventional", "ticket-prefix", "free"] },
            "pattern": { "type": "string" },
            "scopes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "pr": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "template": { "type": "string" },
            "title": { "type": "string", "enum": ["commit", "ticket", "free"] },
            "link": { "type": "string", "description": "The keyword that links the issue, or none." }
          }
        },
        "merge": { "type": "string", "enum": ["rebase", "squash", "merge"] },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } },
        "tracker": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "kind": { "type": "string" }, "key": { "type": "string" } }
        },
        "ci": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jobs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": { "context": { "type": "string" }, "covers": { "type": "array", "items": { "type": "string" } } }
              }
            },
            "required": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protection": { "type": "string", "enum": ["", "ruleset", "local", "none"], "description": "Written by setup github: ruleset, local (GitHub refused the ruleset: senior-mode gates the merge and audits pushes) or none (no merge on its own)." },
        "requiredChecks": { "type": "boolean", "description": "false keeps setup github from adding required status checks to the ruleset." }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "previews": { "type": "string", "enum": ["platform", "ready", "off"], "description": "Hosted preview deployments (Vercel, Netlify, Cloudflare Pages) of the branches senior-mode pushes: platform leaves them to the platform, ready deploys one preview per pull request once senior-mode preview asks, off deploys none." }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minPackageAgeDays": { "type": "integer", "minimum": 1, "description": "A new dependency fails check when its package was first published fewer days ago." },
        "minWeeklyDownloads": { "type": "integer", "minimum": 1, "description": "A new dependency fails check when its package had fewer downloads last week." }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claudeMdLines": { "type": "integer", "minimum": 1, "description": "Most lines a tracked CLAUDE.md may have before check fails." }
      }
    },
    "project": {
      "type": "object",
      "description": "The Project board; written by setup github.",
      "additionalProperties": false,
      "properties": {
        "owner": { "type": "string" },
        "number": { "type": "integer", "minimum": 1 },
        "id": { "type": "string" },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "options": { "type": "object", "additionalProperties": { "type": "string" } },
              "iteration": { "type": "boolean", "enum": [true], "description": "An Iteration field, cached by setup github." },
              "date": { "type": "boolean", "enum": [true], "description": "A date field (Start, End), cached by setup github." }
            }
          }
        },
        "migration": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "number": { "type": "integer", "minimum": 1 }, "id": { "type": "string" } }
        }
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template": { "type": "string" },
        "archiveAfterDays": { "type": "integer", "minimum": 1 },
        "iterationDays": { "type": "integer", "minimum": 1 }
      }
    },
    "hygiene": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "days": { "type": "integer", "minimum": 1 } }
    },
    "vision": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "maxLines": { "type": "integer", "minimum": 1 } }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "maxLines": { "type": "integer", "minimum": 1, "description": "Most lines of the body of a note in docs/knowledge." } }
    },
    "retro": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "repeat": { "type": "integer", "minimum": 1, "description": "Tickets with the same cause on the same paths or skill, in the period, that make retro open an improvement ticket." } }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "description": "Rules `check` enforces: an id and exactly one of forbidImport, maxLines or banned.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "forbidImport": {
                "type": "object",
                "additionalProperties": false,
                "required": ["from", "to"],
                "properties": { "from": { "type": "string", "minLength": 1 }, "to": { "type": "string", "minLength": 1 } }
              },
              "maxLines": { "type": "integer", "minimum": 1 },
              "banned": { "type": "string", "minLength": 1, "description": "An extended regular expression." },
              "paths": { "type": "array", "items": { "type": "string" }, "description": "Globs of the files a maxLines or banned rule reads." },
              "why": { "type": "string" }
            }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prLines": { "type": "integer", "minimum": 1 },
        "diffLines": {
          "type": "object",
          "description": "Changed-line budget of a pull request by Size.",
          "additionalProperties": false,
          "properties": {
            "S": { "type": "integer", "minimum": 1 },
            "M": { "type": "integer", "minimum": 1 },
            "L": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "envGuard": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "forbidden": { "type": "array", "items": { "type": "string" } } }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sections": { "type": "array", "items": { "type": "string" } },
        "crossModel": { "type": "boolean" },
        "otherModel": { "type": "string", "minLength": 1 }
      }
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extra": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": { "path": { "type": "string", "minLength": 1 }, "purpose": { "type": "string" } }
          }
        }
      }
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxTickets": { "type": "integer", "minimum": 1 },
        "parallel": { "type": "integer", "minimum": 1 },
        "maxConsecutiveFailures": { "type": "integer", "minimum": 1 },
        "merge": { "type": "boolean" },
        "escalate": { "type": "boolean" },
        "sessionTimeout": { "type": "integer", "minimum": 1, "maximum": 1440, "description": "Minutes." },
        "schedule": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$", "description": "HH:MM." },
        "ticketsPerHour": { "type": "integer", "minimum": 1 },
        "sessionsPerHour": { "type": "integer", "minimum": 0 },
        "minMemoryMB": { "type": "integer", "minimum": 0 },
        "userSettings": { "type": "boolean", "description": "Whether run and serve sessions load the owner's user-level Claude Code configuration." }
      }
    },
    "serve": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval": { "type": "integer", "minimum": 1 },
        "grace": { "type": "integer", "minimum": 0 },
        "breakerCooldown": { "type": "integer", "minimum": 0 }
      }
    },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mention": { "type": "string" },
        "webhook": { "type": "string", "pattern": "^(https?://.+)?$" },
        "digest": { "type": "boolean" }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "command": { "type": "string", "minLength": 1 } }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "description": "The process: the profile (a file, see profile.schema.json) and the lifts of its locked gates. Read from the repository layer; a profile or a lift in another layer is ignored for the lifts.",
      "properties": {
        "profile": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$", "description": "`strict` (default) or `fast`, or a profile file of the project under .claude/senior-mode/profiles/." },
        "lifts": {
          "type": "array",
          "description": "One entry per locked gate that the profile lifts, with the accepted ADR of this repository that decided it.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule", "adr"],
            "properties": {
              "rule": { "type": "string", "enum": ["secretScan", "protectedZones", "bashGuard", "noForcePush", "checkGreen", "review", "trustGate"] },
              "adr": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.md$", "description": "Path of the ADR from the repository root, for instance docs/adr/0016-this-repository-delivery.md." }
            }
          }
        }
      }
    },
    "e2e": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "slots": { "type": "integer", "minimum": 1 } }
    }
  }
}
