#!/usr/bin/env bash
# senior-mode: runs the checks of .claude/senior-mode.json before every push (ADR 0006).
# With senior-mode on the PATH it runs `check --changed` (ADR 0034): the checks and the tests the files changed against
# the merge base affect, the secret scan of the diff always, the audit and the registry lookup cached for 24 h.
# Without it the hook is standalone and runs the list below, narrowed to the pushed paths. The full `senior-mode check`
# runs before the merge and records the result for `senior-mode publish`.
set -u
root=$(git rev-parse --show-toplevel)
if command -v senior-mode >/dev/null 2>&1; then
  exec senior-mode check --changed
fi
config=$root/.claude/senior-mode.json
command -v jq >/dev/null || { echo "pre-push: jq is needed to read $config" >&2; exit 1; }
count=$(jq '.checks // [] | length' "$config" 2>/dev/null) || { echo "pre-push: cannot read $config" >&2; exit 1; }
# Git exports GIT_DIR to hooks, absolute in a linked worktree: a check that runs git on a test
# fixture would write into this repository.
for v in $(git rev-parse --local-env-vars); do unset "$v"; done
output=$(mktemp)
changed=$(mktemp)
trap 'rm -f "$output" "$changed"' EXIT
# The paths this push changes, from the lines git gives this hook on stdin (<ref> <sha> <remote ref> <remote sha>),
# for the checks that can narrow themselves to them (SENIOR_MODE_CHANGED_FILES). Anything that cannot be worked
# out (a deletion, a remote commit this clone lacks, a new branch with no origin base) leaves it unset: full run.
unset SENIOR_MODE_CHANGED_FILES
scoped=true
while read -r _ sha _ rsha; do
  if [[ $sha =~ ^0+$ ]]; then scoped=false; break; fi
  if [[ $rsha =~ ^0+$ ]]; then
    from=
    integration=$(jq -r '.workflow.integration // empty' "$config" 2>/dev/null) || integration=
    for b in ${integration:+"origin/$integration"} origin/HEAD origin/main origin/master; do
      from=$(git -C "$root" merge-base "$sha" "$b" 2>/dev/null) && break
      from=
    done
  else
    from=$rsha
    git -C "$root" cat-file -e "$from^{commit}" 2>/dev/null || from=
  fi
  if [ -z "$from" ] || ! git -C "$root" -c core.quotePath=false diff --name-only --no-renames "$from" "$sha" >>"$changed"; then
    scoped=false
    break
  fi
  scoped=found
done
[ "$scoped" = found ] && export SENIOR_MODE_CHANGED_FILES=$changed
# Milliseconds (whole seconds where this bash has no EPOCHREALTIME), and a duration as "1.2s".
now_ms() { local t=${EPOCHREALTIME:-}; t=${t/[.,]/}; if [ -n "$t" ]; then echo $((t / 1000)); else echo $((SECONDS * 1000)); fi; }
took() { local ms=$(($(now_ms) - $1)); printf '%d.%ds' $((ms / 1000)) $((ms % 1000 / 100)); }
# A check says when it runs (`tier`): 2, the default, here; 3 in the heavy run after the push (spec 474 §2).
tier_errors=$(jq -r '.checks // [] | to_entries[] | select(.value | has("tier")) | .key as $i | .value
  | if (.name == "secret scan" or .name == "dependency audit") then "checks[\($i)].tier: \(.name) is a built-in check of tier 2, it cannot take a tier"
    elif (.tier != 2 and .tier != 3) then "checks[\($i)].tier must be 2 or 3, not \(.tier | tojson)"
    else empty end' "$config")
[ -z "$tier_errors" ] || { echo "pre-push: $tier_errors" >&2; exit 1; }
failed=0
for ((i = 0; i < count; i++)); do
  name=$(jq -r ".checks[$i].name" "$config")
  if [ "$(jq -r ".checks[$i].tier // 2" "$config")" = 3 ]; then
    echo "heavy: $name runs after the push"
    continue
  fi
  started=$(now_ms)
  if (cd "$root" && bash -c "$(jq -r ".checks[$i].run" "$config")") </dev/null >"$output" 2>&1; then
    echo "ok    $name ($(took "$started"))"
  else
    echo "FAIL  $name ($(took "$started"))"
    tail -n 20 "$output" | sed 's/^/      /'
    failed=$((failed + 1))
  fi
done
[ "$failed" -eq 0 ] || { echo "$failed of $count checks failed: fix them, then push again." >&2; exit 1; }
